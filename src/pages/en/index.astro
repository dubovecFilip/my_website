---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import HomeBand from '../../components/HomeBand.astro';
import PlaceholderArt from '../../components/PlaceholderArt.astro';
import { t } from '../../i18n/dict';
import { extractFirstImage } from '../../utils/extract-image';
import { countWords, readingTimeMinutes } from '../../utils/article-stats';

const lang = 'en' as const;
const s = t(lang);

const allArticles = await getCollection('articles-en', ({ data }) => !data.draft);
const articles = allArticles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const pinnedArticle = articles.find((a) => a.data.pinned);
const featured = pinnedArticle ?? articles[0];
const isPinned = Boolean(pinnedArticle);
const feed = featured ? articles.filter((a) => a !== featured) : articles;

const featuredImage = featured ? extractFirstImage(featured.body) : undefined;
const featuredDate = featured
  ? featured.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' })
  : '';
const featuredReadingTime = featured ? readingTimeMinutes(countWords(featured.body)) : 0;
const archiveCount = String(articles.length).padStart(2, '0');
---

<BaseLayout lang={lang} title={s.nav_home} masthead>
  {featured && (
    <section class="hero">
      <div class="hero-text">
        <div class="hero-kicker">
          <span class="hero-badge">{isPinned ? s.featured_label : s.featured_latest_label}</span>
          <span class="hero-meta">{featuredDate} / {featuredReadingTime} MIN</span>
        </div>
        <h1 class="hero-title">{featured.data.title}</h1>
        <p class="hero-desc">{featured.data.description}</p>
        {featured.data.tags.length > 0 && (
          <div class="hero-tags">
            {featured.data.tags.map((tag: string) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
        <a class="btn hero-btn" href={`/${lang}/articles/${featured.id}/`}>{s.read_more} &#9656;</a>
      </div>
      <div class="hero-art">
        {featuredImage ? <img src={featuredImage} alt="" /> : <PlaceholderArt seed={featured.data.title} />}
      </div>
    </section>
  )}

  <div class="band">
    <h2 class="band-title">{s.nav_tags} / {archiveCount}</h2>
    <a class="band-link" href={`/${lang}/tags/`}>{s.all_tags} &#9656;</a>
  </div>

  {feed.length === 0 ? (
    <p class="empty">{s.home_empty}</p>
  ) : (
    <div class="feed">
      {feed.map((article, i) => (
        <ArticleCard
          lang={lang}
          index={i + 1}
          slug={article.id}
          title={article.data.title}
          description={article.data.description}
          date={article.data.date}
          tags={article.data.tags}
          image={extractFirstImage(article.body)}
          readingTime={readingTimeMinutes(countWords(article.body))}
        />
      ))}
    </div>
  )}

  <HomeBand lang={lang} />
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    background: var(--inv-bg);
    color: var(--inv-text);
    padding: 2.4rem var(--pad) 2.2rem;
    border-right: var(--rule-w) solid var(--rule);
  }
  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
  }
  .hero-badge {
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 0.4rem 0.75rem;
  }
  .hero-meta {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--inv-text-muted);
  }
  .hero-title {
    font-size: clamp(2.4rem, 5.4vw, 4.1rem);
    line-height: 0.94;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-wrap: balance;
    margin: 0;
  }
  .hero-desc {
    font-size: 1rem;
    line-height: 1.7;
    color: #c9c4b8;
    max-width: 44ch;
    margin: 0;
  }
  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .hero-btn {
    align-self: flex-start;
    margin-top: auto;
    border-color: var(--inv-text);
    box-shadow: 5px 5px 0 var(--inv-text);
  }
  .hero-btn:hover {
    background: var(--inv-text);
    color: var(--inv-bg);
    box-shadow: 5px 5px 0 var(--accent);
  }
  .hero-art {
    position: relative;
    min-height: 420px;
    overflow: hidden;
  }
  .hero-art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .empty {
    padding: 2rem var(--pad);
    color: var(--text-muted);
    border-bottom: var(--rule-w) solid var(--rule);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero-text {
      border-right: none;
      gap: 1rem;
      padding: 1.6rem var(--pad);
    }
    .hero-btn {
      margin-top: 0.4rem;
      align-self: stretch;
      text-align: center;
    }
    .hero-art {
      min-height: 190px;
      border-top: var(--rule-w) solid var(--rule);
      order: -1;
    }
  }
</style>
