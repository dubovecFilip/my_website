---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SocialIcon from '../../../components/SocialIcon.astro';
import { t } from '../../../i18n/dict';

const lang = 'en' as const;
const s = t(lang);

const links: { label: string; url: string; icon: 'twitch' | 'kick' | 'youtube' | 'tiktok' | 'x' | 'kofi' | 'steam' }[] = [
  { label: 'Kick', url: 'https://kick.com/boggelino', icon: 'kick' },
  { label: 'YouTube', url: 'https://youtube.com/@boggelino', icon: 'youtube' },
  { label: 'YouTube Extra', url: 'https://www.youtube.com/@BOGGELINO_Extra', icon: 'youtube' },
  { label: 'Steam', url: 'https://steamcommunity.com/id/boggelino', icon: 'steam' },
  { label: 'TikTok', url: 'https://tiktok.com/@boggelino', icon: 'tiktok' },
  { label: 'X', url: 'https://x.com/boggelino', icon: 'x' },
  { label: 'Ko-fi', url: 'https://ko-fi.com/boggelino/', icon: 'kofi' },
  { label: 'Twitch', url: 'https://twitch.tv/boggelino', icon: 'twitch' },
];
---

<BaseLayout lang={lang} title={s.nav_about}>
  <div class="wrap-wide about-page">
    <section class="about-hero">
      <span class="eyebrow">{s.about_eyebrow}</span>
      <h1>{s.about_title}</h1>
      <hr class="gold-rule" />
      <p class="about-motto">{s.about_motto}</p>
    </section>

    <div class="about-layout">
      <div class="about-main">
        <p class="about-text">{s.about_purpose_1}</p>
        <p class="about-text">{s.about_purpose_2}</p>
      </div>

      <aside class="about-author">
        <div class="author-card">
          <img src="/images/boggelino.png" width="60" height="60" alt="" class="author-avatar" />
          <p class="author-name">BOGGELINO</p>
          <span class="author-label">{s.about_author_title}</span>
          <p class="author-blurb">{s.about_intro_1}</p>
          <p class="author-blurb">{s.about_intro_2}</p>

          <ul class="link-row">
            {links.map((link) => (
              <li>
                <a href={link.url} target="_blank" rel="noopener noreferrer" title={link.label} aria-label={link.label}>
                  <SocialIcon name={link.icon} size={15} />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .about-page {
    padding: 2.4rem 1.25rem 4rem;
  }

  .about-hero {
    max-width: 62ch;
    margin-bottom: 2.6rem;
  }
  .about-motto {
    margin: 1.2rem 0 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0.005em;
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
    line-height: 1.35;
    color: var(--text);
  }

  .about-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 2.2rem;
    align-items: start;
  }
  .about-main {
    padding-top: 0.2rem;
  }
  .about-text {
    color: var(--text-muted);
    font-size: 1.05rem;
    max-width: 58ch;
  }

  .author-card {
    border: 1px solid var(--border);
    background: var(--bg-raised);
    border-radius: var(--radius);
    padding: 1.3rem 1.4rem 1.4rem;
  }
  .author-avatar {
    border-radius: 50%;
    display: block;
  }
  .author-name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    margin: 0.7rem 0 0 0;
    color: var(--text);
  }
  .author-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin: 0.15rem 0 0.9rem 0;
  }
  .author-blurb {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0 0 0.8rem 0;
  }
  .author-blurb:last-of-type {
    margin-bottom: 0;
  }

  /* Links are icon-only and deliberately understated — small, muted,
     tucked below the bio instead of competing for attention. */
  .link-row {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    padding: 1rem 0 0 0;
    margin: 1.1rem 0 0 0;
    border-top: 1px solid var(--border);
  }
  .link-row a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    color: var(--text-faint);
    opacity: 0.75;
    transition: color 0.15s ease, opacity 0.15s ease, background 0.15s ease;
  }
  .link-row a:hover {
    color: var(--accent-3);
    opacity: 1;
    background: var(--bg-raised-2);
    text-decoration: none;
  }

  @media (max-width: 780px) {
    .about-layout {
      grid-template-columns: 1fr;
    }
    .author-card {
      max-width: 400px;
    }
  }
</style>
