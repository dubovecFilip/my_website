---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SocialIcon from '../../../components/SocialIcon.astro';
import { socialLinks } from '../../../data/social';
import { t } from '../../../i18n/dict';

const lang = 'en' as const;
const s = t(lang);

const links = socialLinks;
const stack = ['astro', 'netlify', 'markdown', 'sk / en'];

// The closing clause of the motto is set in rust, so the statement lands on
// the sentence's own emphasis rather than an arbitrary word count.
const mottoParts = s.about_motto.split(/(?<=[.!?])\s+/);
const mottoLead = mottoParts.slice(0, -1).join(' ');
const mottoTail = mottoParts[mottoParts.length - 1];
---

<BaseLayout lang={lang} title={s.nav_about} breadcrumb={s.nav_about}>
  <section class="statement">
    <p class="statement-text">
      {mottoLead && <>{mottoLead} </>}<span class="statement-accent">{mottoTail}</span>
    </p>
  </section>

  <div class="about-grid">
    <div class="about-main">
      <span class="eyebrow">{s.about_eyebrow}</span>
      <p class="about-lead">{s.about_intro_1}</p>
      <p class="about-text">{s.about_purpose_1}</p>
      <p class="about-text">{s.about_purpose_2}</p>
      <p class="about-text">{s.about_intro_2}</p>
    </div>

    <aside class="about-side">
      <div class="side-cell author-cell">
        <img src="/images/boggelino.png" width="84" height="84" alt="" class="author-avatar" />
        <div>
          <h2 class="side-title">BOGGELINO</h2>
          <p class="author-role">{s.about_author_title}</p>
        </div>
      </div>

      <div class="side-cell">
        <span class="eyebrow">{s.about_stack}</span>
        <div class="stack-row">
          {stack.map((item) => (
            <span class="tag">{item}</span>
          ))}
        </div>
      </div>

      <div class="side-cell">
        <span class="eyebrow">{s.about_links_title}</span>
        <ul class="link-row">
          {links.map((link) => (
            <li>
              <a href={link.url} target="_blank" rel="noopener noreferrer" title={link.label} aria-label={link.label}>
                <SocialIcon name={link.icon} size={16} />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="side-cell side-actions">
        <a class="btn-ghost" href={`/${lang}/tags/`}>&#8594; {s.all_tags}</a>
        <a class="btn-ghost" href={`/${lang}/rss.xml`}>&#8594; {s.footer_rss}</a>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .statement {
    background: var(--inv-bg);
    color: var(--inv-text);
    padding: 3.2rem var(--pad);
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .statement-text {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.9rem, 5vw, 3.8rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    max-width: 24ch;
  }
  .statement-accent {
    color: var(--accent);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .about-main {
    padding: 2.2rem var(--pad) 2.6rem;
    border-right: var(--rule-w) solid var(--rule);
  }
  .about-lead {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    line-height: 1.6;
    color: var(--text);
    margin: 1.1rem 0 1.4rem 0;
    max-width: 46ch;
  }
  .about-text {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.75;
    color: var(--text-body);
    max-width: 62ch;
  }

  .about-side {
    display: flex;
    flex-direction: column;
  }
  .side-cell {
    padding: 1.5rem var(--pad);
  }
  .side-cell + .side-cell {
    border-top: var(--rule-w) solid var(--rule);
  }
  .side-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    margin: 0;
  }
  .author-cell {
    display: flex;
    gap: 1.1rem;
    align-items: center;
  }
  .author-avatar {
    flex: none;
    border: var(--rule-w) solid var(--rule);
    border-radius: 0;
    display: block;
  }
  .author-role {
    margin: 0.3rem 0 0 0;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .stack-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.8rem;
  }

  .link-row {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0.8rem 0 0 0;
  }
  .link-row a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 2px solid var(--rule);
    color: inherit;
  }
  .link-row a:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .side-actions {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: auto;
  }

  @media (max-width: 860px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .about-main {
      border-right: none;
      border-bottom: var(--rule-w) solid var(--rule);
    }
  }
</style>
