---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SocialIcon from '../../../components/SocialIcon.astro';
import { t } from '../../../i18n/dict';

const lang = 'en' as const;
const s = t(lang);

const links: { label: string; url: string; icon: 'twitch' | 'kick' | 'youtube' | 'tiktok' | 'x' | 'kofi' }[] = [
  { label: 'Twitch', url: 'https://twitch.tv/boggelino', icon: 'twitch' },
  { label: 'Kick', url: 'https://kick.com/boggelino', icon: 'kick' },
  { label: 'YouTube', url: 'https://youtube.com/@boggelino', icon: 'youtube' },
  { label: 'TikTok', url: 'https://tiktok.com/@boggelino', icon: 'tiktok' },
  { label: 'X', url: 'https://x.com/boggelino', icon: 'x' },
  { label: 'Ko-fi', url: 'https://ko-fi.com/boggelino/', icon: 'kofi' },
];
---

<BaseLayout lang={lang} title={s.nav_about}>
  <div class="wrap about-page">
    <h1>{s.about_title}</h1>
    <hr class="gold-rule" />

    <p class="about-text">{s.about_intro_1}</p>
    <p class="about-text">{s.about_intro_2}</p>

    <h2 class="links-title">{s.about_links_title}</h2>
    <ul class="link-list">
      {links.map((link) => (
        <li>
          <a href={link.url} target="_blank" rel="noopener noreferrer">
            <SocialIcon name={link.icon} />
            <span>{link.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .about-page { padding: 3rem 1.25rem 4rem; }
  .about-text {
    color: var(--text-muted);
    font-size: 1.05rem;
    max-width: 58ch;
  }
  .about-text:first-of-type { margin-top: 1.6rem; }
  .links-title {
    margin-top: 2.5rem;
    font-size: 0.85rem;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-family: var(--font-mono);
    font-weight: 500;
  }
  .link-list {
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.6rem;
    max-width: 560px;
  }
  .link-list a {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    border: 1px solid var(--border);
    background: var(--bg-raised);
    border-radius: var(--radius);
    padding: 0.75rem 0.95rem;
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .link-list a:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .link-list a :global(.social-icon) {
    color: var(--accent-2);
  }
</style>
