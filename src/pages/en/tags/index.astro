---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { t } from '../../../i18n/dict';
import { countWords, readingTimeMinutes } from '../../../utils/article-stats';
import { extractFirstImage } from '../../../utils/extract-image';

const lang = 'en' as const;
const s = t(lang);

const allArticles = await getCollection('articles-en', ({ data }) => !data.draft);
const articles = allArticles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const tagCounts = new Map<string, number>();
for (const article of articles) {
  for (const tag of article.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

// Articles are numbered from the oldest one up, so an article keeps its
// number no matter how many get published after it.
const total = articles.length;
const numbered = articles.map((article, i) => ({ article, number: total - i }));

// Group into year runs for the default (chronological) ordering.
const years = [...new Set(numbered.map(({ article }) => article.data.date.getFullYear()))].sort((a, b) => b - a);
const byYear = years.map((year) => ({
  year,
  entries: numbered.filter(({ article }) => article.data.date.getFullYear() === year),
}));
---

<BaseLayout lang={lang} title={s.all_tags} breadcrumb={s.nav_tags}>
  <section class="page-head">
    <div class="head-text">
      <h1 class="display-xl">{s.nav_tags}</h1>
      <p class="head-count eyebrow">
        {s.label_articles}: {total} &middot; {s.search_tags_heading}: {tags.length}
      </p>
    </div>
    <div class="head-search">
      <label class="eyebrow head-search-label" for="search-input">{s.search_label}</label>
      <input type="search" id="search-input" class="head-search-input" placeholder={s.search_placeholder} aria-label={s.search_placeholder} />
    </div>
  </section>

  <section class="filters">
    <span class="eyebrow">{s.archive_filter_label}</span>
    <div class="filter-row" role="group" aria-label={s.archive_filter_label}>
      <button type="button" class="tag filter-chip is-all is-active" id="filter-all">
        {s.filter_all} &middot; {total}
      </button>
      {tags.map(([tag, count]) => (
        <label class="tag filter-chip">
          <input type="checkbox" data-tag={tag} />
          <span class="chip-label">{tag}</span>
          <span class="chip-count">&middot; {count}</span>
        </label>
      ))}
    </div>
    <label class="sort-field">
      <span class="eyebrow">{s.search_sort_label}</span>
      <select id="sort-select" class="sort-select" aria-label={s.search_sort_label}>
        <option value="newest">{s.sort_newest}</option>
        <option value="oldest">{s.sort_oldest}</option>
        <option value="reading-time">{s.sort_reading_time}</option>
        <option value="alphabetical">{s.sort_alphabetical}</option>
      </select>
      <button type="button" id="random-btn" class="btn-ghost random-btn" title={s.search_random_title}>
        &#8594; {s.search_random}
      </button>
    </label>
  </section>

  <p class="empty" id="empty-msg" hidden>{s.search_no_results}</p>

  <div id="archive-list">
    {byYear.map(({ year, entries }) => (
      <>
        <div class="year-band" data-year-band={year}>
          <span class="year-number">{year}</span>
          <span class="year-rule"></span>
          <span class="year-count eyebrow">{s.label_articles}: {entries.length}</span>
        </div>
        {entries.map(({ article, number }) => (
          <div
            class="filter-item"
            data-year={year}
            data-tags={article.data.tags.join(',')}
            data-title={article.data.title.toLowerCase()}
            data-description={article.data.description.toLowerCase()}
            data-date={article.data.date.valueOf()}
            data-reading-time={readingTimeMinutes(countWords(article.body))}
            data-href={`/${lang}/articles/${article.id}/`}
          >
            <ArticleCard
              lang={lang}
              index={number}
              slug={article.id}
              title={article.data.title}
              description={article.data.description}
              date={article.data.date}
              tags={article.data.tags}
              image={extractFirstImage(article.body)}
              readingTime={readingTimeMinutes(countWords(article.body))}
            />
          </div>
        ))}
      </>
    ))}
  </div>
</BaseLayout>

<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
  const randomBtn = document.getElementById('random-btn') as HTMLButtonElement;
  const allChip = document.getElementById('filter-all') as HTMLButtonElement;
  const emptyMsg = document.getElementById('empty-msg') as HTMLParagraphElement | null;
  const list = document.getElementById('archive-list') as HTMLElement | null;
  const checkboxes = document.querySelectorAll<HTMLInputElement>('.filter-chip input[type="checkbox"]');
  const items = document.querySelectorAll<HTMLElement>('.filter-item');
  const yearBands = document.querySelectorAll<HTMLElement>('[data-year-band]');
  const active = new Set<string>();

  function tagsOf(item: HTMLElement): string[] {
    return (item.dataset.tags ?? '').split(',').filter(Boolean);
  }

  function matchesActiveTags(tags: string[]): boolean {
    for (const tag of active) {
      if (!tags.includes(tag)) return false;
    }
    return true;
  }

  function matchesSearch(item: HTMLElement, query: string): boolean {
    if (!query) return true;
    const title = item.dataset.title ?? '';
    const description = item.dataset.description ?? '';
    const tags = (item.dataset.tags ?? '').toLowerCase();
    return title.includes(query) || description.includes(query) || tags.includes(query);
  }

  function sortItems(visible: HTMLElement[]): HTMLElement[] {
    const mode = sortSelect.value;
    return [...visible].sort((a, b) => {
      if (mode === 'oldest') return Number(a.dataset.date) - Number(b.dataset.date);
      if (mode === 'reading-time') return Number(a.dataset.readingTime) - Number(b.dataset.readingTime);
      if (mode === 'alphabetical') return (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '');
      return Number(b.dataset.date) - Number(a.dataset.date);
    });
  }

  /**
   * Year bands only make sense while the list is in date order. For the other
   * sort modes the bands are hidden and the rows run as one continuous list.
   */
  function layout(visible: HTMLElement[]) {
    if (!list) return;
    const mode = sortSelect.value;
    const sorted = sortItems(visible);
    const grouped = mode === 'newest' || mode === 'oldest';

    if (!grouped) {
      yearBands.forEach((band) => {
        band.hidden = true;
      });
      sorted.forEach((item) => list.appendChild(item));
      return;
    }

    const years = [...new Set(sorted.map((item) => item.dataset.year ?? ''))];
    for (const year of years) {
      const band = list.querySelector<HTMLElement>(`[data-year-band="${year}"]`);
      const inYear = sorted.filter((item) => item.dataset.year === year);
      if (band) {
        band.hidden = false;
        list.appendChild(band);
      }
      inYear.forEach((item) => list.appendChild(item));
    }
    yearBands.forEach((band) => {
      if (!years.includes(band.dataset.yearBand ?? '')) band.hidden = true;
    });
  }

  function render() {
    const query = searchInput.value.trim().toLowerCase();
    const searchMatched = [...items].filter((item) => matchesSearch(item, query));

    // Counts reflect: matches the search + matches every *other* active tag.
    checkboxes.forEach((checkbox) => {
      const tag = checkbox.dataset.tag!;
      const otherActive = new Set(active);
      otherActive.delete(tag);
      const count = searchMatched.filter((item) => {
        const tags = tagsOf(item);
        for (const other of otherActive) if (!tags.includes(other)) return false;
        return tags.includes(tag);
      }).length;
      const chip = checkbox.closest('.filter-chip');
      const countEl = chip?.querySelector('.chip-count');
      if (countEl) countEl.textContent = `\u00b7 ${count}`;
      const disabled = !active.has(tag) && count === 0;
      chip?.classList.toggle('is-disabled', disabled);
      chip?.classList.toggle('is-active', checkbox.checked);
      checkbox.disabled = disabled;
    });

    allChip?.classList.toggle('is-active', active.size === 0);

    const visible = searchMatched.filter((item) => matchesActiveTags(tagsOf(item)));
    const visibleSet = new Set(visible);
    items.forEach((item) => {
      item.hidden = !visibleSet.has(item);
    });

    if (emptyMsg) emptyMsg.hidden = visible.length > 0;
    layout(visible);
  }

  checkboxes.forEach((checkbox) => {
    checkbox.addEventListener('change', () => {
      const tag = checkbox.dataset.tag!;
      if (checkbox.checked) active.add(tag);
      else active.delete(tag);
      render();
    });
  });

  allChip?.addEventListener('click', () => {
    active.clear();
    checkboxes.forEach((checkbox) => {
      checkbox.checked = false;
    });
    render();
  });

  searchInput.addEventListener('input', render);
  sortSelect.addEventListener('change', render);

  randomBtn.addEventListener('click', () => {
    const visible = [...items].filter((item) => !item.hidden);
    const pool = visible.length > 0 ? visible : [...items];
    if (pool.length === 0) return;
    const pick = pool[Math.floor(Math.random() * pool.length)];
    const href = pick.dataset.href;
    if (href) window.location.href = href;
  });

  render();
</script>

<style>
  .page-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    align-items: end;
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .head-text {
    padding: 2rem var(--pad) 1.4rem;
  }
  .head-count {
    margin: 0.7rem 0 0 0;
  }
  .head-search {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border-left: var(--rule-w) solid var(--rule);
  }
  .head-search-label {
    padding: 0.8rem 1.1rem;
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .head-search-input {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.3rem;
    color: var(--text);
    background: none;
    border: none;
    padding: 1rem 1.1rem;
    width: 100%;
  }
  .head-search-input::placeholder {
    color: var(--text-faint);
  }
  .head-search-input:focus-visible {
    outline-offset: -3px;
  }

  .filters {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.3rem var(--pad);
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    cursor: pointer;
    user-select: none;
    font-family: var(--font-mono);
  }
  .filter-chip input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  .filter-chip:hover {
    background: var(--rule);
    color: var(--bg);
  }
  .filter-chip.is-active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
    font-weight: 700;
  }
  .filter-chip.is-all.is-active {
    background: var(--rule);
    border-color: var(--rule);
    color: var(--bg);
  }
  .filter-chip.is-disabled {
    border-style: dashed;
    color: var(--text-faint);
    cursor: not-allowed;
  }
  .filter-chip.is-disabled:hover {
    background: none;
    color: var(--text-faint);
  }
  .filter-chip:focus-within {
    outline: var(--rule-w) solid var(--accent);
    outline-offset: 3px;
  }

  .sort-field {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
  }
  .sort-select {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
    background: var(--bg);
    border: 2px solid var(--rule);
    border-radius: 0;
    padding: 0.6rem 0.7rem;
  }
  .random-btn {
    width: auto;
  }

  .year-band {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 0.8rem var(--pad);
    background: var(--bg-raised);
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .year-band[hidden] {
    display: none;
  }
  .year-number {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .year-rule {
    flex: 1;
    height: var(--rule-w);
    background: var(--rule);
  }

  .filter-item[hidden] {
    display: none;
  }

  .empty {
    padding: 2rem var(--pad);
    color: var(--text-muted);
    border-bottom: var(--rule-w) solid var(--rule);
  }

  @media (max-width: 860px) {
    .page-head {
      grid-template-columns: 1fr;
    }
    .head-search {
      border-left: none;
      border-top: var(--rule-w) solid var(--rule);
    }
  }
</style>
