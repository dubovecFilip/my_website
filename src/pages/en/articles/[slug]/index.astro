---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import TableOfContents from '../../../../components/TableOfContents.astro';
import ArticleLightbox from '../../../../components/ArticleLightbox.astro';
import RelatedArticles from '../../../../components/RelatedArticles.astro';
import AuthorNote from '../../../../components/AuthorNote.astro';
import ArticleStats from '../../../../components/ArticleStats.astro';
import { t } from '../../../../i18n/dict';
import { authors, defaultAuthor, type AuthorId } from '../../../../data/authors';
import { countWords, readingTimeMinutes } from '../../../../utils/article-stats';

export async function getStaticPaths() {
  const articles = await getCollection('articles-en', ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = tocHeadings.length > 0;
const lang = 'en' as const;
const s = t(lang);

// The language switcher needs a translation with the same ID to exist; otherwise
// send the reader to the SK homepage instead of a broken /sk/articles/<slug>/ link.
const skArticles = await getCollection('articles-sk');
const hasTranslation = skArticles.some((a) => a.id === article.id);
const translationHref = hasTranslation ? `/sk/articles/${article.id}/` : '/sk/';
const author = authors[(article.data.author as AuthorId) ?? defaultAuthor] ?? authors[defaultAuthor];

const dateStr = article.data.date.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const readingTime = readingTimeMinutes(countWords(article.body));
const readingTimeLabel = `${readingTime} min read`;
---

<BaseLayout lang={lang} title={article.data.title} description={article.data.description} translationHref={translationHref}>
  <article class="wrap-wide article">
    <a class="back-link mono" href={`/${lang}/`}>&larr; {s.back_home}</a>

    <header class="article-header">
      <h1>{article.data.title}</h1>
      <hr class="gold-rule" />
      <div class="article-meta mono">
        <span class="author">
          <img src={author.avatar} alt="" class="author-avatar" width="20" height="20" />
          {s.written_by} {author.name}
        </span>
        <span class="dot">&middot;</span>
        <time datetime={article.data.date.toISOString()}>{s.published_on} {dateStr}</time>
        <span class="dot">&middot;</span>
        <span>{readingTimeLabel}</span>
      </div>
      {article.data.tags.length > 0 && (
        <div class="article-tags">
          {article.data.tags.map((tag: string) => (
            <a class="tag" href={`/${lang}/tags/${tag}/`}>{tag}</a>
          ))}
        </div>
      )}
    </header>

    <div class:list={['article-layout', hasToc && 'has-toc']}>
      <TableOfContents lang={lang} headings={headings} />

      <div class="article-main">
        <div class="article-body">
          <Content />
        </div>

        <AuthorNote lang={lang} note={article.data.authorNote} avatar={author.avatar} />
        <ArticleStats lang={lang} body={article.body} />
      </div>
    </div>

    <hr class="divider" />
    <a class="back-link mono" href={`/${lang}/`}>&larr; {s.back_home}</a>

    <RelatedArticles lang={lang} currentId={article.id} currentTags={article.data.tags} />
  </article>

  <ArticleLightbox />
</BaseLayout>

<style>
  .article { padding: 2.5rem 1.25rem 4rem; }
  .back-link {
    color: var(--text-faint);
    font-size: 0.85rem;
    text-decoration: none;
  }
  .back-link:hover { color: var(--accent-3); }
  .article-header {
    max-width: var(--max-width);
    margin: 1.5rem auto 2.5rem;
  }
  .article-meta {
    color: var(--text-faint);
    font-size: 0.82rem;
    margin-top: 1rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .author {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .author-avatar {
    border-radius: 50%;
    display: block;
  }
  .dot { color: var(--border); }
  .article-tags {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .article-layout {
    display: block;
  }
  .article-layout.has-toc {
    display: grid;
    grid-template-columns: 220px minmax(0, var(--max-width));
    gap: 2.4rem;
    justify-content: center;
    align-items: start;
  }
  .article-main {
    min-width: 0;
    max-width: var(--max-width);
    margin: 0 auto;
  }
  .article-body {
    font-size: 1.05rem;
  }

  @media (max-width: 900px) {
    .article-layout.has-toc {
      grid-template-columns: 1fr;
      max-width: var(--max-width);
      margin: 0 auto;
    }
  }
</style>
