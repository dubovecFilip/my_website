---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { t } from '../../../../i18n/dict';

export async function getStaticPaths() {
  const articles = await getCollection('articles-en', ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const lang = 'en' as const;
const s = t(lang);

// The language switcher needs a translation with the same ID to exist — otherwise
// send the reader to the SK homepage instead of a broken /sk/articles/<slug>/ link.
const skArticles = await getCollection('articles-sk');
const hasTranslation = skArticles.some((a) => a.id === article.id);
const translationHref = hasTranslation ? `/sk/articles/${article.id}/` : '/sk/';

const dateStr = article.data.date.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout lang={lang} title={article.data.title} description={article.data.description} translationHref={translationHref}>
  <article class="wrap article">
    <a class="back-link mono" href={`/${lang}/`}>&larr; {s.back_home}</a>

    <header class="article-header">
      <img src="/images/mascot.png" alt="" class="stamp" width="52" height="52" />
      <h1>{article.data.title}</h1>
      <hr class="gold-rule" />
      <div class="article-meta mono">
        <span>{s.written_by} BOGGELINO</span>
        <span class="dot">&middot;</span>
        <time datetime={article.data.date.toISOString()}>{s.published_on} {dateStr}</time>
      </div>
      {article.data.tags.length > 0 && (
        <div class="article-tags">
          {article.data.tags.map((tag: string) => (
            <a class="tag" href={`/${lang}/tags/${tag}/`}>{tag}</a>
          ))}
        </div>
      )}
    </header>

    <div class="article-body">
      <Content />
    </div>

    <hr class="divider" />
    <a class="back-link mono" href={`/${lang}/`}>&larr; {s.back_home}</a>
  </article>
</BaseLayout>

<style>
  .article { padding: 2.5rem 1.25rem 4rem; }
  .back-link {
    color: var(--text-faint);
    font-size: 0.85rem;
    text-decoration: none;
  }
  .back-link:hover { color: var(--accent-3); }
  .article-header {
    margin: 1.5rem 0 2.5rem;
    position: relative;
  }
  .stamp {
    border-radius: 50%;
    margin-bottom: 1rem;
    transform: rotate(-6deg);
  }
  .article-meta {
    color: var(--text-faint);
    font-size: 0.82rem;
    margin-top: 1rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .dot { color: var(--border); }
  .article-tags {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }
  .article-body {
    font-size: 1.05rem;
  }
</style>
