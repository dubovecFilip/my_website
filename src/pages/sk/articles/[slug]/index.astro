---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { t } from '../../../../i18n/dict';
import { authors, defaultAuthor, type AuthorId } from '../../../../data/authors';

export async function getStaticPaths() {
  const articles = await getCollection('articles-sk', ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const lang = 'sk' as const;
const s = t(lang);

// The language switcher needs a translation with the same ID to exist — otherwise
// send the reader to the EN homepage instead of a broken /en/articles/<slug>/ link.
const enArticles = await getCollection('articles-en');
const hasTranslation = enArticles.some((a) => a.id === article.id);
const translationHref = hasTranslation ? `/en/articles/${article.id}/` : '/en/';
const author = authors[(article.data.author as AuthorId) ?? defaultAuthor] ?? authors[defaultAuthor];

const dateStr = article.data.date.toLocaleDateString('sk-SK', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout lang={lang} title={article.data.title} description={article.data.description} translationHref={translationHref}>
  <article class="wrap article">
    <a class="back-link mono" href={`/${lang}/`}>&larr; {s.back_home}</a>

    <header class="article-header">
      <h1>{article.data.title}</h1>
      <hr class="gold-rule" />
      <div class="article-meta mono">
        <span class="author">
          <img src={author.avatar} alt="" class="author-avatar" width="20" height="20" />
          {s.written_by} {author.name}
        </span>
        <span class="dot">&middot;</span>
        <time datetime={article.data.date.toISOString()}>{s.published_on} {dateStr}</time>
      </div>
      {article.data.tags.length > 0 && (
        <div class="article-tags">
          {article.data.tags.map((tag: string) => (
            <a class="tag" href={`/${lang}/tags/${tag}/`}>{tag}</a>
          ))}
        </div>
      )}
    </header>

    <div class="article-body">
      <Content />
    </div>

    <hr class="divider" />
    <a class="back-link mono" href={`/${lang}/`}>&larr; {s.back_home}</a>
  </article>
</BaseLayout>

<style>
  .article { padding: 2.5rem 1.25rem 4rem; }
  .back-link {
    color: var(--text-faint);
    font-size: 0.85rem;
    text-decoration: none;
  }
  .back-link:hover { color: var(--accent-3); }
  .article-header {
    margin: 1.5rem 0 2.5rem;
  }
  .article-meta {
    color: var(--text-faint);
    font-size: 0.82rem;
    margin-top: 1rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .author {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .author-avatar {
    border-radius: 50%;
    display: block;
  }
  .dot { color: var(--border); }
  .article-tags {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }
  .article-body {
    font-size: 1.05rem;
  }
</style>
