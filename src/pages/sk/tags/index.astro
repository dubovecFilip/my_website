---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { t } from '../../../i18n/dict';
import { countWords, readingTimeMinutes } from '../../../utils/article-stats';
import { extractFirstImage } from '../../../utils/extract-image';

const lang = 'sk' as const;
const s = t(lang);

const allArticles = await getCollection('articles-sk', ({ data }) => !data.draft);
const articles = allArticles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const tagCounts = new Map<string, number>();
for (const article of articles) {
  for (const tag of article.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout lang={lang} title={s.all_tags}>
  <div class="wrap-wide search-page">
    <h1>{s.all_tags}</h1>
    <hr class="gold-rule" />

    <div class="toolbar">
      <input type="search" id="search-input" class="search-input" placeholder={s.search_placeholder} aria-label={s.search_placeholder} />
      <button type="button" id="random-btn" class="random-btn" title={s.search_random_title}>
        <span aria-hidden="true">🎲</span> {s.search_random}
      </button>
      <label class="sort-field">
        <span class="sort-label">{s.search_sort_label}</span>
        <select id="sort-select" aria-label={s.search_sort_label}>
          <option value="newest">{s.sort_newest}</option>
          <option value="oldest">{s.sort_oldest}</option>
          <option value="reading-time">{s.sort_reading_time}</option>
          <option value="alphabetical">{s.sort_alphabetical}</option>
        </select>
      </label>
    </div>

    <div class="search-layout">
      <aside class="filter-panel">
        {tags.length > 0 && (
          <div class="filter-bar" role="group" aria-label={s.search_tags_heading}>
            <span class="filter-panel-title">{s.search_tags_heading}</span>
            {tags.map(([tag, count]) => (
              <label class="tag-checkbox">
                <input type="checkbox" data-tag={tag} />
                <span class="chip-label">{tag}</span>
                <span class="count">{count}</span>
              </label>
            ))}
          </div>
        )}
      </aside>

      <div class="search-main">
        {articles.length === 0 ? (
          <p class="empty">{s.home_empty}</p>
        ) : (
          <>
            <p class="empty" id="empty-msg" hidden>{s.search_no_results}</p>
            <div class="article-grid" id="filterable-list">
              {articles.map((article) => {
                const words = countWords(article.body);
                return (
                  <div
                    class="filter-item"
                    data-tags={article.data.tags.join(',')}
                    data-title={article.data.title.toLowerCase()}
                    data-description={article.data.description.toLowerCase()}
                    data-date={article.data.date.valueOf()}
                    data-reading-time={readingTimeMinutes(words)}
                    data-href={`/${lang}/articles/${article.id}/`}
                  >
                    <ArticleCard
                      lang={lang}
                      variant="grid"
                      slug={article.id}
                      title={article.data.title}
                      description={article.data.description}
                      date={article.data.date}
                      tags={article.data.tags}
                      image={extractFirstImage(article.body)}
                      readingTime={readingTimeMinutes(words)}
                    />
                  </div>
                );
              })}
            </div>
          </>
        )}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
  const randomBtn = document.getElementById('random-btn') as HTMLButtonElement;
  const emptyMsg = document.getElementById('empty-msg') as HTMLParagraphElement | null;
  const list = document.getElementById('filterable-list') as HTMLElement | null;
  const checkboxes = document.querySelectorAll<HTMLInputElement>('.tag-checkbox input[type="checkbox"]');
  const items = document.querySelectorAll<HTMLElement>('.filter-item');
  const active = new Set<string>();

  function tagsOf(item: HTMLElement): string[] {
    return (item.dataset.tags ?? '').split(',').filter(Boolean);
  }

  function matchesActiveTags(tags: string[]): boolean {
    for (const tag of active) {
      if (!tags.includes(tag)) return false;
    }
    return true;
  }

  function matchesSearch(item: HTMLElement, query: string): boolean {
    if (!query) return true;
    const title = item.dataset.title ?? '';
    const description = item.dataset.description ?? '';
    const tags = (item.dataset.tags ?? '').toLowerCase();
    return title.includes(query) || description.includes(query) || tags.includes(query);
  }

  function currentQuery(): string {
    return searchInput.value.trim().toLowerCase();
  }

  function applySort(visibleItems: HTMLElement[]) {
    if (!list) return;
    const mode = sortSelect.value;
    const sorted = [...visibleItems].sort((a, b) => {
      if (mode === 'oldest') {
        return Number(a.dataset.date) - Number(b.dataset.date);
      }
      if (mode === 'reading-time') {
        return Number(a.dataset.readingTime) - Number(b.dataset.readingTime);
      }
      if (mode === 'alphabetical') {
        return (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '');
      }
      // newest (default)
      return Number(b.dataset.date) - Number(a.dataset.date);
    });
    sorted.forEach((item) => list.appendChild(item));
  }

  function render() {
    const query = currentQuery();
    const searchMatched = [...items].filter((item) => matchesSearch(item, query));

    // Tag counts reflect: matches search + matches every *other* active tag.
    checkboxes.forEach((checkbox) => {
      const tag = checkbox.dataset.tag!;
      const otherActive = new Set(active);
      otherActive.delete(tag);
      const count = searchMatched.filter((item) => {
        const tags = tagsOf(item);
        for (const t of otherActive) if (!tags.includes(t)) return false;
        return tags.includes(tag);
      }).length;
      const countEl = checkbox.closest('.tag-checkbox')?.querySelector('.count');
      if (countEl) countEl.textContent = String(count);
      const disabled = !active.has(tag) && count === 0;
      checkbox.closest('.tag-checkbox')?.classList.toggle('is-disabled', disabled);
      checkbox.disabled = disabled;
    });

    const visible = searchMatched.filter((item) => matchesActiveTags(tagsOf(item)));
    const visibleSet = new Set(visible);
    items.forEach((item) => {
      item.style.display = visibleSet.has(item) ? '' : 'none';
    });

    if (emptyMsg) emptyMsg.hidden = visible.length > 0;
    applySort(visible);
  }

  checkboxes.forEach((checkbox) => {
    checkbox.addEventListener('change', () => {
      const tag = checkbox.dataset.tag!;
      if (checkbox.checked) active.add(tag);
      else active.delete(tag);
      render();
    });
  });

  searchInput.addEventListener('input', render);
  sortSelect.addEventListener('change', render);

  randomBtn.addEventListener('click', () => {
    const visible = [...items].filter((item) => item.style.display !== 'none');
    const pool = visible.length > 0 ? visible : [...items];
    if (pool.length === 0) return;
    const pick = pool[Math.floor(Math.random() * pool.length)];
    const href = pick.dataset.href;
    if (href) window.location.href = href;
  });

  render();
</script>

<style>
  .search-page { padding: 2.4rem 1.25rem 4rem; }

  .toolbar {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin: 1.8rem 0 1.6rem;
  }
  .search-input {
    flex: 1 1 260px;
    min-width: 0;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--text);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.6rem 0.9rem;
  }
  .search-input:focus-visible {
    outline: 2px solid var(--accent-3);
    outline-offset: 1px;
  }
  .random-btn {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.6rem 0.9rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .random-btn:hover {
    border-color: var(--accent-3);
    color: var(--text);
  }
  .sort-field {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .sort-field select {
    font-family: var(--font-body);
    font-size: 0.88rem;
    color: var(--text);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.5rem 0.6rem;
  }

  .search-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 2.2rem;
    align-items: start;
  }

  .filter-panel {
    position: sticky;
    top: 1.5rem;
    border: 1px solid var(--border);
    background: var(--bg-raised);
    border-radius: var(--radius);
    padding: 0.9rem;
  }
  .filter-panel-title {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 0.6rem;
    padding: 0 0.2rem;
  }
  .filter-bar {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .tag-checkbox {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    border-radius: 6px;
    padding: 0.5rem 0.6rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    cursor: pointer;
  }
  .tag-checkbox:hover {
    background: var(--bg-raised-2);
    color: var(--text);
  }
  .tag-checkbox input {
    width: auto;
    accent-color: var(--accent);
    cursor: pointer;
  }
  .chip-label {
    overflow-wrap: anywhere;
    flex: 1;
  }
  .tag-checkbox .count {
    color: var(--text-faint);
    font-size: 0.75rem;
  }
  .tag-checkbox.is-disabled {
    opacity: 0.35;
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .empty { color: var(--text-muted); margin-top: 1rem; }

  @media (max-width: 800px) {
    .search-layout {
      grid-template-columns: 1fr;
    }
    .filter-panel {
      position: static;
    }
    .article-grid {
      grid-template-columns: 1fr;
    }
    .sort-field {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
