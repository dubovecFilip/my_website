---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleLightbox from '../../../components/ArticleLightbox.astro';
import { getCollection } from 'astro:content';
import { t } from '../../../i18n/dict';
import { readGalleryPhotos } from '../../../utils/read-gallery';

const lang = 'sk' as const;
const s = t(lang);

// Article uploads carry their article's date and title, so the sheet can run
// newest first and the lightbox can name what you are looking at.
const articles = await getCollection('articles-sk', ({ data }) => !data.draft);
const meta = new Map(articles.map((a) => [a.id, { date: a.data.date, title: a.data.title }]));

const photos = readGalleryPhotos()
  .map((photo) => {
    const info = photo.articleId ? meta.get(photo.articleId) : undefined;
    return { ...photo, date: info?.date, title: info?.title };
  })
  // Drops into public/images/gallery/ lead, then article images newest first.
  .sort((a, b) => {
    if (!a.articleId && b.articleId) return -1;
    if (a.articleId && !b.articleId) return 1;
    const dateDiff = (b.date?.valueOf() ?? 0) - (a.date?.valueOf() ?? 0);
    if (dateDiff !== 0) return dateDiff;
    return a.file.localeCompare(b.file);
  });

// Contact-sheet rhythm: the opening frame runs 2x2, one later frame runs
// 2x1, and a counter tile sits in the fourth slot. Everything else is 1x1.
const WIDE_INDEX = 6;
const COUNTER_AFTER = 3;
---

<BaseLayout lang={lang} title={s.gallery_title} breadcrumb={s.nav_gallery}>
  <section class="page-head">
    <div class="head-text">
      <h1 class="display-xl">{s.gallery_title}</h1>
      <p class="head-intro">{s.gallery_intro}</p>
    </div>
  </section>

  {photos.length === 0 ? (
    <p class="empty">{s.gallery_empty}</p>
  ) : (
    <div class="sheet">
      {photos.map((photo, i) => (
        <>
          {i === COUNTER_AFTER && (
            <div class="sheet-counter">
              <span class="counter-number">{photos.length}</span>
              <span class="counter-label">{s.gallery_count}</span>
            </div>
          )}
          <a
            class:list={['sheet-item', i === 0 && 'is-hero', i === WIDE_INDEX && 'is-wide']}
            href={photo.src}
            target="_blank"
            rel="noopener noreferrer"
          >
            <img src={photo.src} alt={photo.title ?? ''} loading="lazy" />
            <span class="sheet-file">{photo.file}</span>
            <span class="sheet-zoom">&#8981; {s.gallery_zoom}</span>
          </a>
        </>
      ))}
    </div>
  )}

  <ArticleLightbox selector=".sheet-item img" />
</BaseLayout>

<style>
  .page-head {
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .head-text {
    padding: 2rem var(--pad) 1.6rem;
  }
  .head-intro {
    margin: 0.9rem 0 0 0;
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 60ch;
  }

  .sheet {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 210px;
    border-bottom: var(--rule-w) solid var(--rule);
  }

  .sheet-item {
    position: relative;
    overflow: hidden;
    border-right: var(--rule-w) solid var(--rule);
    border-bottom: var(--rule-w) solid var(--rule);
    background-image: var(--hatch);
  }
  .sheet-item.is-hero {
    grid-column: span 2;
    grid-row: span 2;
  }
  .sheet-item.is-wide {
    grid-column: span 2;
  }
  .sheet-item img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .sheet-item:hover {
    z-index: 2;
    box-shadow: inset 0 0 0 4px var(--accent);
  }

  .sheet-file {
    position: absolute;
    left: 10px;
    bottom: 10px;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--bg);
    color: var(--text);
    border: 2px solid var(--rule);
    padding: 0.25rem 0.45rem;
    max-width: calc(100% - 20px);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sheet-zoom {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .sheet-zoom {
    pointer-events: none;
  }
  .sheet-zoom::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--rule);
    opacity: 0.18;
  }
  .sheet-item:hover .sheet-zoom {
    display: flex;
  }
  .sheet-zoom {
    color: var(--bg);
    text-shadow: none;
  }

  .sheet-counter {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    padding: 1.2rem;
    background: var(--bg);
    color: var(--text);
    border-right: var(--rule-w) solid var(--rule);
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .counter-number {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 2.2rem;
    line-height: 1;
    color: var(--accent);
  }
  .counter-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .empty {
    padding: 2rem var(--pad);
    color: var(--text-muted);
    border-bottom: var(--rule-w) solid var(--rule);
  }

  @media (max-width: 860px) {
    .sheet {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 160px;
    }
  }
</style>
