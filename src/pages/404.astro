---
import BaseLayout from '../layouts/BaseLayout.astro';
import { dict, defaultLang } from '../i18n/dict';
---

<BaseLayout lang={defaultLang} title="404">
  <div class="wrap not-found">
    <img src="/images/boggelino.png" alt="" width="72" height="72" class="lost-boggelino" />
    <h1>{dict.sk.not_found_title} / {dict.en.not_found_title}</h1>
    <hr class="gold-rule" />
    <p>{dict.sk.not_found_body}</p>
    <p>{dict.en.not_found_body}</p>
    <div class="links">
      <a href="/sk/">&larr; Domov (SK)</a>
      <a href="/en/">&larr; Home (EN)</a>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    padding: 5rem 1.25rem;
    text-align: center;
  }
  .lost-boggelino {
    border-radius: 50%;
    transform: rotate(-10deg);
    opacity: 0.85;
    margin-bottom: 1rem;
  }
  .gold-rule { margin-left: auto; margin-right: auto; }
  .links {
    display: flex;
    gap: 1.2rem;
    justify-content: center;
    margin-top: 1.5rem;
  }
</style>
