---
/**
 * Karta bez obrázka (sekcia 09 D): náhľad sa nahradí tichým monogramom na
 * tmavšej ploche, nikdy sivým štvorcom ani ikonou zlomeného obrázka.
 */
interface Props {
  ratio?: string;
  class?: string;
}

const { ratio = '16 / 9', class: className = '' } = Astro.props;
---

<div class:list={['ph', className]} style={`--ph-ratio:${ratio}`} aria-hidden="true">
  <span class="ph-mark">M<span class="wm-bar" /></span>
</div>

<style>
  .ph {
    aspect-ratio: var(--ph-ratio);
    width: 100%;
    display: grid;
    place-items: center;
    background: var(--grad-placeholder);
  }

  .ph-mark {
    font-family: var(--font-display);
    font-size: clamp(24px, 12cqw, 44px);
    line-height: 1;
    letter-spacing: -0.015em;
    color: rgba(244, 242, 236, 0.14);
  }

  .ph-mark :global(.wm-bar) {
    color: rgba(242, 114, 74, 0.3);
  }
</style>
