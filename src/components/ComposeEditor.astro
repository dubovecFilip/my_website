---
/**
 * Compose: editor článkov (sekcia 06 + 10).
 *
 * Pracuje s priečinkom projektu cez File System Access API. Bez vybraného
 * priečinku nemá čo načítať ani kam uložiť, takže prázdna obrazovka s výzvou
 * je zároveň jeho ochranou.
 */
import { authors } from '../data/authors';

const authorList = Object.entries(authors).map(([id, a]) => ({ id, name: a.name }));

const tools = [
  { key: 'b', label: 'B' },
  { key: 'i', label: 'I' },
  { key: 'h2', label: 'H2' },
  { key: 'h3', label: 'H3' },
  { key: 'quote', label: '❝' },
  { key: 'list', label: 'LIST' },
  { key: 'link', label: 'LINK' },
  { key: 'code', label: 'CODE' },
];
---

<div class="cmp" data-compose>
  <header class="cmp-head">
    <div class="cmp-head-left">
      <a class="cmp-brand" href="/sk/" aria-label="MOMENTUM_">
        <span aria-hidden="true">MOMENTUM<span class="wm-bar" /></span>
      </a>
      <span class="cmp-badge">Compose</span>
    </div>

    <div class="cmp-head-right">
      <button type="button" class="cmp-pill is-state" data-off data-folder-pick>
        <span class="cmp-dot" aria-hidden="true">●</span>
        <span data-folder-label>Select project folder</span>
      </button>
      <button type="button" class="cmp-pill" data-refresh>↻ Refresh list</button>
      <button type="button" class="cmp-pill is-primary" data-new>
        + New article
      </button>
    </div>
  </header>

  <!-- Bez vybraného priečinku nie je čo zobraziť. -->
  <div class="cmp-gate" data-gate>
    <p class="cmp-gate-mark" aria-hidden="true">M<span class="wm-bar" /></p>
    <h1 class="cmp-gate-title">Vyber priečinok projektu</h1>
    <p class="cmp-gate-text">
      Editor číta a zapisuje priamo do <code>src/content/articles/</code> a
      <code>public/images/articles/</code>. Vyber priečinok projektu a môžeš písať.
    </p>
    <button type="button" class="btn btn-primary" data-folder-pick>Vybrať priečinok</button>
    <p class="cmp-gate-note" data-gate-note hidden>
      Tento prehliadač nepodporuje File System Access API. Použi Chrome alebo Edge, prípadne si
      články stiahni ako .md súbory.
    </p>
  </div>

  <div class="cmp-shell" data-shell hidden>
    <aside class="cmp-list">
      <p class="cmp-label cmp-label-row">
        <span>Articles</span>
        <span class="cmp-dim" data-list-count></span>
      </p>
      <div class="cmp-list-items" data-list></div>
    </aside>

    <div class="cmp-editor">
      <!-- Meta a stavy --------------------------------------------------- -->
      <div class="cmp-row cmp-row-top">
        <div class="cmp-meta">
          <span class="cmp-chip">ID · <b data-meta-id>nový</b></span>
          <span class="cmp-chip" data-meta-date>dnes</span>
          <label class="cmp-chip cmp-chip-select">
            <span>Autor ·</span>
            <select data-f-author aria-label="Autor článku">
              {
                authorList.map((a) => (
                  <option value={a.id}>{a.name}</option>
                ))
              }
            </select>
          </label>
        </div>

        <div class="cmp-states">
          <button type="button" class="cmp-toggle is-draft" data-toggle-draft aria-pressed="false">
            <span class="cmp-square is-hatch" aria-hidden="true"></span>
            Rozpísané · verejné so značkou
          </button>

          <button type="button" class="cmp-toggle is-pin" data-toggle-pin aria-pressed="false">
            <span class="cmp-square is-accent" aria-hidden="true"></span>
            Pin
          </button>

          <div class="cmp-langs" role="group" aria-label="Jazyk">
            <span class="cmp-langs-label">Jazyk ·</span>
            <button type="button" class="cmp-lang is-on" data-lang-tab="sk" aria-pressed="true">
              SK
            </button>
            <button type="button" class="cmp-lang" data-lang-tab="en" aria-pressed="false">EN</button>
          </div>
        </div>
      </div>

      <!-- Názov ---------------------------------------------------------- -->
      <div class="cmp-field">
        <p class="cmp-label cmp-label-row">
          <span>Article title</span>
          <span class="cmp-len" data-len-title></span>
        </p>
        <input class="cmp-input is-title" type="text" data-f="title" placeholder="Názov článku" />
        <p class="cmp-hint" data-hint-title></p>
      </div>

      <!-- Popis a tagy --------------------------------------------------- -->
      <div class="cmp-grid cmp-grid-desc">
        <div class="cmp-field">
          <p class="cmp-label cmp-label-row">
            <span>Description</span>
            <span class="cmp-len" data-len-desc></span>
          </p>
          <textarea class="cmp-input" rows="2" data-f="description" placeholder="Jedna veta."
          ></textarea>
          <p class="cmp-hint" data-hint-desc></p>
        </div>

        <div class="cmp-field">
          <p class="cmp-label">Tagy (oddelené čiarkou)</p>
          <input class="cmp-input is-mono" type="text" data-f="tags" placeholder="proces, písanie" />
        </div>
      </div>

      <!-- Nadväznosť a chyby --------------------------------------------- -->
      <div class="cmp-grid cmp-grid-half">
        <div class="cmp-field">
          <p class="cmp-label">Nadväzuje na (ID predchádzajúceho článku)</p>
          <div class="cmp-follows">
            <input class="cmp-input is-mono" type="text" data-f="follows" placeholder="742018" />
            <span class="cmp-follows-title" data-follows-title></span>
          </div>
        </div>

        <div class="cmp-field">
          <p class="cmp-label">Chybové stavy</p>
          <div class="cmp-errors" data-errors>
            <p class="cmp-ok">Zatiaľ nič, všetko sedí.</p>
          </div>
        </div>
      </div>

      <!-- Text ----------------------------------------------------------- -->
      <div class="cmp-field">
        <p class="cmp-label cmp-label-row">
          <span>Body, markdown</span>
          <span class="cmp-tools">
            {
              tools.map((tool) => (
                <button type="button" class="cmp-tool" data-tool={tool.key}>
                  {tool.label}
                </button>
              ))
            }
          </span>
        </p>
        <textarea class="cmp-input is-body" data-f="body" spellcheck="true"></textarea>
      </div>

      <!-- Obrázky a poznámka --------------------------------------------- -->
      <div class="cmp-grid cmp-grid-media">
        <div class="cmp-field">
          <p class="cmp-label">Images</p>
          <div class="cmp-images" data-images>
            <button type="button" class="cmp-image-add" data-image-add>+ Vybrať</button>
          </div>
          <input type="file" accept="image/*" multiple hidden data-image-input />
        </div>

        <div class="cmp-field">
          <p class="cmp-label">Author's note</p>
          <textarea class="cmp-input" rows="3" data-f="authorNote" placeholder="Voliteľné."
          ></textarea>
        </div>
      </div>

      <!-- Náhľady --------------------------------------------------------- -->
      <section class="cmp-preview" aria-label="Náhľad">
        <p class="cmp-label cmp-label-row">
          <span>Náhľad</span>
          <span class="cmp-dim">Otvorí sa skutočná stránka v novej karte</span>
        </p>

        <div class="cmp-preview-links">
          <button type="button" class="cmp-pill" data-preview="home">Homepage</button>
          <button type="button" class="cmp-pill" data-preview="archive">Archív</button>
          <button type="button" class="cmp-pill" data-preview="article">Stránka článku</button>
        </div>

        <p class="cmp-preview-note">
          Náhľad je celá obrazovka webu s tvojím článkom, takže sa dá scrollovať aj meniť šírka
          okna a vidíš všetky stavy rozloženia.
        </p>

        <p class="cmp-sub">Kontrola dĺžok</p>
        <p class="pv-note-chips" data-pv-chips></p>

        <p class="cmp-sub">Náhľad lokalizácie</p>
        <div class="pv-locale" data-pv-locale></div>
      </section>
    </div>
  </div>

  <!--
    Prepínač jazyka nabehne vpravo hore, len čo pôvodný riadok odscrolluje.
    Lišta s uložením je dole stále.
  -->
  <div class="cmp-float-top" data-float-top hidden>
    <div class="cmp-langs" role="group" aria-label="Jazyk">
      <span class="cmp-langs-label">Jazyk ·</span>
      <button type="button" class="cmp-lang is-on" data-lang-tab="sk" aria-pressed="true">SK</button>
      <button type="button" class="cmp-lang" data-lang-tab="en" aria-pressed="false">EN</button>
    </div>
  </div>

  <div class="cmp-float">
    <p class="cmp-float-note">Uloženie = jeden commit, správa sa skladá automaticky</p>
    <div class="cmp-float-actions">
      <button type="button" class="cmp-pill" data-download>↓ Stiahnuť .md</button>
      <button type="button" class="cmp-pill is-save" data-save>Uložiť do projektu</button>
    </div>
  </div>

  <p class="cmp-toast" data-toast hidden role="status" aria-live="polite"></p>
</div>

<script>
  import { initCompose } from '../scripts/compose';
  initCompose();
  document.addEventListener('astro:page-load', initCompose);
</script>

<style>
  .cmp {
    --cmp-bg: #0e0e0e;
    min-height: 100vh;
    background: var(--surface);
    color: var(--ink);
  }

  /* Hlavička ---------------------------------------------------------- */

  .cmp-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    flex-wrap: wrap;
    padding: 20px 40px;
    background: var(--cmp-bg);
  }

  .cmp-head-left {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .cmp-brand {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: 20px;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    color: var(--ink);
    transition: opacity var(--t);
  }

  @media (hover: hover) {
    .cmp-brand:hover {
      opacity: 0.75;
    }
  }

  .cmp-badge {
    padding: 6px 12px;
    border-radius: var(--r-pill);
    background: var(--fill-strong);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .cmp-head-right {
    display: flex;
    align-items: center;
    gap: 9px;
    flex-wrap: wrap;
  }

  .cmp-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 0 17px;
    border-radius: var(--r-pill);
    background: var(--fill-strong);
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: background-color var(--t), color var(--t), filter var(--t);
  }

  @media (hover: hover) {
    .cmp-pill:hover {
      background: rgba(244, 242, 236, 0.1);
      color: var(--ink);
    }
  }

  .cmp-pill.is-primary {
    background: var(--accent);
    color: var(--surface);
    font-weight: 700;
  }

  @media (hover: hover) {
    .cmp-pill.is-primary:hover {
      background: var(--accent);
      color: var(--surface);
      filter: brightness(1.08);
    }
  }

  .cmp-pill.is-save {
    background: var(--ink);
    color: var(--surface);
    font-weight: 700;
    padding: 0 24px;
    min-height: 46px;
  }

  @media (hover: hover) {
    .cmp-pill.is-save:hover {
      background: var(--ink);
      color: var(--surface);
      filter: brightness(0.94);
    }
  }

  .cmp-pill.is-state {
    background: rgba(80, 180, 120, 0.14);
    color: #7fc79b;
  }

  .cmp-pill.is-state[data-off] {
    background: rgba(217, 63, 17, 0.14);
    color: var(--accent-text);
  }

  .cmp-dot {
    font-size: 9px;
  }

  /* Uvítacia obrazovka -------------------------------------------------- */

  .cmp-gate {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-14);
    min-height: 70vh;
    padding: var(--sp-38);
    text-align: center;
  }

  .cmp-gate-mark {
    font-family: var(--font-display);
    font-size: 88px;
    line-height: 1;
    letter-spacing: -0.015em;
    color: #1b1b1b;
  }

  .cmp-gate-mark :global(.wm-bar) {
    color: rgba(217, 63, 17, 0.4);
  }

  .cmp-gate-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 34px;
    letter-spacing: -0.015em;
  }

  .cmp-gate-text {
    max-width: 52ch;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--ink-3);
  }

  .cmp-gate-text code {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--ink-2);
  }

  .cmp-gate-note {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.7;
    color: var(--draft);
    max-width: 52ch;
  }

  /* Rozloženie ---------------------------------------------------------- */

  /* Zoznam je dosť široký na to, aby sa názov zmestil na jeden riadok
     a značky stavu sa vedľa neho poskladali pod seba. */
  .cmp-shell {
    display: grid;
    grid-template-columns: 400px minmax(0, 1fr);
    align-items: stretch;
  }

  .cmp-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px 22px 110px;
    background: var(--cmp-bg);
  }

  .cmp-list-items {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .cmp-editor {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 28px 40px 110px;
    min-width: 0;
  }

  .cmp-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-4);
  }

  .cmp-label-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .cmp-dim {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4d4941;
  }

  .cmp-sub {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #5a564f;
    margin-top: 8px;
  }

  /* Zoznam článkov ------------------------------------------------------ */

  :global(.cmp-item) {
    display: flex;
    flex-direction: column;
    gap: 11px;
    padding: 16px;
    border-radius: 18px;
    background: var(--fill-2);
    text-align: left;
    transition: background-color var(--t);
  }

  :global(.cmp-item.is-active) {
    background: rgba(244, 242, 236, 0.07);
  }

  :global(.cmp-item-head) {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  :global(.cmp-item-title) {
    flex: 1;
    min-width: 0;
    font-family: var(--font-display);
    font-size: 17px;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Značky idú pod seba, aby nekrátili názov. */
  :global(.cmp-flags) {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 5px;
    flex: none;
  }

  :global(.cmp-flag) {
    padding: 4px 9px;
    border-radius: var(--r-pill);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  :global(.cmp-flag.is-published) {
    background: rgba(80, 180, 120, 0.16);
    color: #7fc79b;
  }

  :global(.cmp-flag.is-draft) {
    background: var(--fill-strong);
    color: var(--ink-3);
  }

  :global(.cmp-flag.is-pinned) {
    background: var(--accent);
    color: var(--surface);
  }

  :global(.cmp-item-meta) {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    line-height: 1.7;
    color: #5a564f;
  }

  :global(.cmp-item-actions) {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  :global(.cmp-act) {
    padding: 6px 11px;
    border-radius: var(--r-pill);
    background: var(--fill-strong);
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: background-color var(--t), color var(--t);
  }

  @media (hover: hover) {
    :global(.cmp-act:hover) {
      background: rgba(244, 242, 236, 0.12);
      color: var(--ink);
    }
  }

  :global(.cmp-act.is-danger) {
    background: rgba(217, 63, 17, 0.14);
    color: var(--accent-text);
  }

  /* Polia --------------------------------------------------------------- */

  .cmp-row-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .cmp-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .cmp-chip {
    padding: 9px 14px;
    border-radius: var(--r-pill);
    background: var(--fill);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .cmp-chip b {
    font-weight: 400;
    color: var(--ink-2);
  }

  .cmp-states {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .cmp-toggle {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-4);
    transition: color var(--t);
  }

  .cmp-toggle[aria-pressed='true'].is-draft {
    color: var(--draft);
  }

  .cmp-toggle[aria-pressed='true'].is-pin {
    color: var(--ink-2);
  }

  .cmp-square {
    width: 16px;
    height: 16px;
    border-radius: 6px;
    background: var(--fill-strong);
    transition: background-color var(--t);
  }

  .cmp-toggle[aria-pressed='true'] .cmp-square.is-hatch {
    background: repeating-linear-gradient(
      135deg,
      rgba(217, 134, 31, 0.75) 0 5px,
      rgba(217, 134, 31, 0.25) 5px 10px
    );
  }

  .cmp-toggle[aria-pressed='true'] .cmp-square.is-accent {
    background: var(--accent);
  }

  .cmp-langs {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: var(--r-pill);
    background: var(--fill-strong);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .cmp-langs-label {
    color: var(--ink-4);
  }

  .cmp-lang {
    padding: 5px 10px;
    border-radius: var(--r-pill);
    color: var(--ink-3);
    font: inherit;
    letter-spacing: inherit;
    transition: background-color var(--t), color var(--t);
  }

  .cmp-lang.is-on {
    background: var(--ink);
    color: var(--surface);
    font-weight: 700;
  }

  .cmp-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .cmp-grid {
    display: grid;
    gap: 16px;
  }

  .cmp-grid-desc {
    grid-template-columns: 1.6fr 1fr;
  }

  .cmp-grid-half {
    grid-template-columns: 1fr 1fr;
  }

  .cmp-grid-media {
    grid-template-columns: 1fr 1.2fr;
    align-items: start;
  }

  .cmp-input {
    width: 100%;
    padding: 16px 20px;
    border-radius: 18px;
    background: var(--surface-2);
    color: var(--ink-2);
    font-family: var(--font-text);
    font-size: 15.5px;
    line-height: 1.6;
    resize: vertical;
    transition: background-color var(--t);
  }

  .cmp-input:focus-visible {
    background: var(--surface-3);
  }

  .cmp-input::placeholder {
    color: var(--ink-4);
  }

  .cmp-input.is-title {
    padding: 18px 22px;
    font-family: var(--font-display);
    font-size: 30px;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .cmp-input.is-mono {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.04em;
  }

  .cmp-input.is-body {
    min-height: 280px;
    padding: 24px 26px;
    border-radius: 20px;
    font-family: var(--font-mono);
    font-size: 13.5px;
    line-height: 1.75;
    color: var(--ink-2);
  }

  .cmp-len {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--ink-4);
  }

  .cmp-len[data-level='warn'] {
    color: var(--draft);
  }

  .cmp-len[data-level='over'] {
    color: var(--accent-text);
  }

  .cmp-hint {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-4);
  }

  .cmp-hint:empty {
    display: none;
  }

  .cmp-hint[data-level='warn'] {
    color: var(--draft);
  }

  .cmp-hint[data-level='over'] {
    color: var(--accent-text);
  }

  .cmp-hint[data-level='ok'] {
    color: var(--ok);
  }

