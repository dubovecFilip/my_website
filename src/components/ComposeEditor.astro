---
// src/components/ComposeEditor.astro
// Shared editor UI, rendered inside a BaseLayout by src/pages/sk/compose.astro
// and src/pages/en/compose.astro. Uses only the site's real design tokens
// from src/styles/global.css (via BaseLayout) instead of redefining its own
// palette, so it always matches the live theme, including light mode.
---

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js" is:inline></script>

<div class="compose-layout">
      <div class="col">
        <div class="editor-scroll">
          <details class="manage" open>
            <summary>Správa článkov</summary>
            <fieldset style="margin-top: 0.6rem">
              <div class="toolbar">
                <button
                  type="button"
                  id="openProjectBtn"
                  onclick="openProjectAndScan()"
                >
                  📂 Vybrať priečinok projektu
                </button>
                <button
                  type="button"
                  id="scanArticlesBtn"
                  onclick="scanArticles()"
                >
                  🔄 Obnoviť zoznam
                </button>
                <button type="button" onclick="startNewArticle()">
                  🆕 Nový článok
                </button>
              </div>
              <div id="articleList" class="article-list"></div>
            </fieldset>
          </details>

          <fieldset>
            <legend>Spoločné údaje</legend>
            <div class="row">
              <div>
                <label>ID článku</label>
                <input type="text" id="articleId" placeholder="napr. 2" />
              </div>
              <div>
                <label>Dátum</label>
                <input type="date" id="date" />
              </div>
              <div>
                <label>Autor</label>
                <input type="text" id="author" value="boggelino" />
              </div>
            </div>
            <label
              ><input
                type="checkbox"
                id="draft"
                style="width: auto; margin-right: 0.4rem"
              />
              Draft (skryté, kým odškrtneš)</label
            >
            <label style="margin-top: 0.5rem">
              <input
                type="checkbox"
                id="pinned"
                style="width: auto; margin-right: 0.4rem"
              />
              📌 Pripnúť tento článok (zobrazí sa navrchu ako hlavný)</label
            >
            <label style="margin-top: 0.8rem">Obrázky</label>
            <input type="file" id="imageInput" accept="image/*" multiple />
            <div id="imgList"></div>
          </fieldset>

          <div class="lang-tabs">
            <button
              type="button"
              class="lang-tab is-active"
              data-lang="sk"
              onclick="switchTab('sk')"
            >
              🇸🇰 Slovenčina
            </button>
            <button
              type="button"
              class="lang-tab"
              data-lang="en"
              onclick="switchTab('en')"
            >
              🇬🇧 English
            </button>
          </div>

          <div id="panel-sk" class="lang-panel is-active">
            <label>Titulok (SK)</label>
            <input
              type="text"
              class="title"
              data-lang="sk"
              placeholder="Názov článku"
            />
            <label>Popis (SK)</label>
            <input
              type="text"
              class="description"
              data-lang="sk"
              placeholder="Jedna veta o čom článok je"
            />
            <label>Štítky (SK)</label>
            <input
              type="text"
              id="tags-sk"
              placeholder="napr. hry, 3D tlač (oddeľuj čiarkou)"
            />
            <label>Obsah (SK, Markdown)</label>
            <div class="toolbar">
              <button
                type="button"
                onclick="wrapSelection('sk', '**', '**')"
              >
                Tučné
              </button>
              <button type="button" onclick="wrapSelection('sk', '*', '*')">
                Kurzíva
              </button>
              <button
                type="button"
                onclick="insertAtCursor('sk', '\n## Nadpis\n')"
              >
                Nadpis
              </button>
              <button
                type="button"
                onclick="insertAtCursor('sk', '\n> citát\n')"
              >
                Citácia
              </button>
            </div>
            <textarea
              class="content"
              data-lang="sk"
              placeholder="Píš po slovensky..."
            ></textarea>
            <label>Poznámka autora (SK, voliteľné)</label>
            <textarea
              class="authorNote"
              data-lang="sk"
              placeholder="Napr. Táto recenzia vychádza z Build 42.20."
              rows="2"
            ></textarea>
          </div>

          <div id="panel-en" class="lang-panel">
            <label>Title (EN)</label>
            <input
              type="text"
              class="title"
              data-lang="en"
              placeholder="Article title"
            />
            <label>Description (EN)</label>
            <input
              type="text"
              class="description"
              data-lang="en"
              placeholder="One sentence, shown on homepage"
            />
            <label>Tags (EN)</label>
            <input
              type="text"
              id="tags-en"
              placeholder="e.g. gaming, 3d printing (comma separated)"
            />
            <label>Content (EN, Markdown)</label>
            <div class="toolbar">
              <button type="button" onclick="wrapSelection('en', '**', '**')">
                Bold
              </button>
              <button type="button" onclick="wrapSelection('en', '*', '*')">
                Italic
              </button>
              <button
                type="button"
                onclick="insertAtCursor('en', '\n## Heading\n')"
              >
                Heading
              </button>
              <button
                type="button"
                onclick="insertAtCursor('en', '\n> quote\n')"
              >
                Quote
              </button>
            </div>
            <textarea
              class="content"
              data-lang="en"
              placeholder="Write in English..."
            ></textarea>
            <label>Author's Note (EN, optional)</label>
            <textarea
              class="authorNote"
              data-lang="en"
              placeholder="E.g. This review is based on Build 42.20."
              rows="2"
            ></textarea>
          </div>
        </div>

        <div class="action-bar">
          <div class="toolbar" style="margin: 0">
            <button
              type="button"
              class="primary"
              id="saveToProjectBtn"
              onclick="saveToProject()"
            >
              💾 Uložiť priamo do projektu
            </button>
            <button type="button" onclick="downloadAll()">
              ⬇️ Stiahnuť .md súbory
            </button>
          </div>
          <p class="status" id="status"></p>
        </div>
      </div>

      <div class="col preview-col">
        <label>Náhľad (aktívna záložka) — presne ako na boggelino.netlify.app</label>
        <div class="preview-modes">
          <button
            type="button"
            class="preview-mode-btn is-active"
            data-mode="card"
            onclick="setPreviewMode('card')"
          >
            🔲 Malé okienko
          </button>
          <button
            type="button"
            class="preview-mode-btn"
            data-mode="featured"
            onclick="setPreviewMode('featured')"
          >
            📌 Pripnutý článok
          </button>
          <button
            type="button"
            class="preview-mode-btn"
            data-mode="article"
            onclick="setPreviewMode('article')"
          >
            📄 Celý článok
          </button>
          <button
            type="button"
            class="preview-fullscreen-btn"
            id="fullscreenBtn"
            onclick="toggleFullscreenPreview()"
            title="Zobraziť náhľad na celú obrazovku, v reálnej veľkosti"
          >
            ⛶
          </button>
        </div>
        <div class="preview" id="preview"></div>
      </div>
      <button
        type="button"
        class="preview-close-btn"
        id="previewCloseBtn"
        onclick="toggleFullscreenPreview()"
      >
        ✕ Zavrieť celú obrazovku
      </button>
    </div>

<style is:global>

      .compose-layout {
        box-sizing: border-box;
      }
      .compose-layout *,
      .compose-layout *::before,
      .compose-layout *::after {
        box-sizing: border-box;
      }
      .compose-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        max-width: 1500px;
        margin: 0 auto;
        width: 100%;
        padding: 1.2rem 1.5rem;
        color: var(--text);
        font-family: var(--font-body);
      }
      .compose-layout .col {
        display: flex;
        flex-direction: column;
        min-height: 0;
      }
      .compose-layout .editor-scroll {
        flex: 1;
        overflow-y: auto;
        padding-right: 0.4rem;
        min-height: 0;
      }
      .compose-layout .action-bar {
        flex-shrink: 0;
        margin-top: 0.7rem;
        padding-top: 0.7rem;
        border-top: 1px solid var(--border);
      }
      .compose-layout .preview-col label {
        flex-shrink: 0;
      }
      .compose-layout .preview-col .preview {
        flex: 1;
        min-height: 0;
        max-height: none;
      }
      @media (max-width: 900px) {
        .compose-layout {
          grid-template-columns: 1fr;
          overflow: visible;
        }
        .compose-layout .editor-scroll {
          overflow-y: visible;
        }
        .compose-layout .preview-col .preview {
          max-height: 60vh;
        }
      }
      .compose-layout fieldset {
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.9rem 1rem;
        margin-bottom: 1rem;
      }
      .compose-layout legend {
        color: var(--text-muted);
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0 0.4rem;
      }
      .compose-layout label {
        display: block;
        font-size: 0.82rem;
        color: var(--text-muted);
        margin: 0.55rem 0 0.22rem;
      }
      .compose-layout input[type="text"],
      .compose-layout input[type="date"],
      .compose-layout input[type="number"],
      .compose-layout textarea,
      .compose-layout select {
        width: 100%;
        background: var(--bg-raised);
        border: 1px solid var(--border);
        color: var(--text);
        padding: 0.5rem 0.6rem;
        border-radius: 5px;
        font-family: inherit;
        font-size: 0.92rem;
      }
      .compose-layout textarea.content {
        min-height: 260px;
        font-family: var(--font-mono);
        font-size: 0.88rem;
        line-height: 1.5;
      }
      .compose-layout .row {
        display: flex;
        gap: 0.7rem;
      }
      .compose-layout .row > div {
        flex: 1;
      }
      .compose-layout button {
        background: var(--bg-raised);
        border: 1px solid var(--border);
        color: var(--text);
        border-radius: 5px;
        padding: 0.55rem 1rem;
        font-weight: 600;
        cursor: pointer;
        font-size: 0.88rem;
      }
      .compose-layout button:hover {
        opacity: 0.9;
      }
      .compose-layout button.primary {
        background: var(--red);
        border-color: var(--red);
        color: white;
      }
      .compose-layout button:disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }
      .compose-layout .toolbar {
        display: flex;
        gap: 0.5rem;
        margin: 0.6rem 0;
        flex-wrap: wrap;
      }
      .compose-layout .preview {
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1.2rem 1.5rem;
        background: var(--bg-raised);
        overflow-y: auto;
      }
      .compose-layout .preview img {
        max-width: 100%;
        border-radius: 6px;
      }
      .compose-layout .preview code {
        background: var(--bg-raised-2);
        padding: 0.15em 0.4em;
        border-radius: 3px;
      }
      .compose-layout .hint {
        font-size: 0.78rem;
        color: var(--text-muted);
        margin-top: 0.3rem;
      }
      .compose-layout #imgList {
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-top: 0.6rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      .compose-layout .img-chip {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        background: var(--bg-raised);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 0.25rem 0.5rem;
      }
      .compose-layout .img-chip img {
        width: 28px;
        height: 28px;
        object-fit: cover;
        border-radius: 3px;
      }
      .compose-layout .lang-tabs {
        display: flex;
        gap: 0.4rem;
        margin: 1rem 0 0.7rem;
      }
      .compose-layout .lang-tab {
        flex: 1;
        background: var(--bg-raised);
        border: 1px solid var(--border);
        color: var(--text-muted);
        padding: 0.55rem;
        border-radius: 6px 6px 0 0;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.88rem;
      }
      .compose-layout .lang-tab.is-active {
        color: var(--gold);
        border-bottom: 2px solid var(--gold);
        background: var(--bg);
      }
      .compose-layout .lang-panel {
        display: none;
      }
      .compose-layout .lang-panel.is-active {
        display: block;
      }
      .compose-layout .status {
        font-size: 0.82rem;
        margin-top: 0.5rem;
        min-height: 1.2em;
      }
      .compose-layout .status.ok {
        color: var(--teal);
      }
      .compose-layout .status.err {
        color: var(--red);
      }
      .compose-layout .article-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-top: 0.6rem;
        max-height: 240px;
        overflow-y: auto;
      }
      .compose-layout .article-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.6rem;
        background: var(--bg-raised);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 0.45rem 0.65rem;
      }
      .compose-layout .article-info strong {
        font-size: 0.88rem;
      }
      .compose-layout .article-actions {
        display: flex;
        gap: 0.4rem;
        flex-shrink: 0;
      }
      .compose-layout .article-actions button {
        padding: 0.32rem 0.55rem;
        font-size: 0.76rem;
      }
      .compose-layout .badge {
        display: inline-block;
        font-size: 0.66rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        padding: 0.1rem 0.4rem;
        border-radius: 4px;
        margin-left: 0.4rem;
        vertical-align: middle;
      }
      .compose-layout .badge.draft {
        background: color-mix(in srgb, var(--gold) 15%, transparent);
        color: var(--gold);
      }
      .compose-layout .badge.published {
        background: color-mix(in srgb, var(--teal) 15%, transparent);
        color: var(--teal);
      }
      .compose-layout .badge.pinned {
        background: color-mix(in srgb, var(--red) 15%, transparent);
        color: var(--red);
      }
      .compose-layout details.manage summary {
        cursor: pointer;
        font-size: 0.78rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.2rem 0;
      }

</style>

<style is:global>

      /* ============================================================
         STYLES COPIED FROM THE LIVE SITE (boggelino.netlify.app)
         Deliberately wrapped in .site-scope so they don't clash with
         the editor's own styles.
         Source: src/styles/global.css, ArticleCard.astro,
                 pages/sk/index.astro, pages/sk/articles/[slug]/index.astro
         ============================================================ */
      .site-scope {
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-body);
        font-size: 17px;
        line-height: 1.6;
        border-radius: 8px;
        padding: 0;
      }
      .site-scope * {
        box-sizing: border-box;
      }
      .site-scope h1,
      .site-scope h2,
      .site-scope h3 {
        font-family: var(--font-display);
        font-weight: 400;
        letter-spacing: 0.01em;
        line-height: 1.05;
        text-transform: uppercase;
        margin: 0 0 0.5em 0;
        color: var(--text);
      }
      .site-scope h1 {
        font-size: clamp(2.2rem, 6vw, 3.6rem);
      }
      .site-scope h2 {
        font-size: clamp(1.5rem, 4vw, 2.1rem);
      }
      .site-scope h3 {
        font-size: 1.25rem;
      }
      .site-scope p {
        margin: 0 0 1.1em 0;
      }
      .site-scope a {
        color: var(--accent-3);
        text-decoration: none;
      }
      .site-scope a:hover {
        text-decoration: underline;
      }
      .site-scope .mono {
        font-family: var(--font-mono);
      }
      .site-scope .eyebrow {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--accent-3);
      }
      .site-scope .gold-rule {
        height: 4px;
        width: 64px;
        background: linear-gradient(90deg, var(--gold), var(--red));
        border-radius: 2px;
        border: none;
        margin: 0.9rem 0 0 0;
      }
      .site-scope .tag {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.04em;
        text-transform: lowercase;
        color: var(--accent-2);
        background: color-mix(in srgb, var(--accent-2) 14%, transparent);
        border: 1px solid
          color-mix(in srgb, var(--accent-2) 35%, transparent);
        border-radius: 999px;
        padding: 0.2em 0.7em;
        text-decoration: none;
      }
      .site-scope .tag:hover {
        text-decoration: none;
        border-color: var(--accent-2);
      }
      .site-scope hr.divider {
        border: none;
        border-top: 1px solid var(--border);
        margin: 2.5rem 0;
      }

      /* --- preview: a "window" frame simulating the full page --- */
      .site-window {
        border: 1px solid var(--border);
        border-radius: 8px;
        overflow: hidden;
        background: var(--bg);
      }
      .site-window-bar {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 0.7rem;
        background: var(--bg-raised);
        border-bottom: 1px solid var(--border);
      }
      .site-window-bar span {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--border);
        display: inline-block;
      }
      .site-window-inner {
        padding: 1.6rem 1.4rem;
      }
      .site-window-inner.narrow-card {
        max-width: 340px;
        margin: 0 auto;
      }

      /* --- ArticleCard.astro (small card preview) --- */
      .site-scope .card {
        display: block;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--bg-raised);
        color: var(--text);
        text-decoration: none;
        transition: border-color 0.15s ease, transform 0.15s ease;
        overflow: hidden;
      }
      .site-scope .card:hover {
        border-color: var(--accent);
        text-decoration: none;
        transform: translateY(-2px);
      }
      .site-scope .card-body {
        padding: 1.1rem 1.2rem 1.3rem;
      }
      .site-scope .card-thumb {
        position: relative;
        height: 130px;
      }
      .site-scope .card-thumb-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        z-index: 0;
      }
      .site-scope .card-meta {
        font-size: 0.75rem;
        color: var(--text-faint);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin-bottom: 0.5rem;
      }
      .site-scope .card-title {
        font-size: 1.08rem;
        margin: 0 0 0.4em 0;
        color: var(--text);
      }
      .site-scope .card-desc {
        color: var(--text-muted);
        margin: 0 0 0.8em 0;
        font-size: 0.88rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .site-scope .card-tags {
        display: flex;
        gap: 0.4rem;
        flex-wrap: wrap;
      }

      /* --- pinned post (featured, from pages/sk/index.astro) --- */
      .site-scope .featured {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        gap: 2rem;
        border: 1px solid var(--border);
        background: var(--bg-raised);
        border-radius: 10px;
        padding: 2.4rem 2.4rem;
        margin-bottom: 2.6rem;
        position: relative;
        overflow: hidden;
      }
      .site-scope .featured-text {
        position: relative;
        z-index: 2;
      }
      .site-scope .featured h1 {
        margin: 0.5rem 0 0 0;
        color: var(--text);
      }
      .site-scope .featured-desc {
        color: var(--text-muted);
        font-size: 1.02rem;
        max-width: 48ch;
        margin: 1.1rem 0 1.4rem 0;
      }
      .site-scope .btn-read {
        display: inline-block;
        background: var(--accent-3);
        color: var(--bg);
        font-weight: 600;
        font-size: 0.9rem;
        padding: 0.6rem 1.3rem;
        border-radius: 6px;
      }
      .site-scope .btn-read:hover {
        text-decoration: none;
        filter: brightness(1.08);
      }
      .site-scope .featured-art {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        width: 55%;
        height: 100%;
        z-index: 1;
        pointer-events: none;
      }
      .site-scope .featured-image-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        -webkit-mask-image: linear-gradient(to right, transparent, black 40%);
        mask-image: linear-gradient(to right, transparent, black 40%);
      }
      @media (max-width: 900px) {
        .site-scope .featured {
          grid-template-columns: 1fr;
        }
        .site-scope .featured-art {
          display: none;
        }
      }

      /* --- the article itself ([slug]/index.astro) --- */
      .site-scope .article {
        padding: 0.2rem 0 0.5rem;
      }
      .site-scope .back-link {
        color: var(--text-faint);
        font-size: 0.85rem;
        text-decoration: none;
      }
      .site-scope .back-link:hover {
        color: var(--accent-3);
      }
      .site-scope .article-header {
        margin: 1.5rem 0 2.5rem;
      }
      .site-scope .article-meta {
        color: var(--text-faint);
        font-size: 0.82rem;
        margin-top: 1rem;
        display: flex;
        gap: 0.5rem;
        align-items: center;
        flex-wrap: wrap;
      }
      .site-scope .author {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
      }
      .site-scope .author-avatar {
        border-radius: 50% !important;
        display: block;
        width: 20px !important;
        height: 20px !important;
        object-fit: cover;
        flex-shrink: 0;
      }
      .site-scope .dot {
        color: var(--border);
      }
      .site-scope .article-tags {
        display: flex;
        gap: 0.45rem;
        flex-wrap: wrap;
        margin-top: 1rem;
      }
      .site-scope .article-body {
        font-size: 1.05rem;
      }
      .site-scope .article-body :is(h2, h3) {
        margin-top: 1.6em;
      }
      .site-scope .article-body img {
        max-width: 100%;
        border-radius: var(--radius);
        display: block;
        margin: 1.4em 0;
      }
      .site-scope .article-body pre {
        background: var(--bg-raised);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1em;
        overflow-x: auto;
      }
      .site-scope .article-body code {
        font-family: var(--font-mono);
        font-size: 0.9em;
      }
      .site-scope .article-body blockquote {
        border-left: 3px solid var(--accent);
        margin: 1.2em 0;
        padding: 0.2em 1em;
        color: var(--text-muted);
      }
      .site-scope .author-note {
        margin: 2.4rem 0;
        padding: 1.2rem 1.4rem 1.3rem;
        border: 1px solid color-mix(in srgb, var(--accent-3) 40%, var(--border));
        border-left: 4px solid var(--accent-3);
        background: color-mix(in srgb, var(--accent-3) 8%, var(--bg-raised));
        border-radius: 0 var(--radius) var(--radius) 0;
      }
      .site-scope .author-note-head {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.6rem;
      }
      .site-scope .author-note-avatar {
        border-radius: 50% !important;
        display: block;
        width: 26px !important;
        height: 26px !important;
        object-fit: cover;
        flex-shrink: 0;
      }
      .site-scope .author-note-title {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--accent-3);
      }
      .site-scope .author-note-text {
        margin: 0;
        color: var(--text);
        font-size: 1rem;
        font-style: italic;
        line-height: 1.55;
      }

      .preview-modes {
        display: flex;
        gap: 0.4rem;
        margin: 0 0 0.6rem;
        flex-shrink: 0;
      }
      .preview-mode-btn {
        flex: 1;
        background: var(--bg-raised);
        border: 1px solid var(--border);
        color: var(--text-muted);
        padding: 0.5rem 0.4rem;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.8rem;
        font-weight: 600;
      }
      .preview-mode-btn.is-active {
        color: var(--gold);
        border-color: var(--gold);
        background: var(--bg);
      }
      .preview-fullscreen-btn {
        flex: 0 0 auto;
        background: var(--bg-raised);
        border: 1px solid var(--border);
        color: var(--text-muted);
        padding: 0.5rem 0.7rem;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.8rem;
        font-weight: 600;
      }
      .preview-fullscreen-btn:hover {
        color: var(--gold);
        border-color: var(--gold);
      }

      /* Preview expanded to fill the screen, at the site's real
         dimensions (same max-width and paddings as on boggelino.netlify.app),
         instead of scaled down to half the editor's width. */
      .preview.is-fullscreen {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        max-height: none;
        z-index: 9999;
        margin: 0;
        border: none;
        border-radius: 0;
        padding: 0;
        overflow-y: auto;
      }
      body.preview-locked {
        overflow: hidden;
      }
      .preview-close-btn {
        display: none;
        position: fixed;
        top: 1.2rem;
        right: 1.4rem;
        z-index: 10000;
        background: var(--bg-raised);
        border: 1px solid var(--border);
        color: var(--text);
        padding: 0.5rem 0.9rem;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.85rem;
        font-weight: 600;
      }
      .preview-close-btn.is-visible {
        display: block;
      }
      .preview-close-btn:hover {
        border-color: var(--gold);
        color: var(--gold);
      }

      /* --- real dimensions from the live site, not artificially shrunk --- */
      .site-window-inner {
        padding: 2.4rem 1.25rem 4rem;
      }
      .site-window-inner.wide {
        max-width: 1180px;
        margin: 0 auto;
      }
      .site-window-inner.article-width {
        max-width: 780px;
        margin: 0 auto;
        padding: 2.5rem 1.25rem 4rem;
      }
      .site-window-inner.narrow-card {
        max-width: 420px;
        margin: 0 auto;
      }

</style>

<script is:inline>

      const $ = (sel) => document.querySelector(sel);
      const $$ = (sel) => document.querySelectorAll(sel);
      let activeLang = "sk";
      let projectDirHandle = null;
      let articlesIndex = {};
	  let isEditingExisting = false;

      const images = [];

      function todayISO() {
        return new Date().toISOString().slice(0, 10);
      }
      $("#date").value = todayISO();

      async function generateUniqueId() {
        // Generates a 6-digit ID, zero-padded on the left
        const randId = () =>
          String(Math.floor(Math.random() * 1000000)).padStart(6, "0");

        // If no project folder is selected yet, just return a random ID
        if (!projectDirHandle) {
          return randId();
        }

        try {
          // Opens the src/content/articles/sk folder (if it exists)
          const articlesDir = await ensureDir(projectDirHandle, [
            "src",
            "content",
            "articles",
            "sk",
          ]);

          let newId;
          let exists = true;
          let attempts = 0;

          // Keeps generating until it finds a free one (capped at 100 tries to avoid looping forever)
          while (exists && attempts < 100) {
            newId = randId();
            try {
              // Tries to check whether a file with this name already exists
              await articlesDir.getFileHandle(newId + ".md");
              attempts++;
            } catch (err) {
              // If the file doesn't exist, getFileHandle throws, meaning the ID is free!
              exists = false;
            }
          }
          return newId;
        } catch (e) {
          // On any error, fall back to a randomly generated ID
          return randId();
        }
      }

      (async () => {
        if (!$("#articleId").value) {
          $("#articleId").value = await generateUniqueId();
        }
      })();

      function switchTab(lang) {
        activeLang = lang;
        $$(".lang-tab").forEach((b) =>
          b.classList.toggle("is-active", b.dataset.lang === lang),
        );
        $$(".lang-panel").forEach((p) =>
          p.classList.toggle("is-active", p.id === "panel-" + lang),
        );
        updatePreview();
      }

      function activeContentEl() {
        return document.querySelector(
          '.content[data-lang="' + activeLang + '"]',
        );
      }

      let previewMode = "card";

      function setPreviewMode(mode) {
        previewMode = mode;
        $$(".preview-mode-btn").forEach((b) =>
          b.classList.toggle("is-active", b.dataset.mode === mode),
        );
        updatePreview();
      }

      // Swaps references to uploaded images (public/images/articles/...) for
      // temporary blob URLs, so they can be previewed before being saved to the project.
      function resolveImageUrl(src) {
        if (!src) return src;
        let resolved = src;
        images.forEach((img) => {
          const escaped = img.name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
          const re = new RegExp(
            "/images/articles/[^\"')\\s]*" + escaped + "$",
          );
          if (re.test(resolved)) resolved = img.url;
        });
        return resolved;
      }

      // Same logic as src/utils/extract-image.ts on the live site:
      // finds the first image in the markdown body (homepage cards use it
      // as the cover photo instead of the gradient placeholder).
      function extractFirstImage(md) {
        const match = md.match(/!\[[^\]]*\]\(([^)\s]+)/);
        return match ? resolveImageUrl(match[1]) : undefined;
      }

      // Same deterministic gradient pick based on the title as in
      // ArticleCard.astro, for when an article has no image.
      function gradientForTitle(title) {
        const gradients = [
          ["var(--accent)", "var(--accent-3)"],
          ["var(--accent-2)", "var(--accent-3)"],
          ["var(--accent)", "var(--accent-2)"],
        ];
        let hash = 0;
        for (const ch of title || "")
          hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;
        const [g1, g2] = gradients[hash % gradients.length];
        return `linear-gradient(135deg, ${g1}, ${g2})`;
      }

      // Cache: author name -> avatar URL. Until the real file is read
      // from the project, the live site's image is used temporarily so the
      // preview isn't left blank.
      const authorAvatarCache = {};

      function getAuthorAvatarUrl(author) {
        const key = (author || "").toLowerCase();
        if (!key) return "https://boggelino.netlify.app/images/boggelino.png";
        if (authorAvatarCache[key]) return authorAvatarCache[key];
        authorAvatarCache[key] =
          "https://boggelino.netlify.app/images/" + key + ".png";
        loadAuthorAvatarFromProject(key);
        return authorAvatarCache[key];
      }

      // Tries to find public/images/<author>.(png|jpg|jpeg|webp|gif) in
      // the currently selected project folder. If found, overwrites the cache
      // with the real file and re-renders the preview. Read-only, creates nothing.
      async function loadAuthorAvatarFromProject(key) {
        if (!projectDirHandle) return;
        try {
          const imagesDir = await projectDirHandle
            .getDirectoryHandle("public")
            .then((d) => d.getDirectoryHandle("images"));

          const exts = ["png", "jpg", "jpeg", "webp", "gif"];
          let fileHandle = null;
          for (const ext of exts) {
            try {
              fileHandle = await imagesDir.getFileHandle(key + "." + ext);
              break;
            } catch (e) {
              /* this extension doesn't exist, try the next one */
            }
          }
          if (!fileHandle) {
            for await (const [name, handle] of imagesDir.entries()) {
              if (handle.kind !== "file") continue;
              const base = name.replace(/\.[^.]+$/, "").toLowerCase();
              if (base === key) {
                fileHandle = handle;
                break;
              }
            }
          }
          if (!fileHandle) return;
          const file = await fileHandle.getFile();
          authorAvatarCache[key] = URL.createObjectURL(file);
          updatePreview();
        } catch (e) {
          // public/images doesn't exist or isn't accessible, keep the fallback
        }
      }

      function formatDate(dateStr, lang, style) {
        const d = dateStr ? new Date(dateStr + "T00:00:00") : new Date();
        if (isNaN(d.getTime())) return dateStr || "";
        const locale = lang === "sk" ? "sk-SK" : "en-GB";
        const opts =
          style === "long"
            ? { year: "numeric", month: "long", day: "numeric" }
            : { year: "numeric", month: "short", day: "numeric" };
        return d.toLocaleDateString(locale, opts);
      }

      function currentFormData() {
        const lang = activeLang;
        const title =
          document.querySelector('.title[data-lang="' + lang + '"]').value ||
          (lang === "sk" ? "Bez názvu" : "Untitled");
        const description = document.querySelector(
          '.description[data-lang="' + lang + '"]',
        ).value;
        const md = activeContentEl().value;
        const date = $("#date").value;
        const author = ($("#author").value.trim() || "boggelino").toLowerCase();
        const authorNote = (
          document.querySelector('.authorNote[data-lang="' + lang + '"]')
            ?.value || ""
        ).trim();
        const tags = $("#tags-" + lang)
          .value.split(",")
          .map((t) => t.trim())
          .filter(Boolean);
        return { lang, title, description, md, date, author, tags, authorNote };
      }

      function renderCardPreview(d) {
        const image = extractFirstImage(d.md);
        const thumbHtml = image
          ? `<div class="card-thumb card-thumb-photo"><img src="${escapeHtml(image)}" alt="" class="card-thumb-img" /></div>`
          : `<div class="card-thumb" style="background:${gradientForTitle(d.title)};"></div>`;
        return `
          <div class="site-scope">
            <div class="site-window-inner narrow-card">
              <a class="card card-grid" href="#" onclick="return false;">
                ${thumbHtml}
                <div class="card-body">
                  <div class="card-meta mono"><time>${escapeHtml(formatDate(d.date, d.lang, "short"))}</time></div>
                  <h3 class="card-title">${escapeHtml(d.title)}</h3>
                  <p class="card-desc">${escapeHtml(d.description || "")}</p>
                  ${d.tags.length ? `<div class="card-tags">${d.tags.map((t) => `<span class="tag">${escapeHtml(t)}</span>`).join("")}</div>` : ""}
                </div>
              </a>
            </div>
          </div>`;
      }

      // Opens/closes the fullscreen preview at the site's real size
      // (instead of scaled down to half the editor's width).
      function toggleFullscreenPreview() {
        const preview = $("#preview");
        const isFullscreen = preview.classList.toggle("is-fullscreen");
        document.body.classList.toggle("preview-locked", isFullscreen);
        $("#previewCloseBtn").classList.toggle("is-visible", isFullscreen);
        $("#fullscreenBtn").textContent = isFullscreen ? "⤢" : "⛶";
      }
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && $("#preview").classList.contains("is-fullscreen")) {
          toggleFullscreenPreview();
        }
      });

      function renderFeaturedPreview(d) {
        const image = extractFirstImage(d.md);
        const eyebrow = d.lang === "sk" ? "PRIPNUTÝ ČLÁNOK" : "PINNED POST";
        const readMore = d.lang === "sk" ? "Čítať článok" : "Read article";
        return `
          <div class="site-scope">
            <div class="site-window-inner wide">
              <section class="featured">
                <div class="featured-text">
                  <span class="eyebrow">${eyebrow}</span>
                  <h1>${escapeHtml(d.title)}</h1>
                  <hr class="gold-rule" />
                  <p class="featured-desc">${escapeHtml(d.description || "")}</p>
                  <a class="btn-read" href="#" onclick="return false;">${readMore}</a>
                </div>
                <div class="featured-art" aria-hidden="true">
                  <div class="featured-image-bg" style="background-image:url('${image ? escapeHtml(image) : ""}');"></div>
                </div>
              </section>
            </div>
          </div>`;
      }

      function renderArticlePreview(d) {
        let html = window.marked ? marked.parse(d.md) : d.md;
        images.forEach((img) => {
          const escaped = img.name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
          const re = new RegExp(
            "([\"'(])(/images/articles/[^\"')]*" + escaped + ")([\"')])",
            "g",
          );
          html = html.replace(re, "$1" + img.url + "$3");
        });
        const backLabel =
          d.lang === "sk" ? "Späť na všetky články" : "Back to all articles";
        const writtenBy = d.lang === "sk" ? "Napísal" : "Written by";
        const publishedOn = d.lang === "sk" ? "Publikované" : "Published";
        const avatar = getAuthorAvatarUrl(d.author);
        return `
          <div class="site-scope">
            <div class="site-window-inner article-width">
              <article class="wrap article">
                <a class="back-link mono" href="#" onclick="return false;">&larr; ${backLabel}</a>
                <header class="article-header">
                  <h1>${escapeHtml(d.title)}</h1>
                  <hr class="gold-rule" />
                  <div class="article-meta mono">
                    <span class="author"><img src="${avatar}" alt="" class="author-avatar" /> ${writtenBy} ${escapeHtml(d.author.toUpperCase())}</span>
                    <span class="dot">&middot;</span>
                    <time>${publishedOn} ${escapeHtml(formatDate(d.date, d.lang, "long"))}</time>
                  </div>
                  ${d.tags.length ? `<div class="article-tags">${d.tags.map((t) => `<a class="tag" href="#" onclick="return false;">${escapeHtml(t)}</a>`).join("")}</div>` : ""}
                </header>
                <div class="article-body">${html}</div>
                ${
                  d.authorNote
                    ? `<aside class="author-note"><header class="author-note-head"><img src="${avatar}" alt="" class="author-note-avatar" /><span class="author-note-title">${d.lang === "sk" ? "Poznámka autora" : "Author's Note"}</span></header><p class="author-note-text">${escapeHtml(d.authorNote)}</p></aside>`
                    : ""
                }
                <hr class="divider" />
                <a class="back-link mono" href="#" onclick="return false;">&larr; ${backLabel}</a>
              </article>
            </div>
          </div>`;
      }

      function updatePreview() {
        const d = currentFormData();
        let out;
        if (previewMode === "card") out = renderCardPreview(d);
        else if (previewMode === "featured") out = renderFeaturedPreview(d);
        else out = renderArticlePreview(d);
        $("#preview").innerHTML = out;
      }

      $$("input, textarea, select").forEach((el) =>
        el.addEventListener("input", updatePreview),
      );
      updatePreview();

      function insertAtCursor(lang, text) {
        const ta = document.querySelector('.content[data-lang="' + lang + '"]');
        const start = ta.selectionStart,
          end = ta.selectionEnd;
        ta.value = ta.value.slice(0, start) + text + ta.value.slice(end);
        ta.focus();
        ta.selectionStart = ta.selectionEnd = start + text.length;
        updatePreview();
      }

      function wrapSelection(lang, before, after) {
        const ta = document.querySelector('.content[data-lang="' + lang + '"]');
        const start = ta.selectionStart,
          end = ta.selectionEnd;
        const selected = ta.value.slice(start, end) || "text";
        ta.value =
          ta.value.slice(0, start) +
          before +
          selected +
          after +
          ta.value.slice(end);
        ta.focus();
        updatePreview();
      }

      $("#imageInput").addEventListener("change", (e) => {
  const files = Array.from(e.target.files);
  const id = $("#articleId").value.trim() || "ID";
  files.forEach((file) => {
    const originalExt = file.name.includes(".")
      ? file.name.slice(file.name.lastIndexOf("."))
      : "";
    let newName = prompt("Názov obrázka:", file.name);
    if (newName === null) return; // Zrušené, tento obrázok sa preskočí
    newName = newName.trim();
    if (!newName) newName = file.name;
    if (!newName.includes(".") && originalExt) newName += originalExt;

    const url = URL.createObjectURL(file);
    images.push({ name: newName, file, url });
    insertAtCursor(
      activeLang,
      "\n![popis obrázka](/images/articles/" +
        id +
        "/" +
        newName +
        ")\n",
    );
  });
  renderImgList();
  e.target.value = "";
});

      function renderImgList() {
        const id = $("#articleId").value.trim() || "ID";
        $("#imgList").innerHTML =
          images
            .map(
              (img) =>
                '<span class="img-chip"><img src="' +
                img.url +
                '" alt="" /> ' +
                img.name +
                "</span>",
            )
            .join("") +
          (images.length
            ? '<div class="hint" style="width:100%">Cieľ: public/images/articles/' +
              id +
              "/</div>"
            : "");
      }

      function escapeYamlString(value) {
        return String(value)
          .replace(/\\/g, "\\\\")
          .replace(/"/g, '\\"')
          .replace(/\n/g, "\\n");
      }

      function unescapeYamlString(value) {
        return String(value)
          .replace(/\\n/g, "\n")
          .replace(/\\"/g, '"')
          .replace(/\\\\/g, "\\");
      }

      function buildFrontmatter(lang) {
        const title =
          document.querySelector('.title[data-lang="' + lang + '"]').value ||
          "Bez nazvu";
        const description =
          document.querySelector('.description[data-lang="' + lang + '"]')
            .value || "";
        const authorNote = (
          document.querySelector('.authorNote[data-lang="' + lang + '"]')
            ?.value || ""
        ).trim();
        const date = $("#date").value || todayISO();
        const author = $("#author").value.trim() || "boggelino";
        const tags = $(`#tags-${lang}`)
          .value.split(",")
          .map((t) => t.trim())
          .filter(Boolean);
        const draft = $("#draft").checked;
        const pinned = $("#pinned").checked;

        let fm = "---\n";
        fm += 'title: "' + title.replace(/"/g, '\\"') + '"\n';
        fm += 'description: "' + description.replace(/"/g, '\\"') + '"\n';
        fm += "date: " + date + "\n";
        fm += "tags: [" + tags.map((t) => '"' + t + '"').join(", ") + "]\n";
        fm += 'author: "' + author + '"\n';
        if (draft) fm += "draft: true\n";
        if (pinned) fm += "pinned: true\n";
        if (authorNote)
          fm += 'authorNote: "' + escapeYamlString(authorNote) + '"\n';
        fm += "---\n\n";
        return fm;
      }

      function fullFileFor(lang) {
        const content = document
          .querySelector('.content[data-lang="' + lang + '"]')
          .value.trim();
        return buildFrontmatter(lang) + content + "\n";
      }

      function hasContent(lang) {
        return (
          document
            .querySelector('.content[data-lang="' + lang + '"]')
            .value.trim().length > 0 ||
          document
            .querySelector('.title[data-lang="' + lang + '"]')
            .value.trim().length > 0
        );
      }

      function downloadAll() {
        const id = $("#articleId").value.trim();
        if (!id) {
          setStatus(
            "Vyplň ID článku hore, použije sa ako názov súboru.",
            "err",
          );
          return;
        }
        let count = 0;
        ["sk", "en"].forEach((lang) => {
          if (!hasContent(lang)) return;
          const blob = new Blob([fullFileFor(lang)], { type: "text/markdown" });
          const a = document.createElement("a");
          a.href = URL.createObjectURL(blob);
          a.download = id + ".md";
          a.click();
          count++;
        });
        if (count === 0) {
          setStatus(
            "Nič na stiahnutie, obe jazykové verzie sú prázdne.",
            "err",
          );
          return;
        }
        setStatus(
          "Stiahnuté " +
            count +
            " súbor(y). Presuň ich do src/content/articles/<jazyk>/" +
            id +
            ".md a obrázky do public/images/articles/" +
            id +
            "/" +
            ($("#pinned").checked
              ? " Pozor: pri manuálnom sťahovaní sa staré pripnuté články neodopnú automaticky, treba to v nich zmazať ručne."
              : ""),
          "ok",
        );
      }

      const supportsFS = "showDirectoryPicker" in window;
      if (!supportsFS) {
        $("#saveToProjectBtn").disabled = true;
        $("#saveToProjectBtn").title =
          "Táto funkcia funguje len v Chrome / Edge. Použi sťahovanie súborov vyššie.";
        $("#openProjectBtn").disabled = true;
        $("#scanArticlesBtn").disabled = true;
        $("#articleList").innerHTML =
          '<p class="hint">Prehľad článkov funguje len v Chrome / Edge (potrebuje prístup k súborom projektu).</p>';
      }

      async function ensureDir(parent, parts) {
        let dir = parent;
        for (const part of parts) {
          dir = await dir.getDirectoryHandle(part, { create: true });
        }
        return dir;
      }

      async function writeFile(dirHandle, name, contents) {
        const fileHandle = await dirHandle.getFileHandle(name, {
          create: true,
        });
        const writable = await fileHandle.createWritable();
        await writable.write(contents);
        await writable.close();
      }

      // Goes through every other scanned article (both SK and EN versions) and,
      // for any that currently have "pinned: true", strips that line from the
      // frontmatter (rebuildFileFromData only writes it back if d.pinned is true).
      // Returns the list of article IDs that got unpinned.
      async function unpinOtherArticles(currentId) {
        const unpinnedIds = [];
        for (const otherId of Object.keys(articlesIndex)) {
          if (otherId === currentId) continue;
          const entry = articlesIndex[otherId];
          let changed = false;
          for (const lang of ["sk", "en"]) {
            if (entry[lang] && entry[lang].pinned) {
              entry[lang].pinned = false;
              const dir = await ensureDir(projectDirHandle, [
                "src",
                "content",
                "articles",
                lang,
              ]);
              await writeFile(
                dir,
                otherId + ".md",
                rebuildFileFromData(entry[lang]),
              );
              changed = true;
            }
          }
          if (changed) unpinnedIds.push(otherId);
        }
        return unpinnedIds;
      }

      async function saveToProject() {
        const id = $("#articleId").value.trim();
        if (!id) {
          setStatus("Vyplň ID článku hore.", "err");
          return;
        }
        try {
          if (!projectDirHandle) {
            setStatus(
              "Vyber koreňový priečinok projektu (ten, kde je package.json)...",
              "",
            );
            projectDirHandle = await window.showDirectoryPicker();
			markProjectSelected();
            await idbSetHandle(projectDirHandle);
          }
          let wrote = [];
          for (const lang of ["sk", "en"]) {
            if (!hasContent(lang)) continue;
            const articlesDir = await ensureDir(projectDirHandle, [
              "src",
              "content",
              "articles",
              lang,
            ]);
            await writeFile(articlesDir, id + ".md", fullFileFor(lang));
            wrote.push("src/content/articles/" + lang + "/" + id + ".md");
          }
          if (images.length > 0) {
            const imgDir = await ensureDir(projectDirHandle, [
              "public",
              "images",
              "articles",
              id,
            ]);
            for (const img of images) {
              await writeFile(imgDir, img.name, img.file);
            }
            wrote.push(
              "public/images/articles/" +
                id +
                "/ (" +
                images.length +
                " obrázok/ky)",
            );
          }
          if (wrote.length === 0) {
            setStatus(
              "Nič na uloženie, vyplň aspoň jednu jazykovú verziu.",
              "err",
            );
            return;
          }
          let unpinned = [];
          if ($("#pinned").checked) {
            unpinned = await unpinOtherArticles(id);
          }
          if (projectDirHandle) await scanArticles();
          const commitMsg = buildCommitMessage();
          try {
            await navigator.clipboard.writeText(commitMsg);
          } catch (e) {}
          setStatus(
            "Uložené: " +
              wrote.join(", ") +
              (unpinned.length
                ? ". Odopnuté staré pripnuté články: " + unpinned.join(", ") + "."
                : "") +
              ". Commit message skopírovaná do schránky: " +
              commitMsg,
            "ok",
          );
        } catch (err) {
          if (err.name === "AbortError") {
            setStatus("Zrušené.", "");
            return;
          }
          setStatus("Chyba pri ukladaní: " + err.message, "err");
        }
      }

	  function buildCommitMessage() {
      const skTitle = document.querySelector('.title[data-lang="sk"]').value;
      const enTitle = document.querySelector('.title[data-lang="en"]').value;
      const title = skTitle || enTitle || $("#articleId").value.trim();
      const langs = ["sk", "en"].filter((l) => hasContent(l));
      const langSuffix = langs.length === 2 ? " (SK + EN)" : "";
      const prefix = isEditingExisting ? "Úprava článku" : "Nový článok";
      return prefix + ": " + title + langSuffix;
    }

      function escapeHtml(s) {
        return String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({
              "&": "&amp;",
              "<": "&lt;",
              ">": "&gt;",
              '"': "&quot;",
              "'": "&#39;",
            })[c],
        );
      }

      function parseArticleFile(text) {
        text = text.replace(/^\uFEFF/, "").replace(/\r\n/g, "\n");
        const match = text.match(/^---\n([\s\S]*?)\n---\n\n?([\s\S]*)$/);
        if (!match) return null;
        const fm = match[1];
        const body = match[2].replace(/\n+$/, "");
        const getField = (key) => {
          const m = fm.match(new RegExp("^" + key + ':\\s*"(.*)"\\s*$', "m"));
          if (m) return m[1].replace(/\\"/g, '"');
          const m2 = fm.match(new RegExp("^" + key + ":\\s*(.*)$", "m"));
          return m2 ? m2[1].trim() : "";
        };
        const tagsMatch = fm.match(/^tags:\s*\[(.*?)\]\s*$/m);
        const tags = tagsMatch
          ? tagsMatch[1]
              .split(",")
              .map((t) => t.trim().replace(/^"|"$/g, ""))
              .filter(Boolean)
          : [];
        const draft = /^draft:\s*true\s*$/m.test(fm);
        const pinned = /^pinned:\s*true\s*$/m.test(fm);
        const authorNoteMatch = fm.match(/^authorNote:\s*"(.*)"\s*$/m);
        const authorNote = authorNoteMatch
          ? unescapeYamlString(authorNoteMatch[1])
          : "";
        return {
          title: getField("title"),
          description: getField("description"),
          date: getField("date"),
          author: getField("author") || "boggelino",
          tags,
          draft,
          pinned,
          authorNote,
          body,
        };
      }

      function rebuildFileFromData(d) {
        let fm = "---\n";
        fm += 'title: "' + (d.title || "").replace(/"/g, '\\"') + '"\n';
        fm +=
          'description: "' +
          (d.description || "").replace(/"/g, '\\"') +
          '"\n';
        fm += "date: " + d.date + "\n";
        fm +=
          "tags: [" +
          (d.tags || []).map((t) => '"' + t + '"').join(", ") +
          "]\n";
        fm += 'author: "' + (d.author || "boggelino") + '"\n';
        if (d.draft) fm += "draft: true\n";
        if (d.pinned) fm += "pinned: true\n";
        if (d.authorNote && d.authorNote.trim())
          fm += 'authorNote: "' + escapeYamlString(d.authorNote.trim()) + '"\n';
        fm += "---\n\n";
        return fm + d.body + "\n";
      }

		function markProjectSelected() {
		  const btn = $("#openProjectBtn");
		  btn.disabled = true;
		  btn.textContent = "📂 Projekt vybraný";
		}

      // Persists the selected project folder via IndexedDB so it survives
      // the full page reload that the Astro/Vite dev server triggers on
      // writes to src/content/articles/... (common when pinning, since that
      // rewrites multiple files at once). Without this, the folder would
      // have to be re-selected after every such reload.
      const DB_NAME = "boggelino-compose";
      const STORE_NAME = "handles";
      const HANDLE_KEY = "projectDirHandle";

      function idbOpen() {
        return new Promise((resolve, reject) => {
          const req = indexedDB.open(DB_NAME, 1);
          req.onupgradeneeded = () => req.result.createObjectStore(STORE_NAME);
          req.onsuccess = () => resolve(req.result);
          req.onerror = () => reject(req.error);
        });
      }

      async function idbSetHandle(handle) {
        try {
          const db = await idbOpen();
          await new Promise((resolve, reject) => {
            const tx = db.transaction(STORE_NAME, "readwrite");
            tx.objectStore(STORE_NAME).put(handle, HANDLE_KEY);
            tx.oncomplete = resolve;
            tx.onerror = () => reject(tx.error);
          });
        } catch (e) {
          // IndexedDB unavailable, auto-restore after reload just won't work
        }
      }

      async function idbGetHandle() {
        try {
          const db = await idbOpen();
          return await new Promise((resolve, reject) => {
            const tx = db.transaction(STORE_NAME, "readonly");
            const req = tx.objectStore(STORE_NAME).get(HANDLE_KEY);
            req.onsuccess = () => resolve(req.result || null);
            req.onerror = () => reject(req.error);
          });
        } catch (e) {
          return null;
        }
      }

      // Tries to silently restore the previously selected folder in the
      // background without popping a native dialog (requestPermission on an
      // already-granted handle usually passes quietly in Chrome/Edge when the
      // page is on the same origin as when permission was first granted).
      (async function restoreProjectHandle() {
        const handle = await idbGetHandle();
        if (!handle) return;
        try {
          const perm = await handle.requestPermission({ mode: "readwrite" });
          if (perm !== "granted") return;
          projectDirHandle = handle;
          markProjectSelected();
          for (const k of Object.keys(authorAvatarCache)) delete authorAvatarCache[k];
          setStatus("Priečinok projektu automaticky obnovený, načítavam články...", "");
          await scanArticles();
          updatePreview();
        } catch (e) {
          // handle is no longer valid (e.g. folder moved/permission revoked), ignore it
        }
      })();

      async function openProjectAndScan() {
        try {
          projectDirHandle = await window.showDirectoryPicker();
		  markProjectSelected();
          await idbSetHandle(projectDirHandle);
          for (const k of Object.keys(authorAvatarCache)) delete authorAvatarCache[k];
          setStatus("Priečinok projektu vybraný, načítavam články...", "");
          await scanArticles();
          updatePreview();
        } catch (err) {
          if (err.name === "AbortError") return;
          setStatus("Chyba pri výbere priečinka: " + err.message, "err");
        }
      }

      async function scanArticles() {
        if (!projectDirHandle) {
          setStatus("Najprv vyber priečinok projektu.", "err");
          return;
        }
        const index = {};
        for (const lang of ["sk", "en"]) {
          let dir;
          try {
            dir = await ensureDir(projectDirHandle, [
              "src",
              "content",
              "articles",
              lang,
            ]);
          } catch (e) {
            continue;
          }
          for await (const [name, handle] of dir.entries()) {
            if (handle.kind !== "file" || !name.endsWith(".md")) continue;
            const id = name.replace(/\.md$/, "");
            try {
              const file = await handle.getFile();
              const text = await file.text();
              const parsed = parseArticleFile(text);
              if (!parsed) continue;
              if (!index[id]) index[id] = {};
              index[id][lang] = parsed;
            } catch (e) {
              // skip a file that can't be read/parsed
            }
          }
        }
        articlesIndex = index;
        renderArticleList();
        setStatus(
          "Načítaných " + Object.keys(index).length + " článok(ov).",
          "ok",
        );
      }

      function renderArticleList() {
        const container = $("#articleList");
        const ids = Object.keys(articlesIndex);
        if (ids.length === 0) {
          container.innerHTML =
            '<p class="hint">V projekte zatiaľ neboli nájdené žiadne články.</p>';
          return;
        }
        ids.sort((a, b) => {
          const da = (articlesIndex[a].sk || articlesIndex[a].en).date || "";
          const db = (articlesIndex[b].sk || articlesIndex[b].en).date || "";
          return db.localeCompare(da);
        });
        container.innerHTML = ids
          .map((id) => {
            const entry = articlesIndex[id];
            const d = entry.sk || entry.en;
            const title = d.title || "(bez názvu)";
            const badge = d.draft
              ? '<span class="badge draft">Draft</span>'
              : '<span class="badge published">Publikované</span>';
            const pinnedBadge = d.pinned
              ? '<span class="badge pinned">📌 Pripnuté</span>'
              : "";
            const langs = ["sk", "en"]
              .filter((l) => entry[l])
              .map((l) => l.toUpperCase())
              .join(" + ");
            return (
              '<div class="article-row">' +
              '<div class="article-info">' +
              "<strong>" +
              escapeHtml(title) +
              "</strong>" +
              badge +
              pinnedBadge +
              '<div class="hint">' +
              escapeHtml(id) +
              " • " +
              escapeHtml(d.date) +
              " • " +
              langs +
              "</div>" +
              "</div>" +
              '<div class="article-actions">' +
              '<button type="button" onclick="loadArticleIntoEditor(\'' +
              id +
              '\')">Upraviť</button>' +
              '<button type="button" onclick="toggleDraftVisibility(\'' +
              id +
              '\')">' +
              (d.draft ? "Zverejniť" : "Skryť") +
              "</button>" +
              '<button type="button" onclick="deleteArticle(\'' +
              id +
              '\')" style="background:color-mix(in srgb, var(--red) 15%, transparent);border-color:var(--red);color:var(--red)">Zmazať</button>' +
              "</div>" +
              "</div>"
            );
          })
          .join("");
      }

      function loadArticleIntoEditor(id) {
        const entry = articlesIndex[id];
        if (!entry) return;
		isEditingExisting = true;
        $("#articleId").value = id;
        for (const lang of ["sk", "en"]) {
          const d = entry[lang];
          document.querySelector('.title[data-lang="' + lang + '"]').value =
            d ? d.title : "";
          document.querySelector(
            '.description[data-lang="' + lang + '"]',
          ).value = d ? d.description : "";
          document.querySelector('.content[data-lang="' + lang + '"]').value =
            d ? d.body : "";
          document.querySelector(
            '.authorNote[data-lang="' + lang + '"]',
          ).value = d ? d.authorNote || "" : "";
          $("#tags-" + lang).value = d ? d.tags.join(", ") : "";
        }
        const primary = entry.sk || entry.en;
        $("#date").value = primary.date || todayISO();
        $("#author").value = primary.author || "boggelino";
        $("#draft").checked = !!primary.draft;
        $("#pinned").checked = !!primary.pinned;
        images.length = 0;
        renderImgList();
        switchTab("sk");
        setStatus(
          'Načítaný článok "' +
            id +
            '" na úpravu. Existujúce obrázky treba dovydávať ručne z priečinku, náhľad ich nezobrazí, ale v texte ostávajú funkčné odkazy. Po úprave použi "Uložiť priamo do projektu", pôvodné súbory sa prepíšu.',
          "ok",
        );
        $(".editor-scroll").scrollTo({ top: 0, behavior: "smooth" });
      }

      async function toggleDraftVisibility(id) {
        if (!projectDirHandle) {
          setStatus("Najprv vyber priečinok projektu.", "err");
          return;
        }
        const entry = articlesIndex[id];
        if (!entry) return;
        const current = entry.sk || entry.en;
        const newDraft = !current.draft;
        try {
          for (const lang of ["sk", "en"]) {
            if (!entry[lang]) continue;
            entry[lang].draft = newDraft;
            const dir = await ensureDir(projectDirHandle, [
              "src",
              "content",
              "articles",
              lang,
            ]);
            await writeFile(dir, id + ".md", rebuildFileFromData(entry[lang]));
          }
          setStatus(
            'Článok "' +
              id +
              '" je teraz ' +
              (newDraft ? "draft (skrytý)." : "publikovaný."),
            "ok",
          );
          renderArticleList();
        } catch (err) {
          setStatus("Chyba pri zmene viditeľnosti: " + err.message, "err");
        }
      }
	  
	  async function deleteArticle(id) {
  if (!projectDirHandle) {
    setStatus("Najprv vyber priečinok projektu.", "err");
    return;
  }
  const entry = articlesIndex[id];
  if (!entry) return;
  const d = entry.sk || entry.en;
  const confirmed = confirm(
    'Naozaj natrvalo zmazať článok "' +
      (d.title || id) +
      '" (ID: ' +
      id +
      ')? Zmažú sa SK aj EN súbor a celý priečinok s obrázkami. Toto sa nedá vrátiť späť.',
  );
  if (!confirmed) return;

  try {
    for (const lang of ["sk", "en"]) {
      if (!entry[lang]) continue;
      try {
        const dir = await ensureDir(projectDirHandle, [
          "src",
          "content",
          "articles",
          lang,
        ]);
        await dir.removeEntry(id + ".md");
      } catch (e) {
        // file for this language doesn't exist, skip it
      }
    }
    try {
      const imagesRootDir = await ensureDir(projectDirHandle, [
        "public",
        "images",
        "articles",
      ]);
      await imagesRootDir.removeEntry(id, { recursive: true });
    } catch (e) {
      // images folder didn't exist, nothing to do
    }

    delete articlesIndex[id];
    renderArticleList();
    setStatus('Článok "' + id + '" bol natrvalo zmazaný.', "ok");
  } catch (err) {
    setStatus("Chyba pri mazaní: " + err.message, "err");
  }
}

      async function startNewArticle() {
        await clearAll();
      }

      function setStatus(msg, kind) {
        const el = $("#status");
        el.textContent = msg;
        el.className = "status" + (kind ? " " + kind : "");
      }

      async function clearAll() {
        if (!confirm("Vyčistiť všetky polia a začať nový článok?")) return;
        $$(".title, .description, .content, .authorNote").forEach(
          (el) => (el.value = ""),
        );
        $("#articleId").value = await generateUniqueId();
        $("#tags-sk").value = "";
        $("#tags-en").value = "";
        $("#draft").checked = false;
        $("#pinned").checked = false;
        $("#date").value = todayISO();
		isEditingExisting = false;
        images.length = 0;
        renderImgList();
        updatePreview();
        setStatus("", "");
      }
    
</script>
