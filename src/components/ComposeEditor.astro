---
// src/components/ComposeEditor.astro
// Article editor, rendered inside a BaseLayout by src/pages/sk/compose.astro
// and src/pages/en/compose.astro. Chrome and Edge only for writing straight
// into the project: everything else falls back to downloading the files.
//
// The preview runs in an iframe that carries its own copy of the site's
// design tokens, so switching to the phone width triggers the real media
// queries instead of only narrowing a box.
---

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js" is:inline></script>

<div class="compose">
  <section class="editor">
    <div class="editor-scroll">
      <details class="panel" open>
        <summary class="panel-head">Articles in the project</summary>
        <div class="panel-body">
          <div class="btn-row">
            <button type="button" class="cbtn" id="openProjectBtn" onclick="openProjectAndScan()">
              Choose project folder
            </button>
            <button type="button" class="cbtn" id="scanArticlesBtn" onclick="scanArticles()">
              Refresh list
            </button>
            <button type="button" class="cbtn" onclick="startNewArticle()">New article</button>
          </div>
          <div id="articleList" class="article-list"></div>
        </div>
      </details>

      <section class="panel">
        <h2 class="panel-head">Shared fields</h2>
        <div class="panel-body">
          <div class="field-row">
            <label class="field">
              <span class="field-label">Article ID</span>
              <input type="text" id="articleId" class="cinput" placeholder="auto" />
            </label>
            <label class="field">
              <span class="field-label">Date</span>
              <input type="date" id="date" class="cinput" />
            </label>
            <label class="field">
              <span class="field-label">Author</span>
              <input type="text" id="author" class="cinput" value="boggelino" />
            </label>
          </div>

          <div class="check-row">
            <label class="check">
              <input type="checkbox" id="draft" />
              <span>Draft, hidden until you untick it</span>
            </label>
            <label class="check">
              <input type="checkbox" id="pinned" />
              <span>Pin to the top of the homepage</span>
            </label>
          </div>

          <label class="field">
            <span class="field-label">Images</span>
            <input type="file" id="imageInput" class="cinput cfile" accept="image/*" multiple />
          </label>
          <div id="imgList" class="img-list"></div>
        </div>
      </section>

      <div class="lang-tabs" id="langTabs">
        <button type="button" class="lang-tab is-active" data-lang="sk" onclick="switchTab('sk')">Slovak</button>
        <button type="button" class="lang-tab" data-lang="en" onclick="switchTab('en')">English</button>
      </div>

      <div id="panel-sk" class="lang-panel is-active">
        <label class="field">
          <span class="field-label">Title</span>
          <input type="text" class="cinput title" data-lang="sk" placeholder="Article title" />
        </label>
        <label class="field">
          <span class="field-label">Description</span>
          <input type="text" class="cinput description" data-lang="sk" placeholder="One sentence, shown on cards" />
        </label>
        <label class="field">
          <span class="field-label">Tags</span>
          <input type="text" class="cinput" id="tags-sk" placeholder="hry, recenzia (comma separated)" />
        </label>
        <div class="field">
          <span class="field-label">Body, Markdown</span>
          <div class="btn-row btn-row-tight">
            <button type="button" class="cbtn cbtn-sm" onclick="wrapSelection('sk', '**', '**')">Bold</button>
            <button type="button" class="cbtn cbtn-sm" onclick="wrapSelection('sk', '*', '*')">Italic</button>
            <button type="button" class="cbtn cbtn-sm" onclick="insertAtCursor('sk', '\n## Heading\n')">H2</button>
            <button type="button" class="cbtn cbtn-sm" onclick="insertAtCursor('sk', '\n### Subheading\n')">H3</button>
            <button type="button" class="cbtn cbtn-sm" onclick="insertAtCursor('sk', '\n> quote\n')">Quote</button>
            <button type="button" class="cbtn cbtn-sm" onclick="insertAtCursor('sk', '\n- item\n')">List</button>
          </div>
          <textarea class="cinput content" data-lang="sk" placeholder="Write in Slovak..."></textarea>
        </div>
        <label class="field">
          <span class="field-label">Author's note, optional</span>
          <textarea class="cinput authorNote" data-lang="sk" rows="2" placeholder="Shown next to the article in the side rail"></textarea>
        </label>
      </div>

      <div id="panel-en" class="lang-panel">
        <label class="field">
          <span class="field-label">Title</span>
          <input type="text" class="cinput title" data-lang="en" placeholder="Article title" />
        </label>
        <label class="field">
          <span class="field-label">Description</span>
          <input type="text" class="cinput description" data-lang="en" placeholder="One sentence, shown on cards" />
        </label>
        <label class="field">
          <span class="field-label">Tags</span>
          <input type="text" class="cinput" id="tags-en" placeholder="gaming, review (comma separated)" />
        </label>
        <div class="field">
          <span class="field-label">Body, Markdown</span>
          <div class="btn-row btn-row-tight">
            <button type="button" class="cbtn cbtn-sm" onclick="wrapSelection('en', '**', '**')">Bold</button>
            <button type="button" class="cbtn cbtn-sm" onclick="wrapSelection('en', '*', '*')">Italic</button>
            <button type="button" class="cbtn cbtn-sm" onclick="insertAtCursor('en', '\n## Heading\n')">H2</button>
            <button type="button" class="cbtn cbtn-sm" onclick="insertAtCursor('en', '\n### Subheading\n')">H3</button>
            <button type="button" class="cbtn cbtn-sm" onclick="insertAtCursor('en', '\n> quote\n')">Quote</button>
            <button type="button" class="cbtn cbtn-sm" onclick="insertAtCursor('en', '\n- item\n')">List</button>
          </div>
          <textarea class="cinput content" data-lang="en" placeholder="Write in English..."></textarea>
        </div>
        <label class="field">
          <span class="field-label">Author's note, optional</span>
          <textarea class="cinput authorNote" data-lang="en" rows="2" placeholder="Shown next to the article in the side rail"></textarea>
        </label>
      </div>
    </div>

    <div class="action-bar">
      <div class="btn-row">
        <button type="button" class="cbtn cbtn-primary" id="saveToProjectBtn" onclick="saveToProject()">
          Save into the project
        </button>
        <button type="button" class="cbtn" onclick="downloadAll()">Download .md files</button>
      </div>
      <p class="status" id="status"></p>
    </div>
  </section>

  <section class="preview-col">
    <div class="preview-bar">
      <div class="seg" role="group" aria-label="Preview">
        <button type="button" class="seg-btn is-active" data-mode="row" onclick="setPreviewMode('row')">Feed row</button>
        <button type="button" class="seg-btn" data-mode="hero" onclick="setPreviewMode('hero')">Hero</button>
        <button type="button" class="seg-btn" data-mode="article" onclick="setPreviewMode('article')">Article</button>
      </div>
      <div class="seg" role="group" aria-label="Width">
        <button type="button" class="seg-btn is-active" data-width="1920" onclick="setPreviewWidth(1920)">Desktop</button>
        <button type="button" class="seg-btn" data-width="390" onclick="setPreviewWidth(390)">Phone</button>
      </div>
      <button type="button" class="cbtn cbtn-sm" id="fullscreenBtn" onclick="toggleFullscreenPreview()">Expand</button>
    </div>
    <div class="preview-stage" id="previewStage">
      <div class="preview-wrap" id="previewWrap">
        <iframe id="previewFrame" title="Preview" sandbox="allow-same-origin"></iframe>
      </div>
    </div>
  </section>
</div>

<style is:global>
  /* ---------------------------------------------------------------
     Editor chrome. Same vocabulary as the site: 3px rules, no radius,
     mono labels, rust for the one action that matters.
     --------------------------------------------------------------- */
  .compose,
  .compose *,
  .compose *::before,
  .compose *::after {
    box-sizing: border-box;
  }

  /* Fixed writing column on the left, and a preview on the right that grows
     with the window up to the site's own maximum width. The pair is centred,
     so on an ultrawide the whole thing sits in the middle of the screen. */
  .compose {
    display: flex;
    align-items: stretch;
    justify-content: center;
    height: var(--compose-h, calc(100vh - 52px));
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .compose .editor {
    flex: 0 0 560px;
    width: 560px;
    display: flex;
    flex-direction: column;
    min-height: 0;
    border-right: var(--rule-w) solid var(--rule);
  }
  .compose .editor-scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
  }

  .compose .panel {
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .compose .panel-head {
    margin: 0;
    padding: 0.8rem 1rem;
    background: var(--bg-raised);
    border-bottom: var(--rule-w) solid var(--rule);
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: default;
  }
  .compose details.panel > summary.panel-head {
    cursor: pointer;
    list-style: none;
  }
  .compose details.panel > summary.panel-head::-webkit-details-marker {
    display: none;
  }
  .compose details.panel > summary.panel-head::after {
    content: ' \25B8';
    color: var(--accent);
    float: right;
  }
  .compose details.panel[open] > summary.panel-head::after {
    content: ' \25BE';
  }
  .compose .panel-body {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .compose .field {
    display: block;
    margin: 0 0 0.9rem 0;
  }
  .compose .panel-body .field {
    margin: 0;
  }
  .compose .field-label {
    display: block;
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.35rem;
  }
  .compose .field-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
  }

  .compose .cinput {
    width: 100%;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text);
    background: var(--bg);
    border: 2px solid var(--rule);
    border-radius: 0;
    padding: 0.6rem 0.7rem;
  }
  .compose textarea.cinput {
    min-height: 260px;
    resize: vertical;
    line-height: 1.6;
  }
  .compose textarea.authorNote {
    min-height: 0;
  }
  .compose .cinput::placeholder {
    color: var(--text-faint);
  }
  .compose .cfile {
    padding: 0.45rem;
  }

  .compose .check-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .compose .check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    color: var(--text-secondary);
    cursor: pointer;
  }
  .compose .check input {
    width: 16px;
    height: 16px;
    accent-color: var(--accent);
  }

  .compose .btn-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .compose .btn-row-tight {
    margin-bottom: 0.5rem;
  }
  .compose .cbtn {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text);
    background: var(--bg);
    border: 2px solid var(--rule);
    border-radius: 0;
    padding: 0.7rem 0.9rem;
    cursor: pointer;
  }
  .compose .cbtn:hover {
    background: var(--rule);
    color: var(--bg);
  }
  .compose .cbtn-sm {
    padding: 0.45rem 0.65rem;
    font-size: 0.62rem;
  }
  .compose .cbtn-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
    box-shadow: 4px 4px 0 var(--rule);
  }
  .compose .cbtn-primary:hover {
    background: var(--rule);
    border-color: var(--rule);
    color: var(--bg);
    box-shadow: 4px 4px 0 var(--accent);
  }
  .compose .cbtn[disabled] {
    color: var(--text-faint);
    border-color: var(--text-faint);
    background: var(--bg-raised-2);
    cursor: not-allowed;
    box-shadow: none;
  }

  .compose .lang-tabs {
    display: flex;
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .compose .lang-tab {
    flex: 1;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: var(--bg);
    border: none;
    border-right: var(--rule-w) solid var(--rule);
    padding: 0.85rem;
    cursor: pointer;
  }
  .compose .lang-tab:last-child {
    border-right: none;
  }
  .compose .lang-tab.is-active {
    background: var(--rule);
    color: var(--bg);
  }
  .compose .lang-panel {
    display: none;
    padding: 1rem;
  }
  .compose .lang-panel.is-active {
    display: block;
  }

  .compose .article-list {
    display: flex;
    flex-direction: column;
    border: 2px solid var(--rule);
  }
  .compose .article-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.5rem 0.8rem;
    padding: 0.7rem 0.8rem;
  }
  .compose .article-row + .article-row {
    border-top: 2px solid var(--border);
  }
  .compose .article-info strong {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.95rem;
    text-transform: uppercase;
    margin-right: 0.5rem;
  }
  .compose .article-meta {
    display: block;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }
  /* Two slots, so an unpinned article keeps the same shape as a pinned one
     and the rows stay aligned down the list. */
  .compose .article-badges {
    grid-column: 2;
    grid-row: 1;
    display: grid;
    grid-template-rows: 1fr 1fr;
    justify-items: end;
    gap: 0.3rem;
  }
  .compose .article-actions {
    grid-column: 1 / -1;
    grid-row: 2;
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .compose .badge {
    display: inline-block;
    white-space: nowrap;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border: 2px solid currentColor;
    padding: 0.15rem 0.4rem;
    vertical-align: middle;
  }
  .compose .badge.draft {
    color: var(--text-muted);
  }
  .compose .badge.published {
    color: var(--text);
  }
  .compose .badge.pinned {
    color: var(--accent);
  }
  .compose .hint {
    font-size: 0.68rem;
    color: var(--text-muted);
    padding: 0.7rem 0.8rem;
    margin: 0;
  }

  .compose .img-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .compose .img-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 2px solid var(--rule);
    padding: 0.25rem 0.45rem;
    font-size: 0.65rem;
  }
  .compose .img-chip img {
    width: 26px;
    height: 26px;
    object-fit: cover;
    display: block;
  }

  .compose .action-bar {
    flex-shrink: 0;
    padding: 0.9rem 1rem;
    border-top: var(--rule-w) solid var(--rule);
    background: var(--bg-raised);
  }
  .compose .status {
    margin: 0.7rem 0 0 0;
    font-size: 0.7rem;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .compose .status.ok {
    color: var(--text);
    border-left: 4px solid var(--accent);
    padding-left: 0.6rem;
  }
  .compose .status.err {
    color: var(--accent);
    font-weight: 700;
  }

  /* ---------------- preview ---------------- */

  .compose .preview-col {
    flex: 1 1 auto;
    min-width: 0;
    max-width: var(--shell);
    transition: max-width 0.12s ease;
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: var(--bg-raised-2);
  }
  /* The panel hugs the phone viewport instead of leaving a wide empty field. */
  .compose .preview-col.is-phone {
    max-width: 428px;
  }
  .compose .preview-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    padding: 0.7rem 1rem;
    background: var(--bg);
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .compose .seg {
    display: flex;
    border: 2px solid var(--rule);
  }
  .compose .seg-btn {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: var(--bg);
    border: none;
    border-right: 2px solid var(--rule);
    padding: 0.5rem 0.7rem;
    cursor: pointer;
  }
  .compose .seg-btn:last-child {
    border-right: none;
  }
  .compose .seg-btn.is-active {
    background: var(--accent);
    color: var(--on-accent);
  }
  .compose #fullscreenBtn {
    margin-left: auto;
  }

  .compose .preview-stage {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    padding: 0.8rem;
  }
  /* The frame is scaled, so the wrapper carries the size the scaled result
     actually occupies. Without it the transform spills out and the panel
     grows scrollbars it does not need. */
  .compose .preview-wrap {
    position: relative;
    margin: 0 auto;
    overflow: hidden;
  }
  .compose .preview-stage iframe {
    display: block;
    border: var(--rule-w) solid var(--rule);
    background: var(--bg);
    transform-origin: top left;
  }

  /* Expanded: the panel takes the whole screen, so every width cap has to
     come off, including the narrow one the phone preview uses. */
  .compose .preview-col.is-fullscreen {
    position: fixed;
    inset: 0;
    z-index: 9999;
    max-width: none;
    background: var(--bg-raised-2);
  }
  body.preview-locked {
    overflow: hidden;
  }

  @media (max-width: 1100px) {
    .compose {
      flex-direction: column;
      height: auto;
    }
    .compose .editor {
      flex: 1 1 auto;
      width: auto;
    }
    .compose .preview-col {
      max-width: none;
    }
    .compose .editor {
      border-right: none;
    }
    .compose .editor-scroll {
      overflow: visible;
    }
    .compose .preview-col {
      border-top: var(--rule-w) solid var(--rule);
      min-height: 70vh;
    }
    .compose .field-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  const $ = (sel) => document.querySelector(sel);
  const $$ = (sel) => document.querySelectorAll(sel);

  let activeLang = "sk";
  let projectDirHandle = null;
  let articlesIndex = {};
  let isEditingExisting = false;
  let previewMode = "row";
  let previewWidth = 1920;

  const images = [];

  function todayISO() {
    return new Date().toISOString().slice(0, 10);
  }
  $("#date").value = todayISO();

  // Six digit ID, checked against the project folder when one is open so two
  // articles can never collide.
  async function generateUniqueId() {
    const randId = () => String(Math.floor(Math.random() * 1000000)).padStart(6, "0");
    if (!projectDirHandle) return randId();
    try {
      const articlesDir = await ensureDir(projectDirHandle, ["src", "content", "articles", "sk"]);
      let newId;
      let exists = true;
      let attempts = 0;
      while (exists && attempts < 100) {
        newId = randId();
        try {
          await articlesDir.getFileHandle(newId + ".md");
          attempts++;
        } catch (err) {
          exists = false;
        }
      }
      return newId;
    } catch (e) {
      return randId();
    }
  }

  (async () => {
    if (!$("#articleId").value) $("#articleId").value = await generateUniqueId();
  })();

  function switchTab(lang) {
    activeLang = lang;
    $$(".lang-tab").forEach((b) => b.classList.toggle("is-active", b.dataset.lang === lang));
    $$(".lang-panel").forEach((p) => p.classList.toggle("is-active", p.id === "panel-" + lang));
    updatePreview();
  }

  function activeContentEl() {
    return document.querySelector('.content[data-lang="' + activeLang + '"]');
  }

  function setPreviewMode(mode) {
    previewMode = mode;
    $$(".seg-btn[data-mode]").forEach((b) => b.classList.toggle("is-active", b.dataset.mode === mode));
    updatePreview();
  }

  function setPreviewWidth(width) {
    previewWidth = width;
    document.querySelector(".preview-col").classList.toggle("is-phone", width <= 600);
    $$(".seg-btn[data-width]").forEach((b) =>
      b.classList.toggle("is-active", Number(b.dataset.width) === width),
    );
    updatePreview();
  }

  // Uploaded images only exist as blobs until the article is saved, so any
  // reference to their final path is swapped for the blob URL in the preview.
  function resolveImageUrl(src) {
    if (!src) return src;
    let resolved = src;
    images.forEach((img) => {
      const escaped = img.name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      const re = new RegExp("/images/articles/[^\"')\\s]*" + escaped + "$");
      if (re.test(resolved)) resolved = img.url;
    });
    return resolved;
  }

  // Mirrors src/utils/extract-image.ts: the first markdown image becomes the
  // cover on cards and at the top of the article.
  function extractFirstImage(md) {
    const match = md.match(/!\[[^\]]*\]\(([^)\s]+)/);
    return match ? resolveImageUrl(match[1]) : undefined;
  }

  const authorAvatarCache = {};

  function getAuthorAvatarUrl(author) {
    const key = (author || "").toLowerCase();
    if (!key) return "https://boggelino.netlify.app/images/boggelino.png";
    if (authorAvatarCache[key]) return authorAvatarCache[key];
    authorAvatarCache[key] = "https://boggelino.netlify.app/images/" + key + ".png";
    loadAuthorAvatarFromProject(key);
    return authorAvatarCache[key];
  }

  // Looks for public/images/<author>.<ext> in the open project. Read only.
  async function loadAuthorAvatarFromProject(key) {
    if (!projectDirHandle) return;
    try {
      const imagesDir = await projectDirHandle
        .getDirectoryHandle("public")
        .then((d) => d.getDirectoryHandle("images"));
      const exts = ["png", "jpg", "jpeg", "webp", "gif"];
      let fileHandle = null;
      for (const ext of exts) {
        try {
          fileHandle = await imagesDir.getFileHandle(key + "." + ext);
          break;
        } catch (e) {
          /* try the next extension */
        }
      }
      if (!fileHandle) {
        for await (const [name, handle] of imagesDir.entries()) {
          if (handle.kind !== "file") continue;
          if (name.replace(/\.[^.]+$/, "").toLowerCase() === key) {
            fileHandle = handle;
            break;
          }
        }
      }
      if (!fileHandle) return;
      const file = await fileHandle.getFile();
      authorAvatarCache[key] = URL.createObjectURL(file);
      updatePreview();
    } catch (e) {
      // No public/images folder, keep the remote fallback
    }
  }

  function formatDate(dateStr, lang, style) {
    const d = dateStr ? new Date(dateStr + "T00:00:00") : new Date();
    if (isNaN(d.getTime())) return dateStr || "";
    const locale = lang === "sk" ? "sk-SK" : "en-GB";
    const opts =
      style === "long"
        ? { day: "2-digit", month: "2-digit", year: "numeric" }
        : { day: "2-digit", month: "2-digit", year: "numeric" };
    return d.toLocaleDateString(locale, opts);
  }

  function countWords(md) {
    const text = (md || "")
      .replace(/```[\s\S]*?```/g, " ")
      .replace(/!\[[^\]]*\]\([^)]*\)/g, " ")
      .replace(/[#>*_`\-]/g, " ");
    const words = text.split(/\s+/).filter(Boolean);
    return words.length;
  }

  function readingTime(md) {
    return Math.max(1, Math.round(countWords(md) / 200));
  }

  function currentFormData() {
    const lang = activeLang;
    const title =
      document.querySelector('.title[data-lang="' + lang + '"]').value ||
      (lang === "sk" ? "Bez názvu" : "Untitled");
    const description = document.querySelector('.description[data-lang="' + lang + '"]').value;
    const md = activeContentEl().value;
    const date = $("#date").value;
    const author = ($("#author").value.trim() || "boggelino").toLowerCase();
    const authorNote = (
      document.querySelector('.authorNote[data-lang="' + lang + '"]')?.value || ""
    ).trim();
    const tags = $("#tags-" + lang)
      .value.split(",")
      .map((t) => t.trim())
      .filter(Boolean);
    const pinned = $("#pinned").checked;
    return { lang, title, description, md, date, author, tags, authorNote, pinned };
  }

  /* ---------------------------------------------------------------
     Preview. The iframe carries its own copy of the design tokens and
     the component rules, so the phone width triggers the same media
     queries the live site uses.
     --------------------------------------------------------------- */

  const PREVIEW_CSS = `
