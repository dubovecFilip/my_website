  `;

  function placeholderSvg(seed) {
    let hash = 0;
    for (const ch of seed || "") hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;
    const angle = [45, -45, 90][hash % 3];
    const id = "ph" + (hash % 100000).toString(36);
    return `<svg viewBox="0 0 400 260" preserveAspectRatio="xMidYMid slice"
        style="position:absolute;inset:0;width:100%;height:100%">
        <defs><pattern id="${id}" width="24" height="24" patternUnits="userSpaceOnUse"
          patternTransform="rotate(${angle})">
          <rect width="24" height="24" fill="var(--bg-raised-2)"></rect>
          <rect width="12" height="24" fill="var(--bg-raised)"></rect>
        </pattern></defs>
        <rect width="400" height="260" fill="url(#${id})"></rect>
        <g transform="translate(152 82)">
          <rect width="96" height="96" fill="var(--rule)"></rect>
          <text x="40" y="67" text-anchor="middle" fill="var(--bg)"
            style="font-family:var(--font-display);font-weight:900;font-size:56px">M</text>
          <rect x="60" y="56" width="21" height="10" fill="var(--accent)"></rect>
        </g>
      </svg>`;
  }

  function tagsHtml(tags, cls) {
    if (!tags.length) return "";
    return tags.map((t) => `<span class="${cls}">${escapeHtml(t)}</span>`).join("");
  }

  const DUMMY = {
    sk: [
      { title: "SIMT Simulator", description: "Ukážkový záznam, aby si videl, ako riadok sedí medzi ostatnými.", date: "2026-07-30", tags: ["hry", "recenzia"], body: "" },
      { title: "Ahoj, svet", description: "Druhý ukážkový záznam. Nahradí sa skutočnými článkami, keď otvoríš priečinok projektu.", date: "2026-07-29", tags: ["meta"], body: "" },
    ],
    en: [
      { title: "SIMT Simulator", description: "A stand-in entry, so you can see how the row sits among the others.", date: "2026-07-30", tags: ["gaming", "review"], body: "" },
      { title: "Hello, world", description: "A second stand-in. These are replaced by real articles once you open the project folder.", date: "2026-07-29", tags: ["meta"], body: "" },
    ],
  };

  // Neighbours for the preview: the other articles in the project when one is
  // open, otherwise the stand-ins above.
  function contextEntries(d, limit) {
    const currentId = $("#articleId").value.trim();
    const fromProject = Object.keys(articlesIndex)
      .filter((id) => id !== currentId)
      .map((id) => articlesIndex[id][d.lang] || articlesIndex[id].sk || articlesIndex[id].en)
      .filter(Boolean)
      .sort((a, b) => (b.date || "").localeCompare(a.date || ""))
      .slice(0, limit);
    if (fromProject.length) return fromProject.map((e) => ({ entry: e, dummy: false }));
    return DUMMY[d.lang].slice(0, limit).map((e) => ({ entry: e, dummy: true }));
  }

  function rowHtml(entry, index, lang, dummy) {
    const image = entry.body ? extractFirstImage(entry.body) : undefined;
    const thumb = image ? `<img src="${escapeHtml(image)}" alt="" />` : placeholderSvg(entry.title);
    const minutes = readingTime(entry.body || entry.description || "");
    const readLabel = lang === "sk" ? minutes + " min čítania" : minutes + " min read";
    return `
      <a class="row${dummy ? " is-dummy" : ""}">
        <span class="row-index">${String(index).padStart(2, "0")}</span>
        <span class="row-thumb">${thumb}</span>
        <span class="row-body">
          <span class="row-title">${escapeHtml(entry.title || "")}</span>
          <span class="row-desc">${escapeHtml(entry.description || "")}</span>
          <span class="row-tags">${tagsHtml(entry.tags || [], "tag tag-sm")}</span>
          <span class="row-meta-inline">${escapeHtml(formatDate(entry.date, lang))} &middot; ${readLabel}</span>
        </span>
        <span class="row-meta">
          <span>${escapeHtml(formatDate(entry.date, lang))}</span>
          <span>${readLabel}</span>
        </span>
      </a>`;
  }

  function compactHtml(entry, lang, dummy) {
    const image = entry.body ? extractFirstImage(entry.body) : undefined;
    const thumb = image ? `<img src="${escapeHtml(image)}" alt="" />` : placeholderSvg(entry.title);
    const minutes = readingTime(entry.body || entry.description || "");
    const readLabel = lang === "sk" ? minutes + " min čítania" : minutes + " min read";
    return `
      <a class="compact${dummy ? " is-dummy" : ""}">
        <span class="compact-thumb">${thumb}</span>
        <span class="compact-body">
          <span class="compact-meta">${escapeHtml(formatDate(entry.date, lang))} &middot; ${readLabel}</span>
          <span class="compact-title">${escapeHtml(entry.title || "")}</span>
          <span class="compact-desc">${escapeHtml(entry.description || "")}</span>
        </span>
      </a>`;
  }

  function renderRowPreview(d) {
    const current = { title: d.title, description: d.description, date: d.date, tags: d.tags, body: d.md };
    const neighbours = contextEntries(d, 2);
    const archiveLabel = d.lang === "sk" ? "Archív" : "Archive";
    const allLabel = d.lang === "sk" ? "Zobraziť všetko" : "View all";
    const count = String(neighbours.length + 1).padStart(2, "0");
    return `
      <div class="band">
        <h2 class="band-title">${archiveLabel} / ${count}</h2>
        <span class="band-link">${allLabel} &#9656;</span>
      </div>
      <div class="feed">
        ${rowHtml(current, 1, d.lang, false)}
        ${neighbours.map((n, i) => rowHtml(n.entry, i + 2, d.lang, n.dummy)).join("")}
      </div>`;
  }

  function renderHeroPreview(d) {
    const image = extractFirstImage(d.md);
    const art = image ? `<img src="${escapeHtml(image)}" alt="" />` : placeholderSvg(d.title);
    const minutes = readingTime(d.md);
    const badge = d.pinned
      ? d.lang === "sk" ? "Pripnutý článok" : "Pinned post"
      : d.lang === "sk" ? "Najnovší článok" : "Latest post";
    const cta = d.lang === "sk" ? "Čítať článok" : "Read article";
    return `
      <section class="hero">
        <div class="hero-text">
          <div class="hero-kicker">
            <span class="hero-badge">${badge}</span>
            <span class="hero-meta">${escapeHtml(formatDate(d.date, d.lang))} / ${minutes} MIN</span>
          </div>
          <h1 class="hero-title">${escapeHtml(d.title)}</h1>
          <p class="hero-desc">${escapeHtml(d.description || "")}</p>
          <div class="hero-tags">${tagsHtml(d.tags, "tag")}</div>
          <span class="btn">${cta} &#9656;</span>
        </div>
        <div class="hero-art">${art}</div>
      </section>
      <div class="band">
        <h2 class="band-title">${d.lang === "sk" ? "Archív" : "Archive"} / ${String(
          contextEntries(d, 2).length,
        ).padStart(2, "0")}</h2>
      </div>
      <div class="feed">
        ${contextEntries(d, 2)
          .map((n, i) => rowHtml(n.entry, i + 1, d.lang, n.dummy))
          .join("")}
      </div>`;
  }

  // Minimal stand-in for marked: headings, quotes, lists, images, bold and
  // italic. Only used when the CDN copy of marked did not load.
  function fallbackMarkdown(md) {
    const blocks = (md || "").split(/\n{2,}/);
    return blocks
      .map((block) => {
        const text = block.trim();
        if (!text) return "";
        const inline = (t) =>
          escapeHtml(t)
            .replace(/!\[([^\]]*)\]\(([^)\s]+)\)/g, '<img src="$2" alt="$1" />')
            .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
            .replace(/\*([^*]+)\*/g, "<em>$1</em>");
        if (/^###\s/.test(text)) return "<h3>" + inline(text.replace(/^###\s/, "")) + "</h3>";
        if (/^##\s/.test(text)) return "<h2>" + inline(text.replace(/^##\s/, "")) + "</h2>";
        if (/^>\s?/.test(text))
          return "<blockquote><p>" + inline(text.replace(/^>\s?/gm, "")) + "</p></blockquote>";
        if (/^[-*]\s/.test(text)) {
          const items = text
            .split("\n")
            .map((line) => "<li>" + inline(line.replace(/^[-*]\s/, "")) + "</li>")
            .join("");
          return "<ul>" + items + "</ul>";
        }
        return "<p>" + inline(text) + "</p>";
      })
      .join("");
  }

  function renderArticlePreview(d) {
    let html = window.marked ? marked.parse(d.md || "") : fallbackMarkdown(d.md);
    images.forEach((img) => {
      const escaped = img.name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      const re = new RegExp("([\"'(])(/images/articles/[^\"')]*" + escaped + ")([\"')])", "g");
      html = html.replace(re, "$1" + img.url + "$3");
    });

    const cover = extractFirstImage(d.md);
    const words = countWords(d.md);
    const minutes = readingTime(d.md);
    const imageCount = (d.md.match(/!\[[^\]]*\]\(/g) || []).length;
    const headingCount = (d.md.match(/^#{2,3}\s/gm) || []).length;
    const labels =
      d.lang === "sk"
        ? { words: "Slová", time: "Čas čítania", images: "Obrázky", headings: "Nadpisy", note: "Poznámka autora", published: "Publikované", read: "min čítania" }
        : { words: "Words", time: "Reading time", images: "Images", headings: "Headings", note: "Author's note", published: "Published", read: "min read" };
    const avatar = getAuthorAvatarUrl(d.author);
    const coverHtml = cover
      ? `<div class="article-cover"><img src="${escapeHtml(cover)}" alt="" /></div>`
      : `<div class="article-cover" style="position:relative;height:260px">${placeholderSvg(d.title)}</div>`;

    return `
      <header class="article-header">
        <div class="header-text">
          <div class="header-kicker">
            ${d.tags[0] ? `<span class="header-badge">${escapeHtml(d.tags[0])}</span>` : ""}
            <span class="header-meta">${labels.published} ${escapeHtml(formatDate(d.date, d.lang))} &middot; ${minutes} ${labels.read}</span>
          </div>
          <h1 class="header-title">${escapeHtml(d.title)}</h1>
          <p class="header-desc">${escapeHtml(d.description || "")}</p>
          <div class="header-tags">${tagsHtml(d.tags, "tag")}</div>
        </div>
        <dl class="stats">
          <div class="stat"><dt>${labels.words}</dt><dd>${words}</dd></div>
          <div class="stat"><dt>${labels.time}</dt><dd class="is-accent">${minutes} min</dd></div>
          <div class="stat"><dt>${labels.images}</dt><dd>${imageCount}</dd></div>
          <div class="stat"><dt>${labels.headings}</dt><dd>${headingCount}</dd></div>
        </dl>
      </header>
      ${coverHtml}
      <div class="article-main">
        <div class="article-body">${html}</div>
        ${
          d.authorNote
            ? `<aside class="author-note">
                 <img src="${avatar}" alt="" />
                 <div>
                   <span class="author-note-title">${labels.note}</span>
                   <p class="author-note-text">${escapeHtml(d.authorNote)}</p>
                 </div>
               </aside>`
            : ""
        }
      </div>
      <div class="band">
        <h2 class="band-title">${d.lang === "sk" ? "Súvisiace články" : "Related articles"}</h2>
      </div>
      <div class="related-grid">
        ${contextEntries(d, 2)
          .map((n) => compactHtml(n.entry, d.lang, n.dummy))
          .join("")}
      </div>`;
  }

  function previewFrameRoot() {
    const frame = $("#previewFrame");
    const doc = frame.contentDocument;
    if (!doc) return null;
    if (!doc.getElementById("root")) {
      doc.open();
      doc.write(
        '<!doctype html><html><head><meta charset="utf-8">' +
          '<meta name="viewport" content="width=device-width, initial-scale=1">' +
          "<style>" + PREVIEW_CSS + "</style></head><body><div id=\"root\"></div></body></html>",
      );
      doc.close();
    }
    return doc.getElementById("root");
  }

  // The frame is sized to the chosen viewport and then scaled down to fit the
  // panel, so a phone preview is a real 390px viewport rather than a squeeze.
  function fitPreviewFrame() {
    const stage = $("#previewStage");
    const wrap = $("#previewWrap");
    const frame = $("#previewFrame");
    const available = stage.clientWidth - 26;
    const availableHeight = stage.clientHeight - 26;

    // The desktop preview is a real browser window the width of the panel,
    // capped at the site's own maximum, so narrowing the window reflows the
    // layout instead of shrinking a picture of it. The phone stays 390.
    const isPhone = previewWidth <= 600;
    const targetWidth = isPhone ? previewWidth : Math.min(previewWidth, Math.max(360, available));
    const scale = Math.min(1, available / targetWidth);
    const frameHeight = Math.max(600, availableHeight / scale);

    frame.style.width = targetWidth + "px";
    frame.style.height = frameHeight + "px";
    frame.style.transform = "scale(" + scale + ")";
    wrap.style.width = targetWidth * scale + "px";
    wrap.style.height = Math.min(availableHeight, frameHeight * scale) + "px";
  }

  function updatePreview() {
    const root = previewFrameRoot();
    if (!root) return;
    const doc = root.ownerDocument;
    const theme = document.documentElement.getAttribute("data-theme");
    if (theme) doc.documentElement.setAttribute("data-theme", theme);
    else doc.documentElement.removeAttribute("data-theme");

    const d = currentFormData();
    if (previewMode === "row") root.innerHTML = renderRowPreview(d);
    else if (previewMode === "hero") root.innerHTML = renderHeroPreview(d);
    else root.innerHTML = renderArticlePreview(d);
    fitPreviewFrame();
  }

  function toggleFullscreenPreview() {
    const col = document.querySelector(".preview-col");
    const isFullscreen = col.classList.toggle("is-fullscreen");
    document.body.classList.toggle("preview-locked", isFullscreen);
    $("#fullscreenBtn").textContent = isFullscreen ? "Collapse" : "Expand";
    requestAnimationFrame(fitPreviewFrame);
  }

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && document.querySelector(".preview-col.is-fullscreen")) {
      toggleFullscreenPreview();
    }
  });

  // The header is the only thing above the editor, so its real height decides
  // how tall the tool is. Measured rather than guessed, so nothing overflows
  // into a second scrollbar.
  function fitComposeHeight() {
    const header = document.querySelector(".site-header");
    const headerHeight = header ? header.getBoundingClientRect().height : 52;
    document.querySelector(".compose").style.setProperty(
      "--compose-h",
      window.innerHeight - headerHeight + "px",
    );
    fitPreviewFrame();
  }

  // The theme toggle lives in the header, so the preview watches the root
  // element rather than waiting for the next keystroke to notice.
  new MutationObserver(updatePreview).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });

  window.addEventListener("resize", fitComposeHeight);
  window.addEventListener("load", fitComposeHeight);
  fitComposeHeight();
  window.addEventListener("load", updatePreview);
  $$("input, textarea, select").forEach((el) => el.addEventListener("input", updatePreview));
  updatePreview();

  /* ---------------- editing helpers ---------------- */

  function insertAtCursor(lang, text) {
    const ta = document.querySelector('.content[data-lang="' + lang + '"]');
    const start = ta.selectionStart;
    const end = ta.selectionEnd;
    ta.value = ta.value.slice(0, start) + text + ta.value.slice(end);
    ta.focus();
    ta.selectionStart = ta.selectionEnd = start + text.length;
    updatePreview();
  }

  function wrapSelection(lang, before, after) {
    const ta = document.querySelector('.content[data-lang="' + lang + '"]');
    const start = ta.selectionStart;
    const end = ta.selectionEnd;
    const selected = ta.value.slice(start, end) || "text";
    ta.value = ta.value.slice(0, start) + before + selected + after + ta.value.slice(end);
    ta.focus();
    updatePreview();
  }

  $("#imageInput").addEventListener("change", (e) => {
    const files = Array.from(e.target.files);
    const id = $("#articleId").value.trim() || "ID";
    files.forEach((file) => {
      const originalExt = file.name.includes(".") ? file.name.slice(file.name.lastIndexOf(".")) : "";
      let newName = prompt("File name for this image:", file.name);
      if (newName === null) return;
      newName = newName.trim();
      if (!newName) newName = file.name;
      if (!newName.includes(".") && originalExt) newName += originalExt;

      const url = URL.createObjectURL(file);
      images.push({ name: newName, file, url });
      insertAtCursor(activeLang, "\n![image caption](/images/articles/" + id + "/" + newName + ")\n");
    });
    renderImgList();
    e.target.value = "";
  });

  function renderImgList() {
    const id = $("#articleId").value.trim() || "ID";
    $("#imgList").innerHTML =
      images
        .map(
          (img) =>
            '<span class="img-chip"><img src="' + img.url + '" alt="" />' + escapeHtml(img.name) + "</span>",
        )
        .join("") +
      (images.length
        ? '<p class="hint" style="width:100%">Saved to public/images/articles/' + id + "/</p>"
        : "");
  }

  function escapeYamlString(value) {
    return String(value).replace(/\\/g, "\\\\").replace(/"/g, '\\"').replace(/\n/g, "\\n");
  }

  function unescapeYamlString(value) {
    return String(value).replace(/\\n/g, "\n").replace(/\\"/g, '"').replace(/\\\\/g, "\\");
  }

  function buildFrontmatter(lang) {
    const title = document.querySelector('.title[data-lang="' + lang + '"]').value || "Untitled";
    const description = document.querySelector('.description[data-lang="' + lang + '"]').value || "";
    const authorNote = (
      document.querySelector('.authorNote[data-lang="' + lang + '"]')?.value || ""
    ).trim();
    const date = $("#date").value || todayISO();
    const author = $("#author").value.trim() || "boggelino";
    const tags = $("#tags-" + lang)
      .value.split(",")
      .map((t) => t.trim())
      .filter(Boolean);
    const draft = $("#draft").checked;
    const pinned = $("#pinned").checked;

    let fm = "---\n";
    fm += 'title: "' + title.replace(/"/g, '\\"') + '"\n';
    fm += 'description: "' + description.replace(/"/g, '\\"') + '"\n';
    fm += "date: " + date + "\n";
    fm += "tags: [" + tags.map((t) => '"' + t + '"').join(", ") + "]\n";
    fm += 'author: "' + author + '"\n';
    if (draft) fm += "draft: true\n";
    if (pinned) fm += "pinned: true\n";
    if (authorNote) fm += 'authorNote: "' + escapeYamlString(authorNote) + '"\n';
    fm += "---\n\n";
    return fm;
  }

  function fullFileFor(lang) {
    const content = document.querySelector('.content[data-lang="' + lang + '"]').value.trim();
    return buildFrontmatter(lang) + content + "\n";
  }

  function hasContent(lang) {
    return (
      document.querySelector('.content[data-lang="' + lang + '"]').value.trim().length > 0 ||
      document.querySelector('.title[data-lang="' + lang + '"]').value.trim().length > 0
    );
  }

  function downloadAll() {
    const id = $("#articleId").value.trim();
    if (!id) {
      setStatus("Fill in the article ID first, it becomes the file name.", "err");
      return;
    }
    let count = 0;
    ["sk", "en"].forEach((lang) => {
      if (!hasContent(lang)) return;
      const blob = new Blob([fullFileFor(lang)], { type: "text/markdown" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = id + ".md";
      a.click();
      count++;
    });
    if (count === 0) {
      setStatus("Nothing to download, both language versions are empty.", "err");
      return;
    }
    setStatus(
      "Downloaded " +
        count +
        " file(s). Move them to src/content/articles/<lang>/" +
        id +
        ".md and any images to public/images/articles/" +
        id +
        "/." +
        ($("#pinned").checked
          ? " Note: downloading does not unpin the previous pinned article, remove that line by hand."
          : ""),
      "ok",
    );
  }

  const supportsFS = "showDirectoryPicker" in window;
  if (!supportsFS) {
    $("#saveToProjectBtn").disabled = true;
    $("#saveToProjectBtn").title = "Chrome and Edge only. Use the download button instead.";
    $("#openProjectBtn").disabled = true;
    $("#scanArticlesBtn").disabled = true;
    $("#articleList").innerHTML =
      '<p class="hint">Managing articles needs file access, which only Chrome and Edge support. Writing and downloading works everywhere.</p>';
  }

  async function ensureDir(parent, parts) {
    let dir = parent;
    for (const part of parts) {
      dir = await dir.getDirectoryHandle(part, { create: true });
    }
    return dir;
  }

  async function writeFile(dirHandle, name, contents) {
    const fileHandle = await dirHandle.getFileHandle(name, { create: true });
    const writable = await fileHandle.createWritable();
    await writable.write(contents);
    await writable.close();
  }

  // Strips "pinned: true" from every other article, so only one can be pinned.
  async function unpinOtherArticles(currentId) {
    const unpinnedIds = [];
    for (const otherId of Object.keys(articlesIndex)) {
      if (otherId === currentId) continue;
      const entry = articlesIndex[otherId];
      let changed = false;
      for (const lang of ["sk", "en"]) {
        if (entry[lang] && entry[lang].pinned) {
          entry[lang].pinned = false;
          const dir = await ensureDir(projectDirHandle, ["src", "content", "articles", lang]);
          await writeFile(dir, otherId + ".md", rebuildFileFromData(entry[lang]));
          changed = true;
        }
      }
      if (changed) unpinnedIds.push(otherId);
    }
    return unpinnedIds;
  }

  async function saveToProject() {
    const id = $("#articleId").value.trim();
    if (!id) {
      setStatus("Fill in the article ID first.", "err");
      return;
    }
    try {
      if (!projectDirHandle) {
        setStatus("Pick the project root, the folder that holds package.json...", "");
        projectDirHandle = await window.showDirectoryPicker();
        markProjectSelected();
        await idbSetHandle(projectDirHandle);
      }
      const wrote = [];
      for (const lang of ["sk", "en"]) {
        if (!hasContent(lang)) continue;
        const articlesDir = await ensureDir(projectDirHandle, ["src", "content", "articles", lang]);
        await writeFile(articlesDir, id + ".md", fullFileFor(lang));
        wrote.push("src/content/articles/" + lang + "/" + id + ".md");
      }
      if (images.length > 0) {
        const imgDir = await ensureDir(projectDirHandle, ["public", "images", "articles", id]);
        for (const img of images) {
          await writeFile(imgDir, img.name, img.file);
        }
        wrote.push("public/images/articles/" + id + "/ (" + images.length + " image(s))");
      }
      if (wrote.length === 0) {
        setStatus("Nothing to save, fill in at least one language.", "err");
        return;
      }
      let unpinned = [];
      if ($("#pinned").checked) unpinned = await unpinOtherArticles(id);
      if (projectDirHandle) await scanArticles();
      const commitMsg = buildCommitMessage();
      try {
        await navigator.clipboard.writeText(commitMsg);
      } catch (e) {
        /* clipboard denied, the message is still in the status line */
      }
      setStatus(
        "Saved: " +
          wrote.join(", ") +
          (unpinned.length ? ". Unpinned: " + unpinned.join(", ") + "." : "") +
          ". Commit message copied: " +
          commitMsg,
        "ok",
      );
    } catch (err) {
      if (err.name === "AbortError") {
        setStatus("Cancelled.", "");
        return;
      }
      setStatus("Could not save: " + err.message, "err");
    }
  }

  function buildCommitMessage() {
    const skTitle = document.querySelector('.title[data-lang="sk"]').value;
    const enTitle = document.querySelector('.title[data-lang="en"]').value;
    const title = skTitle || enTitle || $("#articleId").value.trim();
    const langs = ["sk", "en"].filter((l) => hasContent(l));
    const langSuffix = langs.length === 2 ? " (SK + EN)" : "";
    const prefix = isEditingExisting ? "Article edited" : "New article";
    return prefix + ": " + title + langSuffix;
  }

  function escapeHtml(s) {
    return String(s).replace(
      /[&<>"']/g,
      (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c],
    );
  }

  function parseArticleFile(text) {
    text = text.replace(/^\uFEFF/, "").replace(/\r\n/g, "\n");
    const match = text.match(/^---\n([\s\S]*?)\n---\n\n?([\s\S]*)$/);
    if (!match) return null;
    const fm = match[1];
    const body = match[2].replace(/\n+$/, "");
    const getField = (key) => {
      const m = fm.match(new RegExp("^" + key + ':\\s*"(.*)"\\s*$', "m"));
      if (m) return m[1].replace(/\\"/g, '"');
      const m2 = fm.match(new RegExp("^" + key + ":\\s*(.*)$", "m"));
      return m2 ? m2[1].trim() : "";
    };
    const tagsMatch = fm.match(/^tags:\s*\[(.*?)\]\s*$/m);
    const tags = tagsMatch
      ? tagsMatch[1]
          .split(",")
          .map((t) => t.trim().replace(/^"|"$/g, ""))
          .filter(Boolean)
      : [];
    const draft = /^draft:\s*true\s*$/m.test(fm);
    const pinned = /^pinned:\s*true\s*$/m.test(fm);
    const authorNoteMatch = fm.match(/^authorNote:\s*"(.*)"\s*$/m);
    const authorNote = authorNoteMatch ? unescapeYamlString(authorNoteMatch[1]) : "";
    return {
      title: getField("title"),
      description: getField("description"),
      date: getField("date"),
      author: getField("author") || "boggelino",
      tags,
      draft,
      pinned,
      authorNote,
      body,
    };
  }

  function rebuildFileFromData(d) {
    let fm = "---\n";
    fm += 'title: "' + (d.title || "").replace(/"/g, '\\"') + '"\n';
    fm += 'description: "' + (d.description || "").replace(/"/g, '\\"') + '"\n';
    fm += "date: " + d.date + "\n";
    fm += "tags: [" + (d.tags || []).map((t) => '"' + t + '"').join(", ") + "]\n";
    fm += 'author: "' + (d.author || "boggelino") + '"\n';
    if (d.draft) fm += "draft: true\n";
    if (d.pinned) fm += "pinned: true\n";
    if (d.authorNote && d.authorNote.trim())
      fm += 'authorNote: "' + escapeYamlString(d.authorNote.trim()) + '"\n';
    fm += "---\n\n";
    return fm + d.body + "\n";
  }

  function markProjectSelected() {
    const btn = $("#openProjectBtn");
    btn.disabled = true;
    btn.textContent = "Project folder selected";
  }

  /* ---------------- project folder, list, editing ---------------- */

  // The folder handle is kept in IndexedDB so the dev server's reload after a
  // write does not force you to pick the project again.
  const DB_NAME = "boggelino-compose";
  const STORE_NAME = "handles";
  const HANDLE_KEY = "projectDirHandle";

  function idbOpen() {
    return new Promise((resolve, reject) => {
      const req = indexedDB.open(DB_NAME, 1);
      req.onupgradeneeded = () => req.result.createObjectStore(STORE_NAME);
      req.onsuccess = () => resolve(req.result);
      req.onerror = () => reject(req.error);
    });
  }

  async function idbSetHandle(handle) {
    try {
      const db = await idbOpen();
      await new Promise((resolve, reject) => {
        const tx = db.transaction(STORE_NAME, "readwrite");
        tx.objectStore(STORE_NAME).put(handle, HANDLE_KEY);
        tx.oncomplete = resolve;
        tx.onerror = () => reject(tx.error);
      });
    } catch (e) {
      // No IndexedDB: the folder just has to be picked again after a reload
    }
  }

  async function idbGetHandle() {
    try {
      const db = await idbOpen();
      return await new Promise((resolve, reject) => {
        const tx = db.transaction(STORE_NAME, "readonly");
        const req = tx.objectStore(STORE_NAME).get(HANDLE_KEY);
        req.onsuccess = () => resolve(req.result || null);
        req.onerror = () => reject(req.error);
      });
    } catch (e) {
      return null;
    }
  }

  (async function restoreProjectHandle() {
    const handle = await idbGetHandle();
    if (!handle) return;
    try {
      const perm = await handle.requestPermission({ mode: "readwrite" });
      if (perm !== "granted") return;
      projectDirHandle = handle;
      markProjectSelected();
      for (const k of Object.keys(authorAvatarCache)) delete authorAvatarCache[k];
      setStatus("Project folder restored, loading articles...", "");
      await scanArticles();
      updatePreview();
    } catch (e) {
      // The handle is stale, ignore it
    }
  })();

  async function openProjectAndScan() {
    try {
      projectDirHandle = await window.showDirectoryPicker();
      markProjectSelected();
      await idbSetHandle(projectDirHandle);
      for (const k of Object.keys(authorAvatarCache)) delete authorAvatarCache[k];
      setStatus("Project folder selected, loading articles...", "");
      await scanArticles();
      updatePreview();
    } catch (err) {
      if (err.name === "AbortError") return;
      setStatus("Could not open the folder: " + err.message, "err");
    }
  }

  async function scanArticles() {
    if (!projectDirHandle) {
      setStatus("Choose the project folder first.", "err");
      return;
    }
    const index = {};
    for (const lang of ["sk", "en"]) {
      let dir;
      try {
        dir = await ensureDir(projectDirHandle, ["src", "content", "articles", lang]);
      } catch (e) {
        continue;
      }
      for await (const [name, handle] of dir.entries()) {
        if (handle.kind !== "file" || !name.endsWith(".md")) continue;
        const id = name.replace(/\.md$/, "");
        try {
          const file = await handle.getFile();
          const parsed = parseArticleFile(await file.text());
          if (!parsed) continue;
          if (!index[id]) index[id] = {};
          index[id][lang] = parsed;
        } catch (e) {
          // Unreadable file, skip it
        }
      }
    }
    articlesIndex = index;
    renderArticleList();
    setStatus("Loaded " + Object.keys(index).length + " article(s).", "ok");
  }

  function renderArticleList() {
    const container = $("#articleList");
    const ids = Object.keys(articlesIndex);
    if (ids.length === 0) {
      container.innerHTML = '<p class="hint">No articles found in this project yet.</p>';
      return;
    }
    ids.sort((a, b) => {
      const da = (articlesIndex[a].sk || articlesIndex[a].en).date || "";
      const db = (articlesIndex[b].sk || articlesIndex[b].en).date || "";
      return db.localeCompare(da);
    });
    container.innerHTML = ids
      .map((id) => {
        const entry = articlesIndex[id];
        const d = entry.sk || entry.en;
        const title = d.title || "(untitled)";
        const badge = d.draft
          ? '<span class="badge draft">Draft</span>'
          : '<span class="badge published">Published</span>';
        const pinnedBadge = d.pinned ? '<span class="badge pinned">Pinned</span>' : "";
        const langs = ["sk", "en"]
          .filter((l) => entry[l])
          .map((l) => l.toUpperCase())
          .join(" + ");
        return (
          '<div class="article-row">' +
          '<div class="article-info">' +
          "<strong>" + escapeHtml(title) + "</strong>" +
          '<span class="article-meta">' +
          escapeHtml(id) + " &middot; " + escapeHtml(d.date) + " &middot; " + langs +
          "</span>" +
          "</div>" +
          '<div class="article-badges">' + badge + (pinnedBadge || "<span></span>") + "</div>" +
          '<div class="article-actions">' +
          '<button type="button" class="cbtn cbtn-sm" onclick="loadArticleIntoEditor(\'' + id + '\')">Edit</button>' +
          '<button type="button" class="cbtn cbtn-sm" onclick="toggleDraftVisibility(\'' + id + '\')">' +
          (d.draft ? "Publish" : "Hide") +
          "</button>" +
          '<button type="button" class="cbtn cbtn-sm" onclick="deleteArticle(\'' + id + '\')">Delete</button>' +
          "</div>" +
          "</div>"
        );
      })
      .join("");
  }

  function loadArticleIntoEditor(id) {
    const entry = articlesIndex[id];
    if (!entry) return;
    isEditingExisting = true;
    $("#articleId").value = id;
    for (const lang of ["sk", "en"]) {
      const d = entry[lang];
      document.querySelector('.title[data-lang="' + lang + '"]').value = d ? d.title : "";
      document.querySelector('.description[data-lang="' + lang + '"]').value = d ? d.description : "";
      document.querySelector('.content[data-lang="' + lang + '"]').value = d ? d.body : "";
      document.querySelector('.authorNote[data-lang="' + lang + '"]').value = d ? d.authorNote || "" : "";
      $("#tags-" + lang).value = d ? d.tags.join(", ") : "";
    }
    const primary = entry.sk || entry.en;
    $("#date").value = primary.date || todayISO();
    $("#author").value = primary.author || "boggelino";
    $("#draft").checked = !!primary.draft;
    $("#pinned").checked = !!primary.pinned;
    images.length = 0;
    renderImgList();
    switchTab("sk");
    setStatus(
      'Editing "' +
        id +
        '". Images already in the project stay linked in the text but are not listed here. Saving overwrites the original files.',
      "ok",
    );
    $(".editor-scroll").scrollTo({ top: 0, behavior: "smooth" });
  }

  async function toggleDraftVisibility(id) {
    if (!projectDirHandle) {
      setStatus("Choose the project folder first.", "err");
      return;
    }
    const entry = articlesIndex[id];
    if (!entry) return;
    const newDraft = !(entry.sk || entry.en).draft;
    try {
      for (const lang of ["sk", "en"]) {
        if (!entry[lang]) continue;
        entry[lang].draft = newDraft;
        const dir = await ensureDir(projectDirHandle, ["src", "content", "articles", lang]);
        await writeFile(dir, id + ".md", rebuildFileFromData(entry[lang]));
      }
      setStatus('"' + id + '" is now ' + (newDraft ? "a hidden draft." : "published."), "ok");
      renderArticleList();
    } catch (err) {
      setStatus("Could not change visibility: " + err.message, "err");
    }
  }

  async function deleteArticle(id) {
    if (!projectDirHandle) {
      setStatus("Choose the project folder first.", "err");
      return;
    }
    const entry = articlesIndex[id];
    if (!entry) return;
    const d = entry.sk || entry.en;
    const confirmed = confirm(
      'Permanently delete "' +
        (d.title || id) +
        '" (ID ' +
        id +
        ')? Both language files and the whole image folder go with it. This cannot be undone.',
    );
    if (!confirmed) return;

    try {
      for (const lang of ["sk", "en"]) {
        if (!entry[lang]) continue;
        try {
          const dir = await ensureDir(projectDirHandle, ["src", "content", "articles", lang]);
          await dir.removeEntry(id + ".md");
        } catch (e) {
          // No file for this language
        }
      }
      try {
        const imagesRootDir = await ensureDir(projectDirHandle, ["public", "images", "articles"]);
        await imagesRootDir.removeEntry(id, { recursive: true });
      } catch (e) {
        // No image folder
      }
      delete articlesIndex[id];
      renderArticleList();
      setStatus('"' + id + '" deleted.', "ok");
    } catch (err) {
      setStatus("Could not delete: " + err.message, "err");
    }
  }

  async function startNewArticle() {
    await clearAll();
  }

  function setStatus(msg, kind) {
    const el = $("#status");
    el.textContent = msg;
    el.className = "status" + (kind ? " " + kind : "");
  }

  async function clearAll() {
    if (!confirm("Clear every field and start a new article?")) return;
    $$(".title, .description, .content, .authorNote").forEach((el) => (el.value = ""));
    $("#articleId").value = await generateUniqueId();
    $("#tags-sk").value = "";
    $("#tags-en").value = "";
    $("#draft").checked = false;
    $("#pinned").checked = false;
    $("#date").value = todayISO();
    isEditingExisting = false;
    images.length = 0;
    renderImgList();
    updatePreview();
    setStatus("", "");
  }
</script>
