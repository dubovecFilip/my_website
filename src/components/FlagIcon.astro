---
interface Props {
  code: 'sk' | 'gb';
  size?: number;
}
const { code, size = 18 } = Astro.props;
const w = size;
const h = Math.round(size * 0.7);
---

{code === 'sk' && (
  <svg width={w} height={h} viewBox="0 0 30 21" aria-hidden="true" class="flag-icon">
    <rect width="30" height="21" fill="#ee1c25" />
    <rect width="30" height="14" fill="#0b4ea2" />
    <rect width="30" height="7" fill="#fff" />
    <circle cx="11" cy="10.5" r="4.2" fill="#fff" stroke="#ee1c25" stroke-width="0.6" />
    <rect x="10.2" y="7.3" width="1.6" height="6.4" fill="#0b4ea2" />
    <rect x="8" y="9.7" width="6" height="1.6" fill="#0b4ea2" />
  </svg>
)}
{code === 'gb' && (
  <svg width={w} height={h} viewBox="0 0 30 21" aria-hidden="true" class="flag-icon">
    <rect width="30" height="21" fill="#00247d" />
    <path d="M0 0L30 21M30 0L0 21" stroke="#fff" stroke-width="3.2" />
    <path d="M0 0L30 21M30 0L0 21" stroke="#cf142b" stroke-width="1.2" />
    <path d="M15 0V21M0 10.5H30" stroke="#fff" stroke-width="5.2" />
    <path d="M15 0V21M0 10.5H30" stroke="#cf142b" stroke-width="2" />
  </svg>
)}

<style>
  .flag-icon {
    display: inline-block;
    vertical-align: middle;
    border-radius: 2px;
    flex-shrink: 0;
  }
</style>
