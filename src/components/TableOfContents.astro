---
import { t, type Lang } from '../i18n/dict';
import { chapterCount } from '../utils/format';

export interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  lang: Lang;
  headings: Heading[];
}

const { lang, headings } = Astro.props;
const d = t(lang);

/*
 * Do obsahu idú len H2 a H3 (sekcia 14). Číslujú sa výhradne H2, pretože tie
 * sú kapitoly. H3 je podkapitola a namiesto čísla dostane pomlčku, aby
 * číslovanie kapitol ostalo súvislé.
 */
let chapter = 0;
const items = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => {
    if (h.depth === 2) chapter += 1;
    return { ...h, mark: h.depth === 2 ? String(chapter).padStart(2, '0') : '–' };
  });
---

{
  items.length > 0 && (
    <nav class="toc" data-toc aria-labelledby="toc-title">
      <details class="toc-shell" data-toc-details open>
        <summary class="toc-head">
          <span class="mono-sm" id="toc-title">
            {d.toc_title}
          </span>
          <span class="toc-count mono-sm">{chapterCount(chapter, lang)}</span>
        </summary>

        <ol class="toc-list">
          {items.map((item) => (
            <li class:list={['toc-item', item.depth === 3 && 'is-sub']}>
              <a class="toc-link" href={`#${item.slug}`} data-toc-link={item.slug}>
                <span class="toc-n mono-sm" aria-hidden={item.depth === 3 ? 'true' : undefined}>
                  {item.mark}
                </span>
                <span class="toc-label">{item.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </details>
    </nav>
  )
}

<style>
  .toc {
    font-size: 14px;
  }

  .toc-shell > summary {
    list-style: none;
    cursor: default;
  }

  .toc-shell > summary::-webkit-details-marker {
    display: none;
  }

  .toc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-10);
    min-height: 34px;
    padding-bottom: var(--sp-10);
    border-bottom: 1px solid var(--line);
    color: var(--ink-4);
  }

  .toc-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: var(--sp-10);
  }

  .toc-link {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--sp-10);
    padding: 8px 10px 8px 14px;
    border-radius: var(--r-item);
    color: var(--ink-3);
    line-height: 1.4;
    transition:
      color var(--t-toc) var(--ease),
      background-color var(--t-toc) var(--ease);
  }

  /* Accentová linka sa plynulo presunie na aktuálnu kapitolu. */
  .toc-link::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    bottom: 8px;
    width: 2px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--t-toc) var(--ease);
  }

  .toc-item.is-sub .toc-link {
    padding-left: 28px;
  }

  @media (hover: hover) {
    .toc-link:hover {
      color: var(--ink-2);
    }
  }

  .toc-link.is-active {
    color: var(--ink);
    background: var(--fill-strong);
  }

  .toc-link.is-active::before {
    transform: scaleY(1);
  }

  .toc-n {
    flex: none;
    padding-top: 2px;
    color: var(--ink-4);
  }

  .toc-link.is-active .toc-n {
    color: var(--accent-text);
  }

  .toc-label {
    min-width: 0;
  }

  /* Na mobile je obsah rozbaľovací pruh pod nadpisom. */
  @media (max-width: 1179px) {
    .toc-shell {
      border-radius: var(--r-field);
      background: var(--fill-2);
      padding: var(--sp-12) var(--sp-14);
    }

    .toc-shell > summary {
      cursor: pointer;
      min-height: var(--touch);
      display: flex;
      align-items: center;
    }

    .toc-head {
      flex: 1;
      border-bottom: 0;
      padding-bottom: 0;
    }
  }
</style>
