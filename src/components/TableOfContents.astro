---
import { t, type Lang } from '../i18n/dict';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  lang: Lang;
  headings: Heading[];
}

const { lang, headings } = Astro.props;
const s = t(lang);

// Ignore H1 (the article title already exists), only H2/H3.
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length > 0 && (
  <>
    <nav class="toc toc-desktop" aria-label={s.toc_title}>
      <span class="toc-title">{s.toc_title}</span>
      <ul class="toc-list">
        {items.map((h) => (
          <li class:list={[`toc-depth-${h.depth}`]}>
            <a href={`#${h.slug}`} data-toc-link data-toc-slug={h.slug}>{h.text}</a>
          </li>
        ))}
      </ul>
    </nav>

    <details class="toc toc-mobile">
      <summary>{s.toc_title}</summary>
      <ul class="toc-list">
        {items.map((h) => (
          <li class:list={[`toc-depth-${h.depth}`]}>
            <a href={`#${h.slug}`} data-toc-link data-toc-slug={h.slug}>{h.text}</a>
          </li>
        ))}
      </ul>
    </details>

    <script>
      // Smooth scroll + active-heading highlighting. Runs once per page,
      // scoped to whichever TOC instance is actually visible via CSS.
      const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');

      links.forEach((link) => {
        link.addEventListener('click', (e) => {
          const slug = link.dataset.tocSlug;
          const target = slug ? document.getElementById(slug) : null;
          if (!target) return;
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', `#${slug}`);
          // Collapse the mobile <details> after picking an item.
          const details = link.closest('details.toc-mobile');
          if (details instanceof HTMLDetailsElement) details.open = false;
        });
      });

      const headingEls = Array.from(
        document.querySelectorAll<HTMLElement>('.article-body :is(h2, h3)[id]'),
      );

      if (headingEls.length > 0 && 'IntersectionObserver' in window) {
        const setActive = (slug: string) => {
          links.forEach((link) => {
            link.classList.toggle('is-active', link.dataset.tocSlug === slug);
          });
        };

        const visible = new Set<string>();
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              const id = entry.target.id;
              if (entry.isIntersecting) visible.add(id);
              else visible.delete(id);
            }
            // Prefer the topmost currently-visible heading.
            for (const h of headingEls) {
              if (visible.has(h.id)) {
                setActive(h.id);
                return;
              }
            }
          },
          { rootMargin: '-10% 0px -70% 0px', threshold: 0 },
        );

        headingEls.forEach((h) => observer.observe(h));
      }
    </script>
  </>
)}

<style>
  .toc-title {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 0.7rem;
  }
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
  }
  .toc-list a {
    display: block;
    color: var(--text-muted);
    font-size: 0.86rem;
    padding: 0.32rem 0.6rem;
    border-left: 2px solid transparent;
    text-decoration: none;
    line-height: 1.3;
  }
  .toc-list a:hover {
    color: var(--text);
  }
  .toc-list a.is-active {
    color: var(--accent-3);
    border-left-color: var(--accent-3);
    font-weight: 600;
  }
  .toc-depth-3 a {
    padding-left: 1.3rem;
    font-size: 0.82rem;
  }

  .toc-desktop {
    position: sticky;
    top: 5.5rem;
    align-self: start;
    border: 1px solid var(--border);
    background: var(--bg-raised);
    border-radius: var(--radius);
    padding: 1rem 0.7rem;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
  }

  .toc-mobile {
    display: none;
  }
  .toc-mobile summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
    border: 1px solid var(--border);
    background: var(--bg-raised);
    border-radius: var(--radius);
    padding: 0.7rem 0.9rem;
    list-style: none;
  }
  .toc-mobile summary::-webkit-details-marker {
    display: none;
  }
  .toc-mobile[open] summary {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }
  .toc-mobile .toc-list {
    border: 1px solid var(--border);
    border-top: none;
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
    padding: 0.5rem 0.7rem;
  }

  @media (max-width: 900px) {
    .toc-desktop {
      display: none;
    }
    .toc-mobile {
      display: block;
      margin-bottom: 1.8rem;
    }
  }
</style>
