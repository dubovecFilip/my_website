---
import { t, type Lang } from '../i18n/dict';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  lang: Lang;
  headings: Heading[];
}

const { lang, headings } = Astro.props;
const s = t(lang);

// Ignore H1 (the article title already exists), only H2/H3.
// H2 entries carry the same running number the article body prints.
let section = 0;
const items = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => {
    if (h.depth === 2) section += 1;
    return { ...h, marker: h.depth === 2 ? String(section).padStart(2, '0') : '\u2014' };
  });
---

{items.length > 0 && (
  <>
    <nav class="toc toc-desktop" aria-label={s.toc_title}>
      <span class="toc-title">{s.toc_title}</span>
      <ul class="toc-list">
        {items.map((h) => (
          <li class:list={[`toc-depth-${h.depth}`]}>
            <a href={`#${h.slug}`} data-toc-link data-toc-slug={h.slug}>
              <span class="toc-marker">{h.marker}</span>
              <span class="toc-text">{h.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <details class="toc toc-mobile">
      <summary>{s.toc_title} ({items.length})</summary>
      <ul class="toc-list">
        {items.map((h) => (
          <li class:list={[`toc-depth-${h.depth}`]}>
            <a href={`#${h.slug}`} data-toc-link data-toc-slug={h.slug}>
              <span class="toc-marker">{h.marker}</span>
              <span class="toc-text">{h.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </details>

    <script>
      // Smooth scroll + active-heading highlighting. Runs once per page,
      // scoped to whichever TOC instance is actually visible via CSS.
      const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');

      links.forEach((link) => {
        link.addEventListener('click', (e) => {
          const slug = link.dataset.tocSlug;
          const target = slug ? document.getElementById(slug) : null;
          if (!target) return;
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', `#${slug}`);
          // Collapse the mobile <details> after picking an item.
          const details = link.closest('details.toc-mobile');
          if (details instanceof HTMLDetailsElement) details.open = false;
        });
      });

      const headingEls = Array.from(
        document.querySelectorAll<HTMLElement>('.article-body :is(h2, h3)[id]'),
      );

      if (headingEls.length > 0 && 'IntersectionObserver' in window) {
        const setActive = (slug: string) => {
          links.forEach((link) => {
            link.classList.toggle('is-active', link.dataset.tocSlug === slug);
          });
        };

        const visible = new Set<string>();
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              const id = entry.target.id;
              if (entry.isIntersecting) visible.add(id);
              else visible.delete(id);
            }
            // Prefer the topmost currently-visible heading.
            for (const h of headingEls) {
              if (visible.has(h.id)) {
                setActive(h.id);
                return;
              }
            }
          },
          { rootMargin: '-10% 0px -70% 0px', threshold: 0 },
        );

        headingEls.forEach((h) => observer.observe(h));
      }
    </script>
  </>
)}

<style>
  .toc-title {
    display: block;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text);
    margin-bottom: 0.9rem;
  }
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc-list a {
    display: flex;
    gap: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.45;
    color: var(--text-secondary);
    padding: 0.55rem 0.6rem;
    border-bottom: 1px solid var(--border);
  }
  .toc-marker {
    flex: none;
    color: var(--text-faint);
  }
  .toc-list a:hover {
    background: var(--bg-raised);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
  }
  .toc-list a.is-active {
    background: var(--rule);
    color: var(--bg);
    border-bottom-color: var(--rule);
  }
  .toc-list a.is-active .toc-marker {
    color: var(--accent);
    font-weight: 700;
  }
  .toc-depth-3 a {
    padding-left: 1.5rem;
    color: var(--text-muted);
  }

  /* Stickiness lives on the rail in the article page, so the contents,
     the author and the actions travel down the page together. */
  .toc-desktop {
    padding: 1.6rem 1.1rem;
  }

  .toc-mobile {
    display: none;
  }
  .toc-mobile summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text);
    background: var(--bg-raised);
    padding: 0.9rem var(--pad);
    border-bottom: var(--rule-w) solid var(--rule);
    list-style: none;
  }
  .toc-mobile summary::-webkit-details-marker {
    display: none;
  }
  .toc-mobile summary::after {
    content: ' \25BE';
    color: var(--accent);
    float: right;
  }
  .toc-mobile .toc-list {
    padding: 0.4rem var(--pad) 0.8rem;
    border-bottom: var(--rule-w) solid var(--rule);
  }

  @media (max-width: 1200px) {
    .toc-desktop {
      display: none;
    }
    .toc-mobile {
      display: block;
    }
  }
</style>
