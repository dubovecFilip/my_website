---
import { t, type Lang } from '../i18n/dict';

interface Props {
  lang: Lang;
  note?: string;
  avatar: string;
}

const { lang, note, avatar } = Astro.props;
const s = t(lang);
---

{note && (
  <aside class="author-note">
    <header class="author-note-head">
      <img src={avatar} alt="" class="author-note-avatar" width="26" height="26" />
      <span class="author-note-title">{s.author_note_title}</span>
    </header>
    <p class="author-note-text">{note}</p>
  </aside>
)}

<style>
  .author-note {
    margin: 2.4rem 0;
    padding: 1.2rem 1.4rem 1.3rem;
    border: 1px solid color-mix(in srgb, var(--accent-3) 40%, var(--border));
    border-left: 4px solid var(--accent-3);
    background: color-mix(in srgb, var(--accent-3) 8%, var(--bg-raised));
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .author-note-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }
  .author-note-avatar {
    border-radius: 50%;
    display: block;
    flex-shrink: 0;
  }
  .author-note-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-3);
  }
  .author-note-text {
    margin: 0;
    color: var(--text);
    font-size: 1rem;
    font-style: italic;
    line-height: 1.55;
  }
</style>
