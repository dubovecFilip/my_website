---
import { t, type Lang } from '../i18n/dict';

interface Props {
  lang: Lang;
  note?: string;
  avatar: string;
  authorName?: string;
}

const { lang, note, avatar, authorName } = Astro.props;
const s = t(lang);
---

{note && (
  <aside class="author-note">
    <img src={avatar} alt="" class="author-note-avatar" width="64" height="64" />
    <div class="author-note-body">
      <span class="author-note-title">{s.author_note_title}</span>
      <p class="author-note-text">{note}</p>
      {authorName && <span class="author-note-sign">&mdash; {authorName}</span>}
    </div>
  </aside>
)}

<style>
  .author-note {
    display: flex;
    gap: 1.2rem;
    margin: 2.4rem 0;
    padding: 1.3rem;
    background: var(--bg-raised);
    border: var(--rule-w) solid var(--rule);
  }
  .author-note-avatar {
    flex: none;
    width: 64px;
    height: 64px;
    border: var(--rule-w) solid var(--rule);
    border-radius: 0;
    display: block;
  }
  .author-note-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .author-note-title {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .author-note-text {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--text-body);
  }
  .author-note-sign {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
</style>
