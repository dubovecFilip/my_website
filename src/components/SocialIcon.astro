---
import { 
  siTwitch, 
  siKick, 
  siYoutube, 
  siTiktok, 
  siX, 
  siKofi, 
  siSteam 
} from 'simple-icons';

interface Props {
  name: 'twitch' | 'kick' | 'youtube' | 'tiktok' | 'x' | 'kofi' | 'steam';
  size?: number;
}

const { name, size = 20 } = Astro.props;

// Mapa ikon zo Simple Icons
const icons = {
  twitch: siTwitch,
  kick: siKick,
  youtube: siYoutube,
  tiktok: siTiktok,
  x: siX,
  kofi: siKofi,
  steam: siSteam,
};

const icon = icons[name];
---

{icon && (
  <svg 
    width={size} 
    height={size} 
    viewBox="0 0 24 24" 
    fill="currentColor" 
    class="social-icon" 
    aria-hidden="true"
  >
    <path d={icon.path} />
  </svg>
)}

<style>
  .social-icon {
    display: block;
    flex-shrink: 0;
  }
</style>