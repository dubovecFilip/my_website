---
// Attaches a lightbox to every image matched by `selector`. It scans the
// rendered DOM once mounted, so it covers plain images, the figure/figcaption
// images from the caption plugin, the article cover and the gallery sheet.
interface Props {
  selector?: string;
}

const { selector = '.article-cover img, .article-body img' } = Astro.props;
---

<div class="lightbox" id="lightbox" aria-hidden="true" data-selector={selector}>
  <button class="lightbox-close" id="lightbox-close" aria-label="Close" type="button">&times;</button>
  <button class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="Previous image" type="button">&larr;</button>
  <div class="lightbox-stage" id="lightbox-stage">
    <img id="lightbox-img" src="" alt="" />
    <p class="lightbox-caption" id="lightbox-caption"></p>
  </div>
  <button class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="Next image" type="button">&rarr;</button>
</div>

<script>
  const overlay = document.getElementById('lightbox') as HTMLDivElement;
  const stage = document.getElementById('lightbox-stage') as HTMLDivElement;
  const imgEl = document.getElementById('lightbox-img') as HTMLImageElement;
  const captionEl = document.getElementById('lightbox-caption') as HTMLParagraphElement;
  const closeBtn = document.getElementById('lightbox-close') as HTMLButtonElement;
  const prevBtn = document.getElementById('lightbox-prev') as HTMLButtonElement;
  const nextBtn = document.getElementById('lightbox-next') as HTMLButtonElement;

  // Hidden images (the body copy of the cover) stay out of the sequence.
  const selector = overlay.dataset.selector || '.article-body img';
  const images = Array.from(document.querySelectorAll<HTMLImageElement>(selector)).filter(
    (img) => img.offsetParent !== null,
  );

  /**
   * The cover carries no alt of its own, so it borrows the caption from the
   * hidden body copy of the same file.
   */
  function captionFor(img: HTMLImageElement): string {
    if (img.alt) return img.alt;
    const twin = Array.from(document.querySelectorAll<HTMLImageElement>('.article-body img')).find(
      (candidate) => candidate.src === img.src && candidate.alt,
    );
    return twin?.alt ?? '';
  }
  let currentIndex = 0;
  let zoomed = false;

  if (images.length <= 1) {
    prevBtn.style.display = 'none';
    nextBtn.style.display = 'none';
  }

  function openAt(index: number) {
    if (images.length === 0) return;
    currentIndex = (index + images.length) % images.length;
    const img = images[currentIndex];
    const caption = captionFor(img);
    imgEl.src = img.src;
    imgEl.alt = caption;
    captionEl.textContent = caption;
    captionEl.style.display = caption ? 'block' : 'none';
    zoomed = false;
    imgEl.classList.remove('is-zoomed');
    overlay.classList.add('is-open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    overlay.classList.remove('is-open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  function next() {
    openAt(currentIndex + 1);
  }
  function prev() {
    openAt(currentIndex - 1);
  }

  images.forEach((img, index) => {
    // Gallery thumbs sit inside a link to the raw file, which stays as the
    // no-script fallback. Links that point somewhere else are left alone.
    const wrapper = img.closest('a');
    const target = wrapper && wrapper.href === img.src ? wrapper : img;
    target.addEventListener('click', (e) => {
      e.preventDefault();
      openAt(index);
    });
  });

  closeBtn.addEventListener('click', close);
  nextBtn.addEventListener('click', next);
  prevBtn.addEventListener('click', prev);

  // Click outside the image (on the dark stage) closes; click on the image
  // itself toggles a simple zoom instead.
  stage.addEventListener('click', (e) => {
    if (e.target === imgEl) return;
    close();
  });
  imgEl.addEventListener('click', () => {
    zoomed = !zoomed;
    imgEl.classList.toggle('is-zoomed', zoomed);
  });

  document.addEventListener('keydown', (e) => {
    if (!overlay.classList.contains('is-open')) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowRight') next();
    else if (e.key === 'ArrowLeft') prev();
  });

  // Basic swipe support for mobile.
  let touchStartX = 0;
  stage.addEventListener(
    'touchstart',
    (e) => {
      touchStartX = e.touches[0].clientX;
    },
    { passive: true },
  );
  stage.addEventListener(
    'touchend',
    (e) => {
      const dx = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(dx) < 40) return;
      if (dx < 0) next();
      else prev();
    },
    { passive: true },
  );
</script>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(17, 17, 17, 0.97);
    z-index: 100;
  }
  .lightbox.is-open {
    display: flex;
  }
  .lightbox-stage {
    max-width: 90vw;
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
  }
  .lightbox-stage img {
    max-width: 90vw;
    max-height: 78vh;
    object-fit: contain;
    border: var(--rule-w) solid #f4f2ec;
    border-radius: 0;
    cursor: zoom-in;
    transition: transform 0.2s ease;
  }
  .lightbox-stage img.is-zoomed {
    cursor: zoom-out;
    transform: scale(1.5);
  }
  .lightbox-caption {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f4f2ec;
    border: 2px solid #f4f2ec;
    padding: 0.4rem 0.7rem;
    text-align: center;
    max-width: 60ch;
    margin: 0;
  }

  /* Controls are hard squares, not floating circles: same vocabulary as
     the rest of the site. */
  .lightbox-close,
  .lightbox-nav {
    position: absolute;
    background: none;
    border: var(--rule-w) solid #f4f2ec;
    color: #f4f2ec;
    cursor: pointer;
    border-radius: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
  }
  .lightbox-close {
    top: 1.2rem;
    right: 1.2rem;
    width: 46px;
    height: 46px;
    font-size: 1.5rem;
    line-height: 1;
    background: var(--rust);
    border-color: var(--rust);
    color: #ffffff;
  }
  .lightbox-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 56px;
    height: 56px;
    font-size: 1.4rem;
  }
  .lightbox-prev {
    left: 1.4rem;
  }
  .lightbox-next {
    right: 1.4rem;
  }
  .lightbox-nav:hover {
    background: var(--rust);
    border-color: var(--rust);
    color: #ffffff;
  }
  .lightbox-close:hover {
    background: #f4f2ec;
    border-color: #f4f2ec;
    color: #111111;
  }

  @media (max-width: 640px) {
    .lightbox-nav {
      width: 42px;
      height: 42px;
    }
    .lightbox-close {
      width: 40px;
      height: 40px;
      font-size: 1.2rem;
    }
  }
</style>
