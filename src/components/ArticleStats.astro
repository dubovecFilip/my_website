---
import { t, type Lang } from '../i18n/dict';
import { computeArticleStats } from '../utils/article-stats';

interface Props {
  lang: Lang;
  body: string | undefined;
  /** "hero" sits inside the dark article header, "block" stands alone. */
  variant?: 'hero' | 'block';
}

const { lang, body, variant = 'block' } = Astro.props;
const s = t(lang);
const stats = computeArticleStats(body);
const locale = lang === 'sk' ? 'sk-SK' : 'en-GB';

const cells = [
  { label: s.stats_words, value: stats.words.toLocaleString(locale), accent: false },
  { label: s.stats_reading_time, value: `${stats.readingTime} ${s.stats_minutes}`, accent: true },
  { label: s.stats_images, value: String(stats.images), accent: false },
  { label: s.stats_headings, value: String(stats.headings), accent: false },
];
---

<dl class:list={['stats', `stats-${variant}`]}>
  {cells.map((cell) => (
    <div class="stat">
      <dt>{cell.label}</dt>
      <dd class:list={[cell.accent && 'is-accent']}>{cell.value}</dd>
    </div>
  ))}
</dl>

<style>
  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
  }
  .stat {
    padding: 0.9rem 1rem;
  }
  .stat dt {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .stat dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.6rem;
    line-height: 1.2;
  }
  .stat dd.is-accent {
    color: var(--accent);
  }

  /* Inside the dark header the grid is drawn with cream hairlines. */
  .stats-hero {
    border: var(--rule-w) solid var(--inv-text);
  }
  .stats-hero .stat {
    border-right: 2px solid var(--inv-text);
    border-bottom: 2px solid var(--inv-text);
  }
  .stats-hero .stat:nth-child(2n) {
    border-right: none;
  }
  .stats-hero .stat:nth-child(n + 3) {
    border-bottom: none;
  }
  .stats-hero .stat dt {
    color: var(--inv-text-muted);
  }

  .stats-block {
    border: var(--rule-w) solid var(--rule);
    grid-template-columns: repeat(4, 1fr);
    margin: 2rem 0;
  }
  .stats-block .stat + .stat {
    border-left: 2px solid var(--rule);
  }

  @media (max-width: 700px) {
    .stats-block {
      grid-template-columns: 1fr 1fr;
    }
    .stats-block .stat + .stat {
      border-left: none;
    }
  }
</style>
