---
import { getCollection } from 'astro:content';
import { t, relativeTime, type Lang } from '../i18n/dict';

interface Props {
  lang: Lang;
  excludeSlug?: string;
}

const { lang, excludeSlug } = Astro.props;
const s = t(lang);

const collectionName = lang === 'sk' ? 'articles-sk' : 'articles-en';
const all = await getCollection(collectionName as 'articles-sk' | 'articles-en', ({ data }) => !data.draft);

const sorted = all
  .filter((a) => a.id !== excludeSlug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const recent = sorted.slice(0, 4);

const tagCounts = new Map<string, number>();
for (const a of all) {
  for (const tag of a.data.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const categories = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8);

const dots = ['var(--accent)', 'var(--accent-2)', 'var(--accent-3)'];
---

<aside class="sidebar">
  <div class="side-card">
    <h3 class="side-title">{s.sidebar_about}</h3>
    <div class="about-row">
      <img src="/images/boggelino.png" width="52" height="52" alt="" class="about-avatar" />
      <div>
        <p class="about-name">BOGGELINO</p>
      </div>
    </div>
    <p class="about-blurb">{s.about_intro_1}</p>
    <a href={`/${lang}/about/`} class="side-link">{s.nav_about} →</a>
  </div>

  <div class="side-card">
    <h3 class="side-title">{s.sidebar_recent}</h3>
    {recent.length === 0 ? (
      <p class="side-empty">{s.sidebar_empty}</p>
    ) : (
      <ul class="recent-list">
        {recent.map((a, i) => (
          <li>
            <a href={`/${lang}/articles/${a.id}/`}>
              <span class="recent-dot" style={`background: ${dots[i % dots.length]};`}></span>
              <span class="recent-text">
                <span class="recent-title">{a.data.title}</span>
                <span class="recent-date mono">{relativeTime(a.data.date, lang)}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>

  <div class="side-card">
    <h3 class="side-title">{s.sidebar_categories}</h3>
    {categories.length === 0 ? (
      <p class="side-empty">{s.sidebar_empty}</p>
    ) : (
      <ul class="cat-list">
        {categories.map(([tag, count]) => (
          <li>
            <a href={`/${lang}/tags/${tag}/`}>
              <span>{tag}</span>
              <span class="cat-count mono">{count}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .side-card {
    border: 1px solid var(--border);
    background: var(--bg-raised);
    border-radius: var(--radius);
    padding: 1.2rem 1.3rem 1.4rem;
  }
  .side-title {
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 1rem;
    margin: 0 0 0.9rem 0;
    color: var(--text);
  }
  .side-empty {
    color: var(--text-faint);
    font-size: 0.85rem;
    margin: 0;
  }

  .about-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .about-avatar {
    border-radius: 50%;
    display: block;
    flex-shrink: 0;
  }
  .about-name {
    font-family: var(--font-display);
    font-size: 1rem;
    margin: 0;
    color: var(--text);
  }
  .about-blurb {
    color: var(--text-muted);
    font-size: 0.88rem;
    margin: 0.9rem 0 1rem 0;
  }
  .side-link {
    color: var(--accent-3);
    font-size: 0.85rem;
  }

  .recent-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .recent-list a {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    color: var(--text);
  }
  .recent-list a:hover {
    text-decoration: none;
  }
  .recent-list a:hover .recent-title {
    color: var(--accent-3);
  }
  .recent-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-top: 0.4em;
    flex-shrink: 0;
  }
  .recent-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .recent-title {
    font-size: 0.92rem;
    line-height: 1.35;
  }
  .recent-date {
    font-size: 0.72rem;
    color: var(--text-faint);
  }

  .cat-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .cat-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.45rem 0;
    color: var(--text-muted);
    font-size: 0.9rem;
    border-bottom: 1px solid var(--border);
  }
  .cat-list li:last-child a {
    border-bottom: none;
  }
  .cat-list a:hover {
    color: var(--accent-3);
    text-decoration: none;
  }
  .cat-count {
    color: var(--text-faint);
    font-size: 0.78rem;
  }
</style>
