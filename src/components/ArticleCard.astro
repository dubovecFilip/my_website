---
import { Image } from 'astro:assets';
import { t, type Lang } from '../i18n/dict';

interface Props {
  lang: Lang;
  slug: string;
  title: string;
  description: string;
  date: Date;
  tags: string[];
  variant?: 'list' | 'grid';
  image?: string;
  readingTime?: number;
}

const { lang, slug, title, description, date, tags, variant = 'list', image, readingTime } = Astro.props;
const s = t(lang);
const readingTimeLabel = lang === 'sk' ? `${readingTime} min čítania` : `${readingTime} min read`;
const dateStr = date.toLocaleDateString(lang === 'sk' ? 'sk-SK' : 'en-GB', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

// No per-article cover images exist yet, so grid cards get a deterministic
// gradient "thumb" derived from the title instead of a broken <img>.
const gradients = [
  ['var(--accent)', 'var(--accent-3)'],
  ['var(--accent-2)', 'var(--accent-3)'],
  ['var(--accent)', 'var(--accent-2)'],
];
let hash = 0;
for (const ch of title) hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;
const [g1, g2] = gradients[hash % gradients.length];
---

<a class={`card ${variant === 'grid' ? 'card-grid' : ''}`} href={`/${lang}/articles/${slug}/`}>
  {variant === 'grid' && (
    image ? (
      <div class="card-thumb card-thumb-photo">
        <img src={image} alt="" loading="lazy" class="card-thumb-img" />
      </div>
    ) : (
      <div class="card-thumb" style={`background: linear-gradient(135deg, ${g1}, ${g2});`}></div>
    )
  )}
  <div class="card-body">
    <div class="card-meta mono">
      <time datetime={date.toISOString()}>{dateStr}</time>
      {typeof readingTime === 'number' && (
        <>
          <span class="meta-dot">&middot;</span>
          <span class="card-reading-time">{readingTimeLabel}</span>
        </>
      )}
    </div>
    <h3 class="card-title">{title}</h3>
    <p class="card-desc">{description}</p>
    {tags.length > 0 && (
      <div class="card-tags">
        {tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )}
  </div>
</a>

<style>
  .card {
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
    overflow: hidden;
  }
  .card:hover {
    border-color: var(--accent);
    text-decoration: none;
    transform: translateY(-2px);
  }
  .card-body {
    padding: 1.4rem 1.5rem;
  }
  .card-grid .card-body {
    padding: 0.7rem 1.2rem 1.3rem;
  }
  .card-thumb {
    position: relative;
    height: 130px;
  }
  .card-thumb-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }
  /* Both photo thumbs and the gradient placeholder can end in a color
     close to the card background, which reads as the meta line sitting
     "inside" the thumb. A soft fade into the card color gives every
     variant a clean handoff regardless of what's underneath. */
  .card-thumb::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 46%;
    background: linear-gradient(to bottom, transparent, var(--bg-raised));
    pointer-events: none;
  }
  .card-meta {
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .meta-dot {
    color: var(--border);
  }
  .card-reading-time {
    white-space: nowrap;
  }
  .card-title {
    font-size: 1.3rem;
    margin: 0 0 0.4em 0;
    color: var(--text);
  }
  .card-grid .card-title {
    font-size: 1.08rem;
  }
  .card-desc {
    color: var(--text-muted);
    margin: 0 0 0.8em 0;
    font-size: 0.95rem;
  }
  .card-grid .card-desc {
    font-size: 0.88rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
</style>
