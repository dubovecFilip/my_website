---
import PlaceholderArt from './PlaceholderArt.astro';
import type { Article } from '../utils/articles';
import { isNew } from '../utils/articles';
import { t, type Lang } from '../i18n/dict';
import { formatDate, isoDate, readingTimeShort, readingTimeLong } from '../utils/format';

interface Props {
  article: Article;
  lang: Lang;
  variant?: 'grid' | 'list';
  /** Poradie štítkov podľa globálnej četnosti naprieč všetkými článkami. */
  tagRank?: Record<string, number>;
  /** V archíve má pripnutý článok len malý štítok. */
  showPinned?: boolean;
}

const { article, lang, variant = 'grid', tagRank = {}, showPinned = false } = Astro.props;
const d = t(lang);

/* Najčastejšie štítky nesú najviac významu, preto ostávajú viditeľné ako prvé. */
const tags = [...article.tags].sort((a, b) => (tagRank[b] ?? 0) - (tagRank[a] ?? 0));

const fresh = !article.draft && isNew(article);
const dateLabel = formatDate(article.date);
const readShort = readingTimeShort(article.readingTime, lang);
const readLong = readingTimeLong(article.readingTime, lang);
---

<article
  class:list={['card', `card-${variant}`, article.draft && 'is-draft']}
  data-card-id={article.id}
  data-card-lang={lang}
>
  <a class="card-link" href={article.href}>
    <span class="sr-only">{article.title}</span>
  </a>

  <div class="card-media">
    {
      article.image ? (
        <img
          src={article.image}
          alt=""
          loading="lazy"
          decoding="async"
          width="380"
          height="158"
        />
      ) : (
        <PlaceholderArt ratio="16 / 9" />
      )
    }
  </div>

  <div class="card-body">
    {
      (fresh || (showPinned && article.pinned) || article.draft) && (
        <p class="card-flags">
          {article.draft && <span class="badge badge-draft">{d.badge_draft}</span>}
          {showPinned && article.pinned && (
            <span class="badge badge-pinned-quiet">{d.badge_pinned}</span>
          )}
          {fresh && <span class="badge badge-new">{d.badge_new}</span>}
        </p>
      )
    }

    <h3 class="card-title" title={article.title}>{article.title}</h3>

    {article.description && <p class="card-desc">{article.description}</p>}

    {
      tags.length > 0 && (
        <p class="card-tags" data-tagrow>
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </p>
      )
    }

    <p class="card-meta mono-sm">
      <time datetime={isoDate(article.date)}>{dateLabel}</time>
      <span aria-hidden="true">·</span>
      {
        article.draft ? (
          <span class="card-draft-mark">{d.badge_draft}</span>
        ) : (
          <span class="card-read-time" aria-label={readLong}>
            <svg class="icon-clock" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <circle cx="8" cy="8" r="6.25" />
              <path d="M8 4.4V8l2.5 1.6" />
            </svg>
            {readShort}
          </span>
        )
      }
    </p>
  </div>
</article>

<style>
  /* Karta je jeden odkaz na celú plochu, štítky sú len text, nie odkazy. */
  .card {
    position: relative;
    display: flex;
    background: var(--surface-2);
    border-radius: var(--r-card);
    overflow: hidden;
    transition:
      background-color var(--t-state) var(--ease),
      transform var(--t-state) var(--ease),
      box-shadow var(--t-state) var(--ease);
  }

  .card-link {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
  }

  .card-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (hover: hover) {
    .card:hover {
      background: var(--surface-3);
      transform: translateY(-3px);
      box-shadow: var(--shadow);
    }

    .card:hover .card-media img {
      transform: scale(1.03);
    }
  }

  .card:has(.card-link:focus-visible) {
    background: var(--surface-3);
  }

  .card-media {
    position: relative;
    flex: none;
    overflow: hidden;
    background: var(--grad-placeholder);
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--t-state) var(--ease);
  }

  /* Obrázok nikdy nekončí tvrdou hranou proti textu. */
  .card-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--grad-card);
    pointer-events: none;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .card-flags {
    display: flex;
    gap: var(--sp-6);
    flex-wrap: wrap;
  }

  .card-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--fs-card-title);
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--ink);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color var(--t);
  }

  .card-desc {
    position: relative;
    font-size: var(--fs-card-desc);
    line-height: 1.5;
    color: var(--ink-3);
    /* Najviac 3 riadky; posledný sa stráca do podkladu karty. */
    max-height: calc(var(--fs-card-desc) * 1.5 * 3);
    overflow: hidden;
  }

  /* Nikdy sa nereže v strede slova, preto fade, nie tri bodky. */
  .card-desc::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    width: 60%;
    height: 18px;
    background: var(--grad-clamp);
    pointer-events: none;
  }

  @media (hover: hover) {
    .card:hover .card-desc::after {
      background: linear-gradient(90deg, rgba(31, 31, 31, 0) 0%, var(--surface-3) 82%);
    }

    /* Koncová farba gradientu sa vždy rovná podkladu, pri hoveri je to
       --surface-3, inak by sa obrázok cez prechod pretláčal. */
    .card:hover .card-media::after {
      background: linear-gradient(180deg, rgba(31, 31, 31, 0) 62%, var(--surface-3) 100%);
    }
  }

  .card-tags {
    display: flex;
    gap: var(--sp-6);
    flex-wrap: wrap;
    overflow: hidden;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--sp-6);
    margin-top: auto;
    color: var(--ink-4);
  }

  .card-draft-mark {
    color: var(--draft);
  }

  .card-read-time {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .icon-clock {
    width: 11px;
    height: 11px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* --- Mriežka ------------------------------------------------------- */

  .card-grid {
    flex-direction: column;
    min-height: 372px;
  }

  /* Karta v mriežke: 380 – 430 × 372 px, obrázok 158 px. */
  .card-grid .card-media {
    height: 158px;
    width: 100%;
  }

  .card-grid .card-media :global(.ph) {
    aspect-ratio: auto;
    height: 100%;
  }

  .card-grid .card-body {
    flex: 1;
    gap: var(--sp-10);
    padding: 18px 20px 20px;
  }

  /* --- Zoznam -------------------------------------------------------- */
  /* Riadok je jeden odkaz · obrázok 104 × 68 · popis na jeden riadok. */

  .card-list {
    align-items: center;
    gap: var(--sp-22);
    padding: var(--sp-14);
    border-radius: var(--r-field);
  }

  .card-list .card-media {
    width: 104px;
    height: 68px;
    aspect-ratio: auto;
    border-radius: var(--r-item);
  }

  .card-list .card-media :global(.ph) {
    aspect-ratio: auto;
    height: 100%;
  }

  .card-list .card-body {
    flex: 1;
    flex-direction: row;
    align-items: center;
    gap: var(--sp-22);
  }

  .card-list .card-title {
    font-size: 20px;
    -webkit-line-clamp: 1;
    line-clamp: 1;
    flex: 1;
    min-width: 0;
  }

  .card-list .card-desc {
    flex: 1.2;
    min-width: 0;
    max-height: none;
    white-space: nowrap;
    overflow: hidden;
  }

  .card-list .card-desc::after {
    width: 40%;
    height: 100%;
  }

  .card-list .card-tags,
  .card-list .card-flags {
    display: none;
  }

  .card-list .card-meta {
    flex: none;
    width: 150px;
    justify-content: flex-end;
    margin-top: 0;
  }

  @media (max-width: 767px) {
    .card-list .card-desc {
      display: none;
    }

    .card-list .card-body {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--sp-6);
    }

    .card-list .card-meta {
      width: auto;
      justify-content: flex-start;
    }

    .card-grid {
      min-height: 0;
    }
  }
</style>
