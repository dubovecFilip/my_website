---
import PlaceholderArt from './PlaceholderArt.astro';
import { type Lang } from '../i18n/dict';

interface Props {
  lang: Lang;
  slug: string;
  title: string;
  description: string;
  date: Date;
  tags: string[];
  /** Position in the listing. Rendered as the big rust index number. */
  index?: number;
  variant?: 'row' | 'compact';
  image?: string;
  readingTime?: number;
}

const { lang, slug, title, description, date, tags, index, variant = 'row', image, readingTime } = Astro.props;
const readingTimeLabel = lang === 'sk' ? `${readingTime} min čítania` : `${readingTime} min read`;
const locale = lang === 'sk' ? 'sk-SK' : 'en-GB';
const dateStr = date.toLocaleDateString(locale, { day: '2-digit', month: '2-digit', year: 'numeric' });
const dateShort = date.toLocaleDateString(locale, { day: '2-digit', month: '2-digit' });
const indexLabel = typeof index === 'number' ? String(index).padStart(2, '0') : undefined;
const href = `/${lang}/articles/${slug}/`;
---

{variant === 'row' ? (
  <a class="row" href={href}>
    <span class="row-index">{indexLabel}</span>
    <span class="row-thumb">
      {image ? <img src={image} alt="" loading="lazy" /> : <PlaceholderArt seed={title} />}
    </span>
    <span class="row-body">
      <span class="row-title">{title}</span>
      <span class="row-desc">{description}</span>
      {tags.length > 0 && (
        <span class="row-tags">
          {tags.map((tag) => (
            <span class="tag tag-sm">{tag}</span>
          ))}
        </span>
      )}
      <span class="row-meta-inline">
        {dateShort}
        {typeof readingTime === 'number' && <> &middot; {readingTimeLabel}</>}
      </span>
    </span>
    <span class="row-meta">
      <span>{dateStr}</span>
      {typeof readingTime === 'number' && <span>{readingTimeLabel}</span>}
    </span>
  </a>
) : (
  <a class="compact" href={href}>
    <span class="compact-thumb">
      {image ? <img src={image} alt="" loading="lazy" /> : <PlaceholderArt seed={title} />}
    </span>
    <span class="compact-body">
      <span class="compact-meta">
        {dateStr}
        {typeof readingTime === 'number' && <> &middot; {readingTimeLabel}</>}
      </span>
      <span class="compact-title">{title}</span>
      <span class="compact-desc">{description}</span>
    </span>
  </a>
)}

<style>
  /* ---------- Row: the archive and homepage feed unit ---------- */

  .row {
    display: grid;
    grid-template-columns: 110px 190px minmax(0, 1fr) 170px;
    align-items: stretch;
    border-bottom: var(--rule-w) solid var(--rule);
    color: inherit;
  }
  .row:hover {
    background: var(--rule);
    color: var(--bg);
  }
  .row:focus-visible {
    outline: var(--rule-w) solid var(--accent);
    outline-offset: -8px;
  }

  .row-index {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.8rem, 4vw, 3.1rem);
    line-height: 1;
    border-right: var(--rule-w) solid var(--rule);
  }
  .row:hover .row-index {
    color: var(--accent);
  }

  .row-thumb {
    position: relative;
    border-right: var(--rule-w) solid var(--rule);
    overflow: hidden;
    min-height: 130px;
  }
  .row-thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .row-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.2rem 1.4rem;
    border-right: var(--rule-w) solid var(--rule);
    min-width: 0;
  }
  .row-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.25rem, 2.6vw, 1.85rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }
  .row:hover .row-title::after {
    content: ' \2192';
  }
  .row-desc {
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 60ch;
  }
  .row:hover .row-desc {
    color: inherit;
  }
  .row-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.1rem;
  }
  .row-meta-inline {
    display: none;
  }

  .row-meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.2rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .row:hover .row-meta {
    color: inherit;
  }

  /* ---------- Compact: related articles ---------- */

  .compact {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    border-right: var(--rule-w) solid var(--rule);
    border-bottom: var(--rule-w) solid var(--rule);
    background: var(--bg);
    color: inherit;
  }
  .compact:hover {
    background: var(--rule);
    color: var(--bg);
  }
  .compact-thumb {
    position: relative;
    border-right: var(--rule-w) solid var(--rule);
    min-height: 130px;
    overflow: hidden;
  }
  .compact-thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .compact-body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.1rem 1.2rem;
  }
  .compact-meta {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .compact-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.35rem;
    line-height: 1.05;
    text-transform: uppercase;
  }
  .compact-desc {
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }
  .compact:hover .compact-desc {
    color: inherit;
  }

  @media (max-width: 860px) {
    .row {
      grid-template-columns: 64px minmax(0, 1fr);
      gap: 0;
      padding: 1rem;
    }
    .row-index {
      align-items: flex-start;
      justify-content: flex-start;
      border-right: none;
      font-size: 1.75rem;
    }
    .row-thumb {
      grid-column: 2;
      border-right: none;
      border: 2px solid var(--rule);
      min-height: 96px;
      margin-bottom: 0.6rem;
    }
    .row-body {
      grid-column: 2;
      padding: 0;
      border-right: none;
      gap: 0.4rem;
    }
    .row-tags {
      display: none;
    }
    .row-meta {
      display: none;
    }
    .row-meta-inline {
      display: block;
      font-family: var(--font-mono);
      font-size: 0.62rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-muted);
    }
    .row:hover .row-meta-inline {
      color: inherit;
    }
    .compact {
      grid-template-columns: 1fr;
    }
    .compact-thumb {
      border-right: none;
      border-bottom: var(--rule-w) solid var(--rule);
    }
  }
</style>
