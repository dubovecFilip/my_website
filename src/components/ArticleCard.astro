---
import { t, type Lang } from '../i18n/dict';

interface Props {
  lang: Lang;
  slug: string;
  title: string;
  description: string;
  date: Date;
  tags: string[];
}

const { lang, slug, title, description, date, tags } = Astro.props;
const s = t(lang);
const dateStr = date.toLocaleDateString(lang === 'sk' ? 'sk-SK' : 'en-GB', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a class="card" href={`/${lang}/articles/${slug}/`}>
  <div class="card-meta mono">
    <time datetime={date.toISOString()}>{dateStr}</time>
  </div>
  <h3 class="card-title">{title}</h3>
  <p class="card-desc">{description}</p>
  {tags.length > 0 && (
    <div class="card-tags">
      {tags.map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  )}
</a>

<style>
  .card {
    display: block;
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .card:hover {
    border-color: var(--accent);
    text-decoration: none;
    transform: translateY(-2px);
  }
  .card-meta {
    font-size: 0.75rem;
    color: var(--text-faint);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }
  .card-title {
    font-size: 1.3rem;
    margin: 0 0 0.4em 0;
    color: var(--text);
  }
  .card-desc {
    color: var(--text-muted);
    margin: 0 0 0.8em 0;
    font-size: 0.95rem;
  }
  .card-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
</style>
