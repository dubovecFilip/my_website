---
/**
 * Kanonické je ID, samotné /836206/ presmeruje na plný tvar
 * /836206-manifest-jedneho-napadu/ (sekcia 15).
 *
 * Na Netlify to zachytí pravidlo v _redirects (301) a táto stránka sa nikdy
 * nezobrazí. Pri statickom náhľade, `astro dev` a lokálnom otvorení súboru
 * presmeruje meta refresh a skript, takže adresa funguje všade rovnako.
 */
interface Props {
  to: string;
  lang: string;
}

const { to, lang } = Astro.props;
const target = new URL(to, Astro.site ?? 'https://boggelino.netlify.app').href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
    <title>→ {to}</title>
    <script is:inline define:vars={{ to }}>
      window.location.replace(to);
    </script>
    <style is:inline>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #111111;
        color: #8f8a80;
        font: 12px/1.6 ui-monospace, SFMono-Regular, Menlo, monospace;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      a {
        color: #f2724a;
      }
    </style>
  </head>
  <body>
    <p><a href={to}>→ {to}</a></p>
  </body>
</html>
