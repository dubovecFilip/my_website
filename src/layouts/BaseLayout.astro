---
import '../styles/global.css';
import { t, otherLang, type Lang } from '../i18n/dict';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  // Override where the language switcher points to. Use this whenever the current
  // page's URL isn't guaranteed to exist as-is in the other language (e.g. an article
  // that hasn't been translated yet) — pass the correct fallback (usually the other
  // language's homepage) instead of letting the default swap build a broken link.
  translationHref?: string;
}

const { lang, title, description = 'BOGGELINO — articles, opinions, and things I like.', translationHref } = Astro.props;
const s = t(lang);
const other = otherLang(lang);

// Default: build the equivalent URL in the other language by swapping the /en/ or /sk/
// prefix. This works for the homepage, tag pages, etc. since those paths mirror 1:1
// across languages. Article pages pass an explicit translationHref instead (see below).
const currentPath = Astro.url.pathname;
const otherPath = translationHref ?? currentPath.replace(`/${lang}/`, `/${other}/`).replace(new RegExp(`/${lang}$`), `/${other}`);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/mascot.png" />
    <link rel="apple-touch-icon" href="/images/mascot.png" />
    <title>{title} · BOGGELINO</title>
    <meta name="description" content={description} />
    <script is:inline>
      // Set theme before paint to avoid flash
      const saved = localStorage.getItem('boggelino-theme');
      if (saved === 'dim') document.documentElement.setAttribute('data-theme', 'dim');
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={`/${lang}/`}>
          <img src="/images/mascot.png" alt="" class="brand-mascot" width="34" height="34" />
          <span class="brand-word">BOGGELINO</span>
        </a>
        <nav class="site-nav">
          <a href={`/${lang}/`}>{s.nav_home}</a>
          <a href={`/${lang}/tags/`}>{s.nav_tags}</a>
          <a href={`/${lang}/rss.xml`} title={s.footer_rss} aria-label={s.footer_rss} class="mono rss-link">RSS</a>
          <button id="theme-toggle" class="icon-btn" aria-label={s.theme_toggle} title={s.theme_toggle}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
          </button>
          <a href={otherPath} class="lang-switch mono">{s.lang_switch}</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <span>&copy; {new Date().getFullYear()} BOGGELINO</span>
        <span class="footer-sep">·</span>
        <span>{s.footer_made}</span>
      </div>
    </footer>

    <script is:inline>
      const btn = document.getElementById('theme-toggle');
      btn?.addEventListener('click', () => {
        const html = document.documentElement;
        const isDim = html.getAttribute('data-theme') === 'dim';
        if (isDim) {
          html.removeAttribute('data-theme');
          localStorage.setItem('boggelino-theme', 'dark');
        } else {
          html.setAttribute('data-theme', 'dim');
          localStorage.setItem('boggelino-theme', 'dim');
        }
      });
    </script>

    <style>
      .site-header {
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: blur(8px);
        z-index: 10;
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 0.85rem;
        padding-bottom: 0.85rem;
        gap: 1rem;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        color: var(--text);
      }
      .brand:hover { text-decoration: none; }
      .brand-mascot {
        border-radius: 50%;
        display: block;
      }
      .brand-word {
        font-family: var(--font-display);
        font-size: 1.15rem;
        letter-spacing: 0.02em;
        color: var(--text);
      }
      .site-nav {
        display: flex;
        align-items: center;
        gap: 1.1rem;
        font-size: 0.92rem;
      }
      .site-nav a {
        color: var(--text-muted);
      }
      .site-nav a:hover {
        color: var(--accent-3);
        text-decoration: none;
      }
      .rss-link {
        font-size: 0.75rem;
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.15rem 0.4rem;
      }
      .icon-btn {
        background: none;
        border: 1px solid var(--border);
        color: var(--text-muted);
        border-radius: 50%;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
      }
      .icon-btn:hover {
        color: var(--accent-3);
        border-color: var(--accent-3);
      }
      .lang-switch {
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.15rem 0.5rem;
        font-size: 0.78rem;
        color: var(--text);
      }
      .lang-switch:hover {
        border-color: var(--accent-3);
        color: var(--accent-3);
        text-decoration: none;
      }
      .site-footer {
        border-top: 1px solid var(--border);
        margin-top: 4rem;
        padding: 2rem 0;
        color: var(--text-faint);
        font-size: 0.85rem;
      }
      .footer-inner {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
      }
      .footer-sep { color: var(--border); }
    </style>
  </body>
</html>
