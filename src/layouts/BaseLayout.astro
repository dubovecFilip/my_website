---
import '../styles/global.css';
import '../styles/print.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SearchDialog from '../components/SearchDialog.astro';
import PlaceholderArt from '../components/PlaceholderArt.astro';
import { t, type Lang } from '../i18n/dict';

export interface Alternate {
  lang: string;
  href: string;
}

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  alternates?: Alternate[];
  active?: 'home' | 'archive' | 'about' | null;
  /** Compose beží bez hlavičky, päty aj prepínača jazyka. */
  chrome?: boolean;
  noIndex?: boolean;
  /** Homepage ukáže značku v hlavičke až po odscrollovaní hero. */
  brandAfterHero?: boolean;
  /** Náhľadová obrazovka Compose: skutočná stránka s podstrčeným článkom. */
  preview?: 'home' | 'archive' | 'article';
}

const {
  lang,
  title,
  description,
  ogImage,
  ogType = 'website',
  alternates = [],
  active = null,
  chrome = true,
  noIndex = false,
  brandAfterHero = false,
  preview,
} = Astro.props;

const d = t(lang);
const pageTitle = title ? `${title} · ${d.site_name}_` : `${d.site_name}_`;
const pageDescription = description ?? d.site_description;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://boggelino.netlify.app');
const ogImageUrl = ogImage ? new URL(ogImage, canonical).href : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical.href} />
    {(noIndex || preview) && <meta name="robots" content="noindex" />}

    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.lang} href={new URL(alt.href, canonical).href} />
      ))
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? `${d.site_name}_`} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content={`${d.site_name}_`} />
    <meta property="og:locale" content={lang === 'sk' ? 'sk_SK' : 'en_US'} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />

    <meta name="theme-color" content="#111111" />
    <link rel="icon" href="/images/momentum/momentum_logo.png" type="image/png" />
    <link rel="apple-touch-icon" href="/images/momentum/momentum_logo.png" />
    <link rel="alternate" type="application/rss+xml" title={`${d.site_name}_`} href={`/${lang}/rss.xml`} />

    <link
      rel="preload"
      href="/fonts/anton-latin-ext-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-ext-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <ClientRouter />

    <script is:inline>
      /* Označí, že JS beží, bez neho ostáva všetok obsah viditeľný a statický. */
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body data-preview={preview}>
    <div class="page">
      {chrome && <a class="skip-link" href="#obsah">{d.skip_to_content}</a>}
      {chrome && (
        <SiteHeader
          lang={lang}
          active={active}
          alternates={alternates}
          brandAfterHero={brandAfterHero}
        />
      )}

      <main id="obsah" class="page-main" data-page-body>
        <slot />
      </main>

      {chrome && <SiteFooter lang={lang} />}
    </div>

    {chrome && <SearchDialog lang={lang} />}

    {
      /* Predloha zástupnej plochy pre náhľad: keď rozpísaný článok nemá
         obrázok, klonuje sa sem monogram namiesto cudzej fotky. */
      preview && (
        <template data-ph-template>
          <PlaceholderArt ratio="16 / 9" />
        </template>
      )
    }

    <script>
      import { initReveal } from '../scripts/reveal';
      import { initHeader } from '../scripts/header';
      import { initSearch } from '../scripts/search';
      import { initTagOverflow } from '../scripts/tags-overflow';
      import { initPreview } from '../scripts/preview';

      function boot() {
        /* Náhľad musí podstrčiť obsah skôr, než sa naň naviažu ostatné skripty. */
        initPreview();
        initReveal();
        initHeader();
        initSearch();
        initTagOverflow();
      }

      boot();
      document.addEventListener('astro:page-load', boot);
    </script>

    <style is:global>
      /* Prechod stránok, 260 ms, hlavička a päta ostávajú na mieste. */
      @keyframes page-in {
        from {
          opacity: 0;
          transform: translateY(8px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
      @keyframes page-out {
        to {
          opacity: 0;
        }
      }

      ::view-transition-old(root) {
        animation: page-out var(--t-page) var(--ease) both;
      }
      ::view-transition-new(root) {
        animation: page-in var(--t-page) var(--ease) both;
      }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none;
        }
      }
    </style>
  </body>
</html>
