---
import '../styles/global.css';
import FlagIcon from '../components/FlagIcon.astro';
import { t, otherLang, langMeta, type Lang } from '../i18n/dict';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  translationHref?: string;
}

const { lang, title, description = 'BOGGELINO: articles, opinions, and things I like.', translationHref } = Astro.props;
const s = t(lang);
const other = otherLang(lang);
const flagCode: Record<Lang, 'sk' | 'gb'> = { sk: 'sk', en: 'gb' };

const currentPath = Astro.url.pathname;
const otherPath = translationHref ?? currentPath.replace(`/${lang}/`, `/${other}/`).replace(new RegExp(`/${lang}$`), `/${other}`);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/boggelino.png" />
    <link rel="apple-touch-icon" href="/images/boggelino.png" />
    <title>{title} · BOGGELINO</title>
    <meta name="description" content={description} />
    <script is:inline>
      const saved = localStorage.getItem('boggelino-theme');
      if (saved === 'light') document.documentElement.setAttribute('data-theme', 'light');
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={`/${lang}/`}>
          <img src="/images/boggelino.png" alt="" class="brand-boggelino" width="34" height="34" />
          <span class="brand-word">BOGGELINO</span>
        </a>
        <nav class="site-nav">
          <a href={`/${lang}/`}>{s.nav_home}</a>
          <a href={`/${lang}/tags/`}>{s.nav_tags}</a>
          <a href={`/${lang}/about/`}>{s.nav_about}</a>
          <button id="theme-toggle" class="icon-btn" aria-label={s.theme_toggle} title={s.theme_toggle}>
            <svg id="theme-icon-dark" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
            <svg id="theme-icon-light" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none">
              <circle cx="12" cy="12" r="4"/>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
            </svg>
          </button>

          <details class="lang-dropdown">
            <summary aria-label={s.lang_switch}>
              <FlagIcon code={flagCode[lang]} />
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M6 9l6 6 6-6"/>
              </svg>
            </summary>
            <div class="lang-menu">
              <a href={`/${lang}/`} class="lang-item is-current" aria-current="true">
                <FlagIcon code={flagCode[lang]} /> {langMeta[lang].label}
              </a>
              <a href={otherPath} class="lang-item">
                <FlagIcon code={flagCode[other]} /> {langMeta[other].label}
              </a>
            </div>
          </details>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <span>&copy; {new Date().getFullYear()} BOGGELINO</span>
        <span class="footer-sep">·</span>
        <a href={`/${lang}/rss.xml`} class="footer-rss">{s.footer_rss}</a>
      </div>
    </footer>

    <script is:inline>
      const darkIcon = document.getElementById('theme-icon-dark');
      const lightIcon = document.getElementById('theme-icon-light');
      function syncIcon() {
        const isLight = document.documentElement.getAttribute('data-theme') === 'light';
        if (darkIcon) darkIcon.style.display = isLight ? 'none' : 'block';
        if (lightIcon) lightIcon.style.display = isLight ? 'block' : 'none';
      }
      syncIcon();
      const btn = document.getElementById('theme-toggle');
      btn?.addEventListener('click', () => {
        const html = document.documentElement;
        const isLight = html.getAttribute('data-theme') === 'light';
        if (isLight) {
          html.removeAttribute('data-theme');
          localStorage.setItem('boggelino-theme', 'dark');
        } else {
          html.setAttribute('data-theme', 'light');
          localStorage.setItem('boggelino-theme', 'light');
        }
        syncIcon();
      });

      document.addEventListener('click', (e) => {
        document.querySelectorAll('details.lang-dropdown[open]').forEach((el) => {
          if (!(el instanceof HTMLElement)) return;
          if (!el.contains(e.target)) el.removeAttribute('open');
        });
      });
    </script>

    <style>
      .site-header {
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: blur(8px);
        z-index: 10;
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 0.85rem;
        padding-bottom: 0.85rem;
        gap: 1rem;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        color: var(--text);
      }
      .brand:hover { text-decoration: none; }
      .brand-boggelino {
        border-radius: 50%;
        display: block;
      }
      .brand-word {
        font-family: var(--font-display);
        font-size: 1.15rem;
        letter-spacing: 0.02em;
        color: var(--text);
      }
      .site-nav {
        display: flex;
        align-items: center;
        gap: 1.1rem;
        font-size: 0.92rem;
      }
      .site-nav > a {
        color: var(--text-muted);
      }
      .site-nav > a:hover {
        color: var(--accent-3);
        text-decoration: none;
      }
      .icon-btn {
        background: none;
        border: 1px solid var(--border);
        color: var(--text-muted);
        border-radius: 50%;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
      }
      .icon-btn:hover {
        color: var(--accent-3);
        border-color: var(--accent-3);
      }

      .lang-dropdown {
        position: relative;
      }
      .lang-dropdown summary {
        list-style: none;
        display: flex;
        align-items: center;
        gap: 0.35rem;
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 0.28rem 0.5rem;
        cursor: pointer;
        color: var(--text-muted);
        user-select: none;
      }
      .lang-dropdown summary::-webkit-details-marker { display: none; }
      .lang-dropdown summary:hover,
      .lang-dropdown[open] summary {
        border-color: var(--accent-3);
        color: var(--text);
      }
      .lang-menu {
        position: absolute;
        top: calc(100% + 6px);
        right: 0;
        min-width: 150px;
        background: var(--bg-raised);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.35rem;
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        box-shadow: 0 8px 24px rgba(0,0,0,0.35);
      }
      .lang-item {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.4rem 0.6rem;
        border-radius: 5px;
        color: var(--text-muted);
        font-size: 0.88rem;
      }
      .lang-item:hover {
        background: var(--bg-raised-2);
        color: var(--text);
        text-decoration: none;
      }
      .lang-item.is-current {
        color: var(--accent-3);
      }

      .site-footer {
        border-top: 1px solid var(--border);
        margin-top: 4rem;
        padding: 2rem 0;
        color: var(--text-faint);
        font-size: 0.85rem;
      }
      .footer-inner {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        align-items: center;
      }
      .footer-sep { color: var(--border); }
      .footer-rss {
        color: var(--text-faint);
        font-size: 0.78rem;
      }
      .footer-rss:hover {
        color: var(--accent-3);
      }
    </style>
  </body>
</html>
